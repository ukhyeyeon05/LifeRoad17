--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2de8e05f04ca588419838d933500abaa, type: 3}
  m_Name: story_puz10_StorySet
  m_EditorClassIdentifier: 
  storyList:
  - question: "\"\uB098\uB294 \uD720\uCCB4\uC5B4\uB97C \uD0C0\uACE0 \uC0DD\uD65C\uD558\uB294
      \uC7A5\uC560\uC778\uC774\uACE0, \uD604\uC7AC \uD798\uB4E0 \uAD6C\uC9C1\uAE30\uAC04\uC744
      \uBCF4\uB0B4\uACE0 \uC788\uB294 33\uC0B4\uC774\uB2E4. \uC9C0\uC790\uCCB4\uB97C
      \uD1B5\uD574 \uC77C\uC790\uB9AC\uB97C \uBA87 \uBC88 \uAC00\uC838\uBD24\uC73C\uB098,
      \uB300\uBD80\uBD84 \uB2E8\uAE30 \uACC4\uC57D\uC9C1\uC774\uC5C8\uACE0, \uD604\uC7AC\uB294
      \uC9D1\uC5D0\uC11C \uC26C\uB294 \uC911\uC774\uB2E4. \uAE30\uC5C5\uB4E4\uC774
      \uC7A5\uC560\uC778 \uADFC\uB85C\uC790\uB4E4\uC744 \uCC44\uC6A9\uD558\uB3C4\uB85D
      \uD558\uB294 \uC81C\uB3C4\uAC00 \uC788\uC9C0\uB9CC, \uD604\uC2E4\uC740 \uC7A5\uC560\uC778\uC744
      \uACE0\uC6A9\uD558\uC9C0 \uC54A\uB294 \uAE30\uC5C5\uB4E4\uC774 \uB300\uBD80\uBD84\uC774\uB2E4.
      \uC77C\uBC18 \uAE30\uC5C5\uB4E4\uC5D0\uB2E4\uAC00 \uC9C0\uC6D0\uC744 \uD574\uBD10\uC57C
      \uD560\uAE4C?\""
    choices:
    - "\uAE30\uC5C5\uC5D0 \uC9C1\uC811 \uBB38\uC758\uD574\uBCF8\uB2E4"
    - "\uC77C\uBC18 \uACF5\uACE0\uC5D0\uB77C\uB3C4 \uC9C0\uC6D0\uD55C\uB2E4"
    - "\uD3EC\uAE30\uD558\uACE0 \uB2EB\uB294\uB2E4"
    results:
    - "\"\uB300\uBD80\uBD84\uC740 \u201C\uCC44\uC6A9 \uACC4\uD68D \uC5C6\uC74C\u201D
      \uD639\uC740 \u201C\uBCC4\uB3C4 \uACBD\uB85C\uB97C \uD1B5\uD574 \uCD94\uCC9C
      \uBC1B\uB294\uB2E4\u201D\uB294 \uB2F5\uBFD0\uC774\uC5C8\uB2E4. \uC720\uC77C\uD558\uAC8C
      \uD55C \uACF3\uC5D0\uC11C \uBA54\uC77C \uC811\uC218\uB97C \uAD8C\uD588\uC9C0\uB9CC,
      \uC774\uD6C4 \uC18C\uC2DD\uC740 \uC5C6\uC5C8\uB2E4. \uCC44\uC6A9 \uACBD\uB85C\uC758
      \uBCBD\uC744 \uC2E4\uAC10\uD588\uB2E4.\""
    - "\"\uBA74\uC811\uC740 \uBC1B\uC558\uC9C0\uB9CC \uD3B8\uC758 \uC694\uCCAD\uC5D0
      \uB300\uD55C \uC2DC\uC2A4\uD15C\uC774 \uC5C6\uC5C8\uACE0, \uD68C\uC0AC\uB3C4
      \uB2F9\uD669\uD574\uD588\uB2E4. \uBA74\uC811 \uC774\uD6C4 \uBCC4\uB2E4\uB978
      \uC5F0\uB77D\uC740 \uC5C6\uC5C8\uB2E4.\""
    - "\uD558\uB8E8 \uC885\uC77C \uC544\uBB34\uAC83\uB3C4 \uD558\uC9C0 \uBABB\uD55C
      \uCC44 \uC8C4\uCC45\uAC10\uACFC \uBB34\uB825\uAC10\uC5D0 \uD729\uC2F8\uC600\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC774\uB825\uC11C\uB97C \uC4F0\uB824\uB294\uB370 \uACBD\uB825 \uACF5\uBC31\uC774
      \uB208\uC5D0 \uB748\uB2E4."
    choices:
    - "\uBA87 \uB144 \uC804 \uD588\uB358 \uBD09\uC0AC\uD65C\uB3D9\uACFC \uBE14\uB85C\uADF8
      \uCF58\uD150\uCE20 \uC6B4\uC601\uC744 \uACBD\uB825\uB780\uC5D0 \uC368 \uB123\uB294\uB2E4."
    - "\u2018\uC7A5\uAE30 \uCE58\uB8CC\uC640 \uC7AC\uD65C\u2019 \uB4F1 \uACF5\uBC31\uC758
      \uC774\uC720\uB97C \uB2F4\uB2F4\uD558\uAC8C \uC791\uC131\uD55C\uB2E4."
    - "\"\uC801\uC744 \uB9CC\uD55C \uAC8C \uB5A0\uC624\uB974\uC9C0 \uC54A\uC544,
      \uADF8\uB0E5 \uACBD\uB825 \uD56D\uBAA9\uC744 \uC544\uC608 \uBE44\uC6CC\uB454\uB2E4.\""
    results:
    - "\"\uD55C \uBA74\uC811\uAD00\uC774 \uAD00\uC2EC\uC744 \uAC00\uC84C\uC9C0\uB9CC,
      \uB098\uBA38\uC9C0\uB294 \u201C\uC774\uAC74 \uACBD\uB825\uC73C\uB85C \uBCF4\uAE30
      \uC5B4\uB835\uB2E4\u201D\uB294 \uBC18\uC751\uC774\uC5C8\uB2E4.\""
    - "\"\uC11C\uB958 \uC804\uD615\uC5D0\uC11C \uD1B5\uACFC\uB418\uAE34 \uD588\uC9C0\uB9CC
      \uBA74\uC811\uC5D0\uC11C \uC774\uC5D0 \uB300\uD55C \uC9C8\uBB38\uC740 \uC5C6\uC5C8\uACE0,
      \uACB0\uACFC\uB3C4 \uBD88\uD569\uACA9\uC774\uC5C8\uB2E4.\""
    - "\"\uACF5\uB780\uC740 \uB108\uBB34 \uC120\uBA85\uD588\uACE0, \uB098\uC870\uCC28
      \uB0B4 \uC774\uB825\uC11C\uB97C \uC790\uC2E0 \uC788\uAC8C \uBABB \uBC14\uB77C\uBCF4\uAC8C
      \uB410\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uBA74\uC811\uC7A5\uAE4C\uC9C0\uC758 \uAD50\uD1B5\uD3B8\uC774 \uC5C6\uB2E4.
      \uC9C0\uD558\uCCA0\uC5ED\uB3C4 \uBA40\uB2E4."
    choices:
    - "\"\uC804\uB0A0 \uC608\uC57D\uC81C\uB85C \uD720\uCCB4\uC5B4 \uD0DD\uC2DC\uB97C
      \uC2E0\uCCAD\uD558\uACE0, 2\uC2DC\uAC04 \uC804\uC5D0 \uCD9C\uBC1C\uD55C\uB2E4.\""
    - "\"\uD658\uC2B9 \uC815\uBCF4\uB97C \uBBF8\uB9AC \uC54C\uC544\uBCF4\uACE0, \uBC84\uC2A4\uB97C
      \uAC08\uC544\uD0C0\uACE0 \uAC04\uB2E4.\""
    - "\"\uBA74\uC811 \uC804\uB0A0 \uBC24, \u201C\uC774\uAC74 \uBB34\uB9AC\uC77C
      \uAC83 \uAC19\uB2E4\u201D\uBA70 \uC5F0\uB77D\uC744 \uCDE8\uC18C\uD55C\uB2E4.\""
    results:
    - "\"\uAE30\uC0AC\uB2D8\uC774 20\uBD84 \uC9C0\uAC01\uD588\uACE0, \uACA8\uC6B0
      \uBA74\uC811 \uC2DC\uAC04\uC5D0 \uB3C4\uCC29\uD588\uB2E4. \uD5C8\uAC81\uC9C0\uAC81
      \uB4E4\uC5B4\uAC00 \uCCAB \uC778\uC0C1\uC744 \uB9DD\uCCE4\uC744\uAE4C \uAC71\uC815\uC774
      \uB9CE\uC774 \uB4E4\uC5C8\uB2E4.\""
    - "\"\uC0AC\uB78C\uB4E4 \uC0AC\uC774\uB97C \uC9C0\uB098 \uB208\uCE58\uB97C \uB9CE\uC774
      \uBCF4\uBA70 \uBC84\uC2A4\uB97C 2\uBC88 \uAC08\uC544\uD0D4\uB2E4. \uC9C0\uD558\uCCA0
      \uC5D8\uB9AC\uBCA0\uC774\uD130\uB294 \uACE0\uC7A5\uB098 \uC788\uC5C8\uACE0,
      \uB540\uC5D0 \uC816\uC740 \uCC44 \uBA74\uC811\uC7A5\uC5D0 \uB3C4\uCC29\uD588\uB2E4.\""
    - "\u201C\uC774\uB798\uC11C \uB0B4\uAC00 \uD560 \uC218 \uC788\uB294 \uC77C\uC774
      \uC5C6\uAD6C\uB098\u201D\uB77C\uB294 \uC790\uCC45\uAC10\uC774 \uB4E4\uC5C8\uB2E4.
      \uBA74\uC811\uAD00\uC740 \uC774\uC720\uB97C \uBB3B\uC9C0\uB3C4 \uC54A\uC558\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uBA74\uC811\uAD00\uC774 \u2018\uC5C5\uBB34 \uC218\uD589 \uAC00\uB2A5\uD558\uB0D0\u2019\uB294
      \uC9C8\uBB38\uC744 \uB358\uC9C4\uB2E4."
    choices:
    - "\"\uC5C5\uBB34 \uC218\uD589 \uB2A5\uB825\uC5D0 \uB300\uD55C \uB2F5\uBCC0\uC744
      \uD55C \uD6C4, \uD544\uC694 \uBCF4\uC870\uC218\uB2E8\uACFC \uD611\uC758 \uC0AC\uD56D\uC744
      \uCD5C\uB300\uD55C \uB17C\uB9AC\uC801\uC73C\uB85C \uC124\uBA85\uD55C\uB2E4.\""
    - "\uB9D0\uC774 \uB9C9\uD600 \uC6C3\uC73C\uBA70 \uB118\uAE34\uB2E4."
    - "\"\uADF8 \uC9C8\uBB38\uC774 \uBD88\uCF8C\uD588\uC9C0\uB9CC, \uC544\uBB34 \uB9D0
      \uC5C6\uC774 \uCC38\uB294\uB2E4.\""
    results:
    - "\uBA74\uC811\uAD00\uC774 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uC9C0\uB9CC
      \u201C\uD604\uC7A5\uC5D0\uC11C \uC2E4\uC81C\uB860 \uC5B4\uB835\uACA0\uB124\uC694\u201D\uB77C\uB294
      \uB9D0\uC774 \uB4A4\uB530\uB790\uB2E4."
    - "\"\uBA74\uC811\uAD00\uC740 \uACC4\uC18D \uAC19\uC740 \uC9C8\uBB38\uC744 \uB3CC\uB824
      \uBB3C\uC5C8\uACE0, \uB9D0\uBB38\uC774 \uB9C9\uD614\uB2E4.\""
    - "\uC778\uD130\uBDF0 \uD6C4 \uD55C\uCC38\uC744 \uBA4D\uD558\uB2C8 \uC549\uC544
      \uC788\uC5C8\uB2E4. \uB2F5\uB2F5\uD558\uACE0 \uC11C\uAE00\uD390\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uC628\uB77C\uC778 \uAC15\uC758\uAC00 \uC6D0\uD65C\uD558\uAC8C \uC9C0\uC6D0\uC774
      \uB418\uC9C0 \uC54A\uC544 \uC9C4\uD589\uC774 \uC5B4\uB835\uB2E4."
    choices:
    - "\uD574\uB2F9 \uD50C\uB7AB\uD3FC\uC5D0 \uAC1C\uC120 \uC694\uCCAD \uBA54\uC77C\uC744
      \uBCF4\uB0B8\uB2E4."
    - "\uAC15\uC758 \uC120\uC0DD\uB2D8\uAED8 \uC9C1\uC811 \uBD80\uD0C1\uC744 \uD574\uBCF8\uB2E4."
    - "\uADF8\uB0E5 \uAC15\uC758\uB97C \uB2EB\uACE0 \uCE68\uB300\uC5D0 \uB204\uC6CC\uBC84\uB9B0\uB2E4."
    results:
    - "\"\u201C\uAC80\uD1A0\uD574\uBCF4\uACA0\uB2E4\u201D\uB294 \uB2F5\uBCC0\uC774
      \uB3CC\uC544\uC654\uACE0, \uADF8 \uC774\uD6C4 \uB9CC\uC871\uC2A4\uB7FD\uC9C4
      \uC54A\uC9C0\uB9CC \uC870\uAE08\uC758 \uAC1C\uC120 \uC0AC\uD56D\uC774 \uBC18\uC601\uB418\uC5C8\uB2E4.\""
    - "\"\uC120\uC0DD\uB2D8\uC774 \uC758\uACAC\uC744 \uC798 \uB4E4\uC5B4\uC8FC\uC168\uACE0,
      \uB355\uBD84\uC5D0 \uAC1C\uC778\uC801\uC73C\uB85C \uC9C8\uBB38\uD560 \uC218
      \uC788\uB3C4\uB85D \uC2DC\uAC04\uC744 \uB0B4\uC8FC\uC2DC\uAC70\uB098, \uAC15\uC758
      \uC790\uB8CC\uB97C \uBA54\uC77C\uB85C \uC804\uB2EC\uD574\uC8FC\uC168\uB2E4.\""
    - "\uBA70\uCE60\uC9F8 \uAC15\uC758\uC5D0 \uB2E4\uC2DC \uB4E4\uC5B4\uAC08 \uC218
      \uC5C6\uC5C8\uB2E4. \uC2DC\uC791\uC870\uCC28 \uD798\uB4E4\uC5B4\uC84C\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uC9C0\uC790\uCCB4 \uC7A5\uC560\uC778 \uC77C\uC790\uB9AC \uD55C\uC2DC
      \uCC44\uC6A9 \uACF5\uACE0\uAC00 \uB5B4\uB2E4."
    choices:
    - "\uC870\uAC74\uC744 \uD655\uC778\uD55C \uB4A4 \uBC14\uB85C \uC9C0\uC6D0\uD55C\uB2E4."
    - "\"\uC9C0\uC6D0\uC11C\uB97C \uC5F4\uC5B4\uB450\uACE0, \uC77C\uB2E8 \uACE0\uBBFC\uBD80\uD130
      \uC2DC\uC791\uD55C\uB2E4.\""
    - "\u201C\uB610 \uB2E8\uAE30\uACA0\uC9C0\u201D \uD558\uACE0 \uC544\uC608 \uD074\uB9AD\uD558\uC9C0
      \uC54A\uB294\uB2E4."
    results:
    - "\"\uC11C\uB958\uB294 \uD1B5\uACFC\uB418\uC5C8\uC9C0\uB9CC, \uADFC\uBB34\uC9C0\uAC00
      \uBA40\uACE0 \uC2DC\uAE09\uC740 \uCD5C\uC800\uC600\uB2E4.\""
    - "\uACE0\uBBFC\uD558\uB294 \uC0AC\uC774 \uC811\uC218 \uB9C8\uAC10\uC77C\uC774
      \uC9C0\uB098 \uC788\uC5C8\uB2E4."
    - "\"\uACF5\uACE0\uAC00 \uB05D\uB09C \uB4A4, SNS\uC5D0 \uD569\uACA9 \uD6C4\uAE30\uB97C
      \uBCF8 \uB4A4 \uBCF5\uC7A1\uD55C \uB9C8\uC74C\uC774 \uB4E4\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uADFC\uBB34 \uC911 \uD3B8\uC758\uC2DC\uC124 \uBD80\uC871\uC73C\uB85C
      \uC5B4\uB824\uC6C0\uC744 \uACAA\uB294\uB2E4."
    choices:
    - "\uAD00\uB9AC\uC790\uC5D0\uAC8C \uBD88\uD3B8 \uC0AC\uD56D\uC744 \uC815\uC911\uD558\uAC8C
      \uC694\uCCAD\uD55C\uB2E4."
    - "\"\uCC38\uACE0 \uC4F0\uB2E4\uAC00 \uB2E4\uCE58\uAE30\uB3C4 \uD588\uC9C0\uB9CC,
      \uD68C\uC0AC\uC5D0 \uB2E4\uB2C8\uB294 \uAC83\uB9CC\uC73C\uB85C\uB3C4 \uB2E4\uD589\uC774\uB77C
      \uC0DD\uAC01\uD558\uACE0 \uADF8\uB0E5 \uBB35\uC778\uD55C\uB2E4.\""
    - "\uAC00\uAE4C\uC6B4 \uB3D9\uB8CC\uC5D0\uAC8C \uBAB0\uB798 \uBD80\uD0C1\uD574\uBCF8\uB2E4."
    results:
    - "\"\uB2F4\uB2F9\uC790\uB294 \u201C\uD55C\uBC88 \uD655\uC778\uD574\uBCF4\uACA0\uB2E4\u201D
      \uD558\uACE0 \uB118\uC5B4\uAC14\uC9C0\uB9CC, \uC774\uD6C4 \uD070 \uBCC0\uD654\uB294
      \uC5C6\uC5C8\uB2E4.\""
    - "\"\uBB34\uB98E\uC5D0 \uBA4D\uC774 \uB4E4\uACE0, \uC190\uC774 \uCC1D\uD614\uB2E4.
      \uC9C4\uB8CC\uBE44\uB294 \uBCF8\uC778\uC774 \uBD80\uB2F4\uD588\uB2E4.\""
    - "\"\uACE0\uB9D9\uAE34 \uD588\uC9C0\uB9CC, \uAD1C\uD788 \uD3D0 \uB07C\uCE58\uB294
      \uAE30\uBD84\uC774 \uB4E4\uC5C8\uB2E4. \uB2E4\uC74C\uBD80\uD134 \uB9D0\uC744
      \uC544\uAF08\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uACC4\uC57D \uB9CC\uB8CC \uD6C4 \uC7AC\uACC4\uC57D\uC740 \uC5B4\uB835\uB2E4\uB294
      \uC5F0\uB77D\uC774 \uC654\uB2E4."
    choices:
    - "\"\uC9C0\uC6D0\uC13C\uD130\uC5D0 \uC774\uB825\uC11C\uB97C \uC5C5\uB370\uC774\uD2B8\uD558\uACE0,
      \uC0C8 \uC77C\uC790\uB9AC\uB97C \uCC3E\uC544\uBCF8\uB2E4.\""
    - "\"\uC8FC\uBCC0\uC5D0 \uB9D0\uC740 \uBABB\uD558\uACE0, \uD63C\uC790 \uC815\uB9AC
      \uC911\uC774\uB2E4.\""
    - "\uCE68\uB300\uC5D0 \uB204\uC6B4 \uCC44 \uC544\uBB34 \uAC83\uB3C4 \uD558\uAE30
      \uC2EB\uB2E4."
    results:
    - "\"\uD55C \uB2EC \uB4A4, \uBE44\uC2B7\uD55C \uC870\uAC74\uC758 \uB2E8\uAE30
      \uACF5\uACE0\uB97C \uB610 \uCD94\uCC9C\uBC1B\uC558\uB2E4.\""
    - "\"\uB9C8\uC74C\uC744 \uC815\uB9AC\uD558\uB824 \uD588\uC9C0\uB9CC, \uBC24\uB9C8\uB2E4
      \uC790\uAFB8 \uB208\uBB3C\uC774 \uB0AC\uB2E4.\""
    - "\uBC29 \uC548\uC5D0 \uBA70\uCE60\uAC04 \uD587\uBE5B\uC774 \uB4E4\uC5B4\uC624\uC9C0
      \uC54A\uC558\uB2E4. \uC804\uAE30\uC694\uAE08 \uACE0\uC9C0\uC11C\uB9CC \uC313\uC600\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC7A5\uC560\uC778 \uACE0\uC6A9\uC13C\uD130\uC5D0\uC11C \uC7A5\uAE30\uADFC\uC18D
      \uAE30\uC5C5 \uCD94\uCC9C \uC81C\uC548\uC774 \uC628\uB2E4."
    choices:
    - "\"\uC11C\uB958\uB97C \uC900\uBE44\uD558\uACE0, \uC0C1\uB2F4 \uC608\uC57D\uC744
      \uC7A1\uB294\uB2E4.\""
    - "\uC77C\uB2E8 \uACE0\uBBFC\uB9CC \uD55C\uB2E4. \uC544\uC9C1 \uC2DC\uC791\uC740
      \uD558\uC9C0 \uBABB\uD588\uB2E4."
    - "\u201C\uC774\uB7F0 \uAC83\uB3C4 \uACB0\uAD6D \uBCF4\uC5EC\uC8FC\uAE30\uC2DD\uC77C
      \uBFD0\u201D\uC774\uB77C\uACE0 \uC0DD\uAC01\uD558\uACE0 \uBB34\uC2DC\uD55C\uB2E4."
    results:
    - "\"\uC0DD\uAC01\uBCF4\uB2E4 \uC900\uBE44\uD560 \uAC8C \uB9CE\uC558\uC9C0\uB9CC,
      \uCC28\uADFC\uCC28\uADFC \uC2DC\uC791\uD574\uBCF4\uACE0 \uC788\uB2E4.\""
    - "\"\uC0C1\uB2F4 \uC2E0\uCCAD\uC744 \uB9DD\uC124\uC774\uB2E4, \uB9C8\uAC10 \uAE30\uAC04\uC774
      \uC9C0\uB098\uBC84\uB838\uB2E4.\""
    - "\"\uBA70\uCE60 \uD6C4 \uCE5C\uAD6C\uAC00 \uADF8 \uAE30\uC5C5\uC5D0\uC11C \uC77C\uD558\uAC8C
      \uB418\uC5C8\uB2E4\uB294 \uC598\uAE38 \uB4E4\uC5C8\uACE0, \uAC00\uC2B4\uC774
      \uCCA0\uB801\uD588\uB2E4.\""
    choiceEffects:
    - effects:
