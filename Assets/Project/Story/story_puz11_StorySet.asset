  - question: "\uCE5C\uAD6C\uAC00 \uC9C0\uC790\uCCB4\uC5D0\uC11C \u2018\uC7AC\uD574\uCDE8\uC57D\uC8FC\uD0DD
      \uB9AC\uBAA8\uB378\uB9C1\u2019 \uC9C0\uC6D0\uC744 \uBC1B\uC558\uB2E4\uACE0
      \uD55C\uB2E4."
    choices:
    - "\uC2E0\uCCAD \uC790\uACA9 \uC54C\uC544\uBCF4\uACE0 \uB098\uB3C4 \uC9C0\uC6D0\uD55C\uB2E4."
    - "\uC9C0\uAE08\uC740 \uC2DC\uAE30\uAC00 \uB9DE\uC9C0 \uC54A\uB294 \uAC83 \uAC19\uB2E4."
    - "\uC791\uC131\uD560 \uC11C\uB958\uAC00 \uB9CE\uC544 \uC9C0\uC6D0\uD558\uAE30
      \uADC0\uCC2E\uB2E4..."
    results:
    - "\uB0B4 \uC9D1\uB3C4 \uC790\uACA9\uC5D0 \uD574\uB2F9\uB418\uC5B4 \uC9C0\uC6D0\uC744
      \uBC1B\uAC8C \uB418\uC5C8\uB2E4. \uAC1C\uC778 \uBE44\uC6A9 \uBD80\uB2F4\uC774
      \uD06C\uAC8C \uC904\uC5B4 \uC88B\uB2E4."
    - "\uB098\uC911\uC5D0 \uC9C0\uC6D0\uC744 \uBC1B\uC544\uBCF4\uB824 \uD588\uC73C\uB098
      \uC0AC\uC5C5 \uAE30\uAC04\uC774 \uB05D\uB098\uACE0 \uB9D0\uC558\uB2E4."
    - "\uC6B0\uB9AC\uC9D1\uC774 \uC548\uC804\uD574\uC9C8 \uAE30\uD68C\uB97C \uB0A0\uB838\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uB2E4\uC74C \uB2EC\uC5D0 \uACF5\uC0AC\uAC00 \uC788\uC5B4 \uC9D1 \uC55E
      \uB3C4\uB85C\uAC00 \uC784\uC2DC \uD3D0\uC1C4\uB420 \uC608\uC815\uC774\uB2E4."
    choices:
    - "\uACF5\uC0AC\uAC00 \uC9C4\uD589\uB420 \uB3D9\uC548 \uD1B5\uD589\uD560 \uACBD\uB85C\uB97C
      \uC54C\uC544\uBCF8\uB2E4."
    - "\uACF5\uC0AC\uAC00 \uC9C4\uD589\uB420 \uB3D9\uC548\uC740 \uC9D1\uC5D0\uB9CC
      \uC788\uB294\uB2E4."
    - "\uD1B5\uD589\uC774 \uC880 \uBD88\uD3B8\uD574\uB3C4 \uACF5\uC0AC\uAC00 \uC9C4\uD589\uB420
      \uB3C4\uB85C\uB97C \uACC4\uC18D \uC774\uC6A9\uD55C\uB2E4."
    results:
    - "\"\uACBD\uB85C\uB97C \uBBF8\uB9AC \uCC3E\uC544\uC11C, \uC55E\uC73C\uB85C \uC77C\uC5B4\uB0A0
      \uBD88\uD544\uC694\uD55C \uD63C\uB780\uACFC \uC9C0\uC5F0\uC744 \uC904\uC600\uB2E4.\""
    - "\uCC98\uC74C\uC5D4 \uD1B5\uD589\uC5D0 \uB300\uD55C \uBD88\uD3B8\uC740 \uC5C6\uB2E4\uC2DC\uD53C
      \uD588\uB2E4. \uD558\uC9C0\uB9CC \uBCD1\uC6D0\uC5D0 \uB0B4\uC6D0\uD560 \uC77C\uC774
      \uC0DD\uACBC\uB294\uB370 \uCC28\uB97C \uC774\uC6A9\uD560 \uC218 \uC5C6\uC5B4
      \uBD88\uD3B8\uD588\uB2E4."
    - "\uC784\uC2DC \uD3D0\uC1C4\uB41C \uB3C4\uB85C\uB97C \uADF8\uB0E5 \uC774\uC6A9\uD558\uB2E4\uAC00
      \uACF5\uC0AC\uC7A5 \uD39C\uC2A4\uC640 \uCDA9\uB3CC\uD558\uACE0 \uB9D0\uC558\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC694\uC998 \uB4E4\uC5B4\uC11C \uB9AC\uBAA8\uB378\uB9C1 \uC774\uC8FC\uC5D0
      \uB300\uD55C \uC81C\uC548\uC744 \uB9CE\uC774 \uBC1B\uB294\uB2E4."
    choices:
    - "\uC548\uC804 \uAE30\uC900\uC774 \uB192\uC740 \uC2E0\uCD95 \uC544\uD30C\uD2B8\uB85C
      \uC774\uC0AC\uD55C\uB2E4."
    - "\uC870\uAC74\uC744 \uB530\uC838\uBCF4\uACE0 \uB9AC\uBAA8\uB378\uB9C1\uC744
      \uC218\uB77D\uD55C\uB2E4."
    - "\uC9C0\uAE08 \uC0AC\uB294 \uC9D1\uB3C4 \uCDA9\uBD84\uD788 \uB9CC\uC871\uD558\uACE0
      \uC788\uB2E4."
    results:
    - "\"\uB9AC\uBAA8\uB378\uB9C1 \uC774\uC8FC \uB300\uC2E0 \uC2E0\uCD95 \uC544\uD30C\uD2B8\uB85C
      \uC774\uC0AC\uB97C \uD0DD\uD588\uB2E4. \uACBD\uC81C\uC801\uC73C\uB85C \uBD80\uB2F4\uC774
      \uC788\uC5C8\uC9C0\uB9CC, \uC548\uC804 \uC2DC\uC124\uC774 \uC644\uBE44\uB418\uC5B4
      \uC548\uC2EC\uD558\uACE0 \uC0B4 \uC218 \uC788\uB2E4.\""
    - "\"\uC7AC\uAC74\uCD95\uC774 \uC544\uB2C8\uB77C\uC11C \uAD6C\uC870\uC801 \uBCC0\uACBD
      \uB610\uB294 \uD655\uC7A5\uC5D0 \uD55C\uACC4\uAC00 \uC788\uC5C8\uC9C0\uB9CC,
      \uB9AC\uBAA8\uB378\uB9C1\uC744 \uC9C4\uD589\uD558\uACE0 \uAC74\uBB3C\uC758
      \uAC00\uCE58\uAC00 \uC0C1\uC2B9\uD558\uAC8C \uB418\uC5C8\uB2E4.\""
    - "\"\uB9AC\uBAA8\uB378\uB9C1\uC744 \uD558\uC9C0 \uC54A\uACE0, \uD604\uC7AC\uC758
      \uC775\uC219\uD55C \uC9D1\uC744 \uC720\uC9C0\uD558\uAE30\uB85C \uD588\uB2E4.
      \uC55E\uC73C\uB85C\uC758 \uC720\uC9C0\uBCF4\uC218 \uBE44\uC6A9\uC774 \uAC71\uC815\uB418\uAE30\uB294
      \uD55C\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
