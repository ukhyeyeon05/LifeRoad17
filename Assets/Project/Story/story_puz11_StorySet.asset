  m_Script: {fileID: 11500000, guid: 2de8e05f04ca588419838d933500abaa, type: 3}
  m_Name: story_puz11_StorySet
  m_EditorClassIdentifier: 
  storyList:
  - question: "\uC8FC\uD0DD\uAC00\uC5D0 \uD0DC\uD48D \uC608\uBE44 \uD2B9\uBCF4\uAC00
      \uB0B4\uB824\uC84C\uB2E4. \uC720\uB9AC\uCC3D\uC774 \uBC84\uD2F8 \uC218 \uC788\uC744\uC9C0
      \uAC71\uC815\uB41C\uB2E4."
    choices:
    - "\uBE44\uC0B0 \uBC29\uC9C0 \uD544\uB984\uC744 \uAD6C\uC785\uD574 \uBCF4\uAC15\uD55C\uB2E4."
    - "\uCC3D\uD2C0 \uC120\uBC18\uC5D0 \uBB34\uAC70\uC6B4 \uBB3C\uAC74\uC744 \uBC00\uCC29\uC2DC\uCF1C
      \uB9C9\uC544\uBCF8\uB2E4."
    - "\uADF8\uB300\uB85C \uB450\uB3C4\uB85D \uD55C\uB2E4."
    results:
    - "\"\uBE44\uC0B0 \uBC29\uC9C0 \uD544\uB984\uC744 \uCC3D\uBB38\uC5D0 \uB367\uB300\uC5C8\uB2E4.
      \uC774\uBC88 \uD0DC\uD48D\uC740 \uC608\uC0C1\uBCF4\uB2E4 \uD6E8\uC52C \uAC15\uB825\uD588\uB2E4.
      \uC720\uB9AC\uCC3D \uD558\uB098\uAC00 \uAE68\uC84C\uC9C0\uB9CC, \uD544\uB984
      \uB355\uBD84\uC5D0 \uD53C\uD574\uAC00 \uD06C\uC9C4 \uC54A\uC558\uB2E4.\""
    - "\"\uC870\uAE08 \uC791\uC9C0\uB9CC \uBB34\uAC70\uC6B4 \uD654\uBD84\uC744 \uCC3D\uD2C0
      \uC120\uBC18\uC5D0 \uAC00\uAE4C\uC774 \uAE30\uB300\uC5B4 \uB450\uC5C8\uB2E4.
      \uADF8\uB7F0\uB370 \uD0DC\uD48D\uC774 \uC9C0\uB098\uAC00\uBA74\uC11C \uC720\uB9AC\uCC3D\uC774
      \uAE68\uC9C0\uB294 \uBC14\uB78C\uC5D0, \uD654\uBD84\uB3C4 \uD568\uAED8 \uB5A8\uC5B4\uC838
      \uC9D1 \uC548\uC774 \uC544\uC218\uB77C\uC7A5\uC774 \uB418\uC5C8\uB2E4.\""
    - "\uBB34\uC2A8 \uC77C \uC788\uACA0\uB098 \uC2F6\uC5B4 \uBCC4\uB2E4\uB978 \uC870\uCE58\uB97C
      \uD558\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB7F0\uB370 \uC720\uB9AC\uCC3D \uD558\uB098\uAC00
      \uAE68\uC838 \uC9D1 \uC548\uC73C\uB85C \uC720\uB9AC \uD30C\uD3B8\uC774 \uD769\uC5B4\uC9C0\uACE0
      \uB9D0\uC558\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC9D1\uC911 \uD638\uC6B0\uB85C \uC778\uD574 \uC9D1 \uADFC\uCC98 \uD558\uCC9C\uC758
      \uC218\uC704\uAC00 \uBE60\uB974\uAC8C \uC0C1\uC2B9\uD558\uACE0 \uC788\uB2E4."
    choices:
    - "\uC9C0\uC790\uCCB4\uC758 \uC18C\uC2DD\uC744 \uB4E3\uACE0 \uB300\uD53C\uB97C
      \uC900\uBE44\uD55C\uB2E4."
    - "\uC774\uC6C3\uC5D0\uAC8C \uC55E\uC73C\uB85C \uC77C\uC5B4\uB0A0 \uC0C1\uD669\uC744
      \uBB3C\uC5B4\uBCF8\uB2E4."
    - "\uC9D1 \uC548\uC5D0 \uAC00\uB9CC\uD788 \uC788\uC73C\uBA74 \uC548\uC804\uD560
      \uAC83\uC774\uB2E4."
    results:
    - "\"\uC9C0\uC790\uCCB4\uC5D0\uC11C \uB300\uD53C\uB839\uC744 \uB0B4\uB9AC\uACE0,
      \uB300\uD53C \uC694\uB839\uC5D0 \uB530\uB77C \uC548\uC804\uD558\uAC8C \uB300\uD53C\uD588\uB2E4.\""
    - "\"\uBCC4\uC77C \uC5C6\uC744 \uAC70\uB77C\uB294 \uC774\uC6C3\uC758 \uB9D0\uC744
      \uB4E3\uACE0, \uC9D1\uC5D0\uC11C \uB300\uAE30\uD588\uB2E4. \uADF8\uB7EC\uB098
      \uD558\uCC9C\uC774 \uBC94\uB78C\uD558\uB824\uB294 \uAC83\uC744 \uBAA9\uACA9\uD558\uACE0
      \uC11C\uB458\uB7EC \uB300\uD53C\uD588\uB2E4. \uC870\uAE08\uB9CC \uB2A6\uC5C8\uB354\uB77C\uBA74
      \uAF3C\uC9DD\uC5C6\uC774 \uAC07\uD790 \uBED4\uD588\uB2E4.\""
    - "\uBCC4\uC77C \uC788\uACA0\uB098 \uC2F6\uC5B4 \uCE68\uB300\uC5D0 \uB4DC\uB7EC\uB204\uC6E0\uB2E4.
      \uADF8\uB7F0\uB370 \uC5B4\uB290\uC0C8 \uD558\uCC9C\uC774 \uBC94\uB78C\uD574
      \uB098\uB294 \uC9D1\uC774 \uCE68\uC218\uB418\uACE0 \uB9D0\uC558\uB2E4. \uB2E4\uD589\uD788
      \uAD6C\uC870\uB300\uAC00 \uC640\uC11C \uBAA9\uC228\uC740 \uAC74\uC84C\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\"\uACFC\uAC70, \uAD6C\uAE09\uD568\uC774 \uC5C6\uC5B4 \uACE4\uB780\uD55C
      \uC0C1\uD669\uC5D0 \uCC98\uD588\uC5C8\uC9C0\uB9CC, \uAD6C\uBE44\uD558\uB294
      \uAC83\uC744 \uC78A\uACE0 \uC788\uC5C8\uB2E4.\""
    choices:
    - "\uC9C0\uAE08\uC774\uB77C\uB3C4 \uAD6C\uAE09\uD568\uC744 \uAD6C\uD55C\uB2E4."
    - "\uC6B0\uC120 \uAC04\uB2E8\uD788 \uC0AC\uC6A9\uD560 \uC218 \uC788\uB294 \uAC83\uB9CC
      \uBAA8\uC544\uB454\uB2E4."
    - "\uB2E4\uCE58\uBA74 \uB098\uC911\uC5D0 \uBCD1\uC6D0\uC5D0\uC11C \uCE58\uB8CC\uD558\uBA74
      \uB41C\uB2E4."
    results:
    - "\"\uC5B4\uB290 \uB0A0, \uCE7C\uC9C8\uC744 \uD558\uB2E4\uAC00 \uC190\uC744
      \uD06C\uAC8C \uBCA0\uC5C8\uB294\uB370 \uB54C\uB9C8\uCE68 \uAD6C\uBE44\uD588\uB480\uB358
      \uAD6C\uAE09\uD568\uC73C\uB85C \uC751\uAE09\uCC98\uCE58\uB97C \uD55C \uD6C4
      \uBCD1\uC6D0\uC5D0 \uAC08 \uC218 \uC788\uC5C8\uB2E4.\""
    - "\"\uB098\uB294 \uC18C\uB3C5\uC57D, \uBC34\uB4DC \uB4F1 \uAC04\uB2E8\uD55C
      \uAD6C\uAE09\uC6A9\uD488\uC774\uB77C\uB3C4 \uBAA8\uC544\uB480\uB2E4. \uC5B4\uB290
      \uB0A0, \uCE7C\uC9C8\uC744 \uD558\uB2E4\uAC00 \uC190\uC744 \uD06C\uAC8C \uBCA0\uC5C8\uB294\uB370,
      \uB9C8\uB545\uD788 \uCC98\uCE58\uB97C \uD560 \uC218 \uC788\uB294 \uC6A9\uD488\uC774
      \uC5C6\uC5B4 \uACE0\uC0DD\uD588\uB2E4.\""
    - "\"\uC5B4\uB290 \uB0A0, \uCE7C\uC9C8\uC744 \uD558\uB2E4\uAC00 \uC190\uC744
      \uD06C\uAC8C \uBCA0\uC5C8\uB2E4. \uB098\uB294 \uC989\uC2DC \uBCD1\uC6D0\uC73C\uB85C
      \uC774\uB3D9\uD588\uC9C0\uB9CC, \uC2DC\uAC04\uC774 \uAF64 \uC9C0\uCCB4\uB418\uC5B4
      \uC9C0\uC18D\uC801\uC778 \uCE58\uB8CC\uB97C \uBC1B\uC544\uC57C \uD588\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uB2E8\uB3C5\uC8FC\uD0DD \uC9C0\uBC18\uC774 \uC57D\uD574\uC9C4 \uAC78\uAE4C?
      \uADE0\uC5F4\uC774 \uBC1C\uACAC\uB418\uC5C8\uB2E4."
    choices:
    - "\uACAC\uC801\uC744 \uC54C\uC544\uBCF4\uACE0 \uBCF4\uC218 \uACF5\uC0AC\uB97C
      \uC9C4\uD589\uD55C\uB2E4."
    - "\uC9C0\uC790\uCCB4\uC5D0 \uC548\uC804\uACFC \uAD00\uB828\uD574 \uC810\uAC80\uC744
      \uC2E0\uCCAD\uD55C\uB2E4."
    - "\uADFC\uCC98\uC5D0\uC11C \uD759\uC744 \uD37C\uB2E4\uAC00 \uC9C1\uC811 \uBA54\uC6CC\uBCF8\uB2E4."
    results:
    - "\"\uB098\uB294 \uC989\uC2DC \uC804\uBB38\uAC00\uB97C \uBD88\uB7EC \uADE0\uC5F4\uC758
      \uC6D0\uC778\uC744 \uC815\uD655\uD788 \uC54C\uC544\uB0B4\uACE0, \uBCF4\uC218
      \uACF5\uC0AC\uB97C \uB9C8\uCCE4\uB2E4.\""
    - "\"\uC9C0\uC790\uCCB4\uC5D0 \uADE0\uC5F4\uC5D0 \uB300\uD55C \uC810\uAC80\uC744
      \uC2E0\uCCAD\uD588\uB2E4. \uB2E4\uB978 \uC811\uC218\uC5D0 \uBC00\uB824 \uC2DC\uAC04\uC740
      \uAC78\uB838\uC9C0\uB9CC, \uADE0\uC5F4\uC758 \uC6D0\uC778\uC744 \uC54C\uC544\uB0B4\uACE0
      \uBCF4\uC218 \uBA85\uB839\uC774 \uB0B4\uB824\uC84C\uB2E4.\""
    - "\"\uB098\uB294 \uADFC\uCC98 \uD654\uB2E8\uC5D0\uC11C \uD759\uC744 \uC870\uAE08
      \uD37C\uB0B4\uC5B4 \uADE0\uC5F4\uC744 \uBA54\uAFD4\uBCF4\uC558\uB2E4. \uBA70\uCE60
      \uB4A4, \uADE0\uC5F4\uC774 \uB354 \uCEE4\uC9C0\uB294 \uBC14\uB78C\uC5D0 \uB9CE\uC740
      \uBE44\uC6A9\uC744 \uC9C0\uBD88\uD558\uAC8C \uB410\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uC7AC\uB09C \uBB38\uC790 \uC54C\uB9BC\uC774 \uB108\uBB34 \uB9CE\uC774
      \uC640\uC11C \uAC70\uC2AC\uB9B0\uB2E4. \uC54C\uB9BC\uC744 \uAF2D \uBC1B\uC544\uC57C
      \uD560\uAE4C?"
    choices:
    - "\uC7AC\uB09C \uBB38\uC790 \uC54C\uB9BC\uC744 \uCF1C\uB193\uB294\uB2E4."
    - "TV\uB97C \uD1B5\uD574 \uBC29\uC1A1\uC744 \uC8FC\uAE30\uC801\uC73C\uB85C \uD655\uC778\uD55C\uB2E4."
    - "\uC7AC\uB09C \uBB38\uC790\uB97C \uC218\uC2E0 \uCC28\uB2E8\uD55C\uB2E4."
    results:
    - "\uC880 \uAC70\uC2AC\uB824\uB3C4 \uC548\uC804\uC744 \uC704\uD574 \uCC38\uAE30\uB85C
      \uD588\uB2E4."
    - "\"\uBB38\uC790 \uC54C\uB9BC\uC740 \uB4A4\uB85C \uD558\uACE0 TV\uB9CC\uC744
      \uD1B5\uD574 \uC815\uBCF4\uB97C \uC2B5\uB4DD\uD558\uAE30\uB85C \uD588\uB2E4.
      \uD558\uC9C0\uB9CC \uB0B4\uAC00 \uC9C0\uAE08 \uBCF4\uB294 \uAC83\uC774 \uCD5C\uC2E0\uC758
      \uC815\uBCF4\uC778\uC9C0, \uC911\uAC04\uC5D0 \uB193\uCE5C \uC815\uBCF4\uB294
      \uC5C6\uB294\uC9C0 \uD30C\uC545\uD558\uAE30\uAC00 \uC5B4\uB835\uB2E4.\""
    - "\"\uBB38\uC790\uB97C \uCC28\uB2E8\uD558\uAE30\uB85C \uD588\uB2E4. \uC5B4\uB290
      \uB0A0, \uAC11\uC790\uAE30 \uC791\uC740 \uADDC\uBAA8\uC758 \uC9C0\uC9C4\uC774
      \uBC1C\uC0DD\uD574 \uAE5C\uC9DD \uB180\uB790\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC9C0\uC9C4 \uBC1C\uC0DD \uC2DC \uB300\uD53C \uC694\uB839\uC5D0 \uB300\uD55C
      \uAD50\uC721 \uC548\uB0B4\uBB38\uC774 \uB3C4\uCC29\uD588\uB2E4."
    choices:
    - "\"\uAD50\uC721\uC5D0 \uCC38\uC5EC\uD558\uACE0, \uB300\uD53C \uB8E8\uD2B8\uB97C
      \uC810\uAC80\uD55C\uB2E4.\""
    - "\uB3D9\uBD09\uB41C \uAC04\uB2E8\uD55C \uC790\uB8CC\uB9CC \uC77D\uACE0 \uB118\uAE34\uB2E4."
    - "\uC7AC\uD65C\uC6A9 \uC4F0\uB808\uAE30\uB85C \uBD84\uB9AC \uBC30\uCD9C\uD55C\uB2E4."
    results:
    - "\uC81C\uB300\uB85C \uB41C \uB300\uD53C \uC694\uB839\uC744 \uC2B5\uB4DD\uD558\uB2C8
      \uC870\uAE08\uC740 \uC548\uC2EC\uB41C\uB2E4."
    - "\"\uAD50\uC721\uC5D0 \uCC38\uC5EC\uD558\uAE30 \uBC14\uBE60 \uB3D9\uBD09\uB41C
      \uC790\uB8CC\uB9CC \uC77D\uC5C8\uB2E4. \uB2F9\uC7A5\uC740 \uAE00\uB85C \uC774\uD574\uD588\uC9C0\uB9CC,
      \uC7AC\uB09C\uC774 \uB2E5\uCCE4\uC744 \uB54C \uC798 \uB5A0\uC62C\uB9B4 \uC218
      \uC788\uC744\uAE4C \uC2F6\uB2E4.\""
    - "\uB108\uBB34 \uADC0\uCC2E\uC544\uC11C \uC548\uB0B4\uBB38\uC744 \uADF8\uB0E5
      \uC4F0\uB808\uAE30\uD1B5\uC5D0 \uBC84\uB838\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
