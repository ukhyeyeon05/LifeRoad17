        value: -1
  - question: "\uC8FC\uD0DD \uBCF4\uD5D8\uC758 \uB9CC\uAE30\uC77C\uC774 \uC5B4\uB290\uC0C8
      \uCF54\uC55E\uC73C\uB85C \uB2E4\uAC00\uC654\uB2E4."
    choices:
    - "\"\uB9CC\uAE30\uC77C\uC744 \uAC31\uC2E0\uD558\uACE0, \uBCF4\uC7A5 \uBC94\uC704\uB97C
      \uD655\uB300\uD55C\uB2E4.\""
    - "\uD604\uC7AC \uBCF4\uC7A5 \uBC94\uC704\uB85C \uB9CC\uAE30\uC77C\uB9CC \uAC31\uC2E0\uD55C\uB2E4."
    - "\uB9CC\uAE30\uC77C\uC774 \uB05D\uB098\uBA74 \uAC00\uC785 \uBC0F \uAC31\uC2E0\uC744
      \uD558\uC9C0 \uC54A\uB294\uB2E4."
    results:
    - "\uB9CC\uAE30\uC77C\uC744 \uAC31\uC2E0\uD558\uBA74\uC11C \uBCF4\uC7A5 \uBC94\uC704\uB97C
      \uD655\uB300\uD588\uB2E4. \uBCF4\uD5D8\uB8CC\uAC00 \uC880 \uBD80\uB2F4\uB418\uC9C0\uB9CC
      \uB113\uC74C \uBC94\uC704\uC758 \uBCF4\uC7A5\uC774 \uB9CC\uC871\uC2A4\uB7FD\uB2E4."
    - "\"\uBCF4\uC7A5 \uC0AC\uAC01\uC9C0\uB300\uAC00 \uC788\uC744\uAE4C \uAC71\uC815\uB418\uAE30\uB294
      \uD558\uC9C0\uB9CC, \uBCF4\uD5D8\uC774 \uC788\uB294 \uAC83\uB9CC\uC73C\uB85C\uB3C4
      \uCDA9\uBD84\uD558\uB2E4.\""
    - "\uBCF4\uD5D8\uC744 \uB354 \uC720\uC9C0\uD558\uC9C0 \uC54A\uAE30\uB85C \uD588\uB2E4.
      \uC55E\uC73C\uB85C \uC0AC\uACE0 \uBC1C\uC0DD \uC2DC \uBAA8\uB450 \uB0B4\uAC00
      \uC9C0\uBD88\uD574\uC57C \uD558\uAE30\uC5D0 \uBD88\uC548\uD558\uAE34 \uD558\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
