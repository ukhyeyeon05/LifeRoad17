%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2de8e05f04ca588419838d933500abaa, type: 3}
  m_Name: story_puz12_StorySet
  m_EditorClassIdentifier: 
  stories:
  - question: "\uC694\uC998 \uBC25\uC744 \uC9C1\uC811 \uCC28\uB824\uC11C \uBA39\uC744
      \uC2DC\uAC04\uC774 \uC5C6\uC5B4 \uBC30\uB2EC \uC74C\uC2DD\uC744 \uC790\uC8FC
      \uC774\uC6A9\uD55C\uB2E4. \uC77C\uD68C\uC6A9\uAE30\uAC00 \uD55C\uAC00\uB4DD
      \uC313\uC5EC \uACE0\uBBFC\uC778\uB370 \uC55E\uC73C\uB85C \uBC30\uB2EC\uC744
      \uC2DC\uD0AC \uB550 \uC5B4\uB5BB\uAC8C \uD560\uAE4C?"
    choices:
    - "\uB2E4\uD68C\uC6A9\uAE30 \uBC30\uB2EC \uC11C\uBE44\uC2A4\uB97C \uC774\uC6A9\uD55C\uB2E4."
    - "\uD3EC\uC7A5\uC744 \uCD5C\uC18C\uD654 \uD560 \uC218 \uC788\uB294 \uC635\uC158\uC744
      \uC120\uD0DD\uD55C\uB2E4."
    - "\uD3C9\uC18C\uCC98\uB7FC \uBC30\uB2EC \uC74C\uC2DD\uC744 \uC218\uB839\uD55C\uB2E4."
    results:
    - "\"\uC77C\uD68C\uC6A9\uAE30\uC758 \uC0AC\uC6A9\uC774 \uC904\uC5B4\uC11C \uBC30\uCD9C\uD560
      \uC4F0\uB808\uAE30\uC758 \uC591\uB3C4 \uD06C\uAC8C \uC904\uC5C8\uB2E4. \uC6A9\uAE30\uB97C
      \uB2E4\uC2DC \uAEBC\uB0B4\uB193\uB294\uAC8C \uADC0\uCC2E\uAE34 \uD558\uC9C0\uB9CC,
      \uC4F0\uB808\uAE30\uB3C4 \uC904\uACE0, \uD658\uACBD\uB3C4 \uC0DD\uAC01\uD560
      \uC218 \uC788\uB2E4.\""
    - "\"\uBC30\uB2EC\uC744 \uBC1B\uC73C\uBA74 \uD3EC\uC7A5\uC774 \uB9CE\uC9C0 \uC54A\uC544\uC11C,
      \uD3EC\uC7A5\uC744 \uB72F\uC744 \uB54C \uBC88\uAC70\uB86D\uC9C0 \uC54A\uACE0
      \uC88B\uC558\uB2E4. \""
    - "\"\uC5B4\uCC28\uD53C \uB0B4\uAC00 \uD3B8\uD558\uB824\uACE0 \uC2DC\uD0A4\uB294
      \uBC30\uB2EC \uC74C\uC2DD\uC774\uB2C8, \uADF8\uB0E5 \uC77C\uD68C\uC6A9\uAE30\uB97C
      \uC0AC\uC6A9\uD558\uAE30\uB85C \uD588\uB2E4. \uC5BC\uB9C8\uC804 \uB274\uC2A4\uC5D0\uC11C
      \uBC30\uB2EC \uC6A9\uAE30\uC758 \uBBF8\uC138\uD50C\uB77C\uC2A4\uD2F1\uC5D0
      \uB300\uD55C \uB0B4\uC6A9\uC744 \uBD24\uC9C0\uB9CC \uC544\uBB34\uB834 \uC5B4\uB5A4\uAC00.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC624\uB79C\uB9CC\uC5D0 \uC7A5\uC744 \uBCF4\uB7EC \uB098\uC654\uB2E4.
      \uB9C8\uD2B8\uC5D0\uC120 \uB300\uBD80\uBD84\uC758 \uC2DD\uC7AC\uB8CC\uAC00
      \uBE44\uB2D0\uB85C \uD3EC\uC7A5 \uB418\uC5B4\uC788\uB2E4."
    choices:
    - "\uC2DC\uC7A5 \uB610\uB294 \uC81C\uB85C\uC6E8\uC774\uC2A4\uD2B8 \uC0C1\uC810
      \uB4F1\uC744 \uC774\uC6A9\uD55C\uB2E4."
    - "\uCD5C\uB300\uD55C \uD070 \uD3EC\uC7A5 \uB2E8\uC704\uC758 \uC2DD\uC7AC\uB8CC\uB97C
      \uC120\uD0DD\uD55C\uB2E4."
    - "\uD560\uC778\uD558\uB294 \uC81C\uD488\uC744 \uC911\uC2EC\uC73C\uB85C \uAD6C\uB9E4\uD55C\uB2E4."
    results:
    - "\uB9C8\uD2B8 \uADFC\uCC98 \uC2DC\uC7A5\uC73C\uB85C \uBC1C\uAE38\uC744 \uB3CC\uB838\uB2E4.
      \uC2DC\uC7A5\uC740 \uD3EC\uC7A5\uC7AC \uC4F0\uB808\uAE30\uAC00 \uC801\uC5B4\uC11C
      \uD3B8\uD558\uB2E4. \uD558\uC9C0\uB9CC \uC5ED\uC2DC \uB9C8\uD2B8\uC5D0 \uBE44\uD574
      \uC2E0\uC120\uB3C4\uAC00 \uB5A8\uC5B4\uC9C0\uB294 \uAC74 \uC544\uC27D\uB2E4."
    - "\uB300\uC6A9\uB7C9\uC73C\uB85C \uC0AC\uBA74 \uC800\uB834\uD558\uACE0 \uC4F0\uB808\uAE30\uB3C4
      \uB35C \uB098\uC62C \uAC83\uC774\uB77C\uB294 \uC0DD\uAC01\uC5D0 \uAD6C\uB9E4\uD588\uB2E4.
      \uADF8\uB7F0\uB370 \uC0AC\uC6A9\uD558\uACE0 \uB0A8\uC740 \uC7AC\uB8CC\uAC00
      \uCC98\uCE58\uACE4\uB780\uC774\uB2E4."
    - "\"\uD560\uC778\uD558\uB294 \uC2DD\uC7AC\uB8CC\uB85C \uAD6C\uB9E4\uD574\uC11C
      \uC2DD\uBE44\uB97C \uC5B4\uB290 \uC815\uB3C4 \uC544\uB084 \uC218 \uC788\uC5C8\uC9C0\uB9CC,
      \uD3EC\uC7A5\uC7AC\uB294 \uC5EC\uC804\uD55C \uAC83 \uAC19\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uC9D1\uC5D0\uC11C \uC694\uB9AC\uB97C \uC798 \uD558\uC9C0 \uC54A\uC558\uB354\uB2C8
      \uB0C9\uC7A5\uACE0 \uC18D \uCC44\uC18C\uAC00 \uC0C1\uD574\uC11C \uBC84\uB9AC\uACE0
      \uB9D0\uC558\uB2E4."
    choices:
    - "\uC77C\uC8FC\uC77C \uC2DD\uB2E8\uD45C\uB97C \uC791\uC131\uD574\uBCF8\uB2E4."
    - "\"\uC18C\uB7C9\uC529, \uC790\uC8FC \uC7A5\uBCF4\uAE30\uB85C \uD55C\uB2E4.\""
    - "\uB204\uAD6C\uB098 \uBC1C\uC0DD\uD560 \uC218 \uC788\uB294 \uC790\uC5F0\uC2A4\uB7EC\uC6B4
      \uC77C\uC774\uB2E4."
    results:
    - "\"\uC2DD\uC7AC\uB8CC\uC758 \uC0AC\uC6A9 \uACC4\uD68D\uC774 \uBA85\uD655\uD574\uC838
      \uC74C\uC2DD\uBB3C \uC4F0\uB808\uAE30\uAC00 \uD06C\uAC8C \uC904\uC5C8\uB2E4.
      \uB2E4\uB9CC, \uACC4\uD68D\uC5D0\uB9CC \uB9DE\uCD94\uB2E4\uBCF4\uB2C8 \uC57D\uAC04\uC758
      \uC2A4\uD2B8\uB808\uC2A4\uAC00 \uC313\uC778\uB2E4.\""
    - "\"\uD544\uC694\uD55C \uB9CC\uD07C\uB9CC \uAD6C\uB9E4\uD558\uAE30\uB85C \uD588\uB2E4.
      \uB3C8\uC740 \uC880 \uB354 \uB098\uAC00\uB3C4, \uADF8 \uB355\uC5D0 \uC5B8\uC81C\uB098
      \uC2E0\uC120\uD55C \uC7AC\uB8CC\uB85C \uC694\uB9AC\uD560 \uC218 \uC788\uACE0,
      \uC74C\uC2DD\uBB3C \uC4F0\uB808\uAE30\uB3C4 \uC904\uC5C8\uB2E4.\""
    - "\"\uB300\uC218\uB86D\uC9C0 \uC54A\uAC8C \uC5EC\uAE30\uACE0 \uB118\uAE30\uB294
      \uC77C\uC774 \uBC18\uBCF5\uB410\uB2E4. \uACB0\uAD6D, \uC74C\uC2DD\uBB3C \uC4F0\uB808\uAE30\uB3C4
      \uB354 \uB9CE\uC544\uC9C0\uACE0, \uBE44\uC6A9 \uBD80\uB2F4\uB3C4 \uCEE4\uC84C\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC544\uC774\uAC00 \uAC04\uC2DD\uC744 \uB0A8\uAE30\uB294 \uC591\uC774
      \uBD80\uCA4D \uB298\uC5B4\uB09C \uAC83 \uAC19\uB2E4."
    choices:
    - "\uD3C9\uC18C\uBCF4\uB2E4 \uC801\uC740 \uC591\uC73C\uB85C \uC18C\uBD84\uD55C\uB2E4."
    - "\uBA39\uACE0 \uB0A8\uB294 \uAC04\uC2DD\uC744 \uB0C9\uB3D9 \uBCF4\uAD00\uD55C\uB2E4."
    - "\uC74C\uC2DD\uBB3C \uC4F0\uB808\uAE30\uB85C \uBC84\uB9B0\uB2E4."
    results:
    - "\uC544\uC774\uAC00 \uBA39\uC744 \uC218 \uC788\uB294 \uC591\uB9CC\uD07C\uB9CC
      \uC8FC\uB2C8 \uC4F0\uB808\uAE30\uAC00 \uB9CE\uC774 \uC904\uC5C8\uB2E4. \uC2DD\uC2B5\uAD00
      \uD615\uC131\uC5D0\uB3C4 \uB3C4\uC6C0\uC774 \uB418\uB294 \uAC83 \uAC19\uC544
      \uAE30\uBD84\uC774 \uC88B\uB2E4."
    - "\"\uB0A8\uB294 \uAC04\uC2DD\uC744 \uB0C9\uB3D9 \uBCF4\uAD00\uD558\uACE0, \uB2E4\uC74C\uC5D0
      \uC8FC\uB294 \uC2DD\uC73C\uB85C \uD588\uB2E4. \uB0C9\uB3D9\uC774\uC9C0\uB9CC,
      \uD488\uC9C8\uC774 \uB5A8\uC5B4\uC9C8\uAE4C \uC870\uAE08 \uAC71\uC815\uB418\uAE30\uB294
      \uD55C\uB2E4.\""
    - "\"\uB0A8\uB294 \uAC04\uC2DD\uC740 \uBAA8\uB450 \uBC84\uB838\uB2E4. \uCC98\uB9AC\uD558\uAE30\uB294
      \uD3B8\uD574\uC84C\uC9C0\uB9CC, \uB9DE\uB294 \uC120\uD0DD\uC778\uC9C0 \uACE0\uBBFC\uD558\uAC8C
      \uB41C\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uD50C\uB77C\uC2A4\uD2F1\uC73C\uB85C \uB9CC\uB4E4\uC5B4\uC9C4 \uD3EC\uC7A5
      \uC6A9\uAE30\uB97C \uBC84\uB9AC\uB824\uB294\uB370 \uD50C\uB77C\uC2A4\uD2F1\uC758
      \uC885\uB958\uAC00 \uB9CE\uC544 \uD5F7\uAC08\uB9B0\uB2E4."
    choices:
    - "\uC9C0\uC790\uCCB4\uC5D0\uC11C \uC9C4\uD589\uD558\uB294 \uC4F0\uB808\uAE30
      \uBD84\uB9AC \uBC30\uCD9C \uAD50\uC721\uC5D0 \uCC38\uC5EC\uD55C\uB2E4."
    - "\uD558\uB098\uD558\uB098 \uAC80\uC0C9\uD574\uC11C \uCC3E\uC544\uBCF4\uACE0
      \uBC84\uB9B0\uB2E4."
    - "\uD50C\uB77C\uC2A4\uD2F1\uC778 \uAC74 \uAC19\uC73C\uB2C8 \uD070 \uCC28\uC774\uB294
      \uC5C6\uC744 \uAC83\uC774\uB2E4."
    results:
    - "\"\uAD50\uC721\uC744 \uBC1B\uC73C\uB7EC \uAC00\uB294 \uAC83\uC740 \uADC0\uCC2E\uC9C0\uB9CC,
      \uADF8\uB9CC\uD07C \uD655\uC2E4\uD558\uAC8C \uC54C \uC218 \uC788\uC5C8\uB2E4.
      \uC774\uC81C\uB294 \uC62C\uBC14\uB974\uAC8C \uBD84\uB9AC\uBC30\uCD9C\uD560
      \uC218 \uC788\uB2E4.\""
    - "\"\uC6A9\uAE30 \uD558\uB098\uD558\uB098 \uD45C\uAE30\uB41C \uC7AC\uC9C8\uC744
      \uD655\uC778\uD574 \uAC80\uC0C9\uD55C \uB4A4 \uBC84\uB838\uB2E4. \uC2DC\uAC04\uACFC
      \uD798\uC774 \uC880 \uB9CE\uC774 \uB4E4\uC9C0\uB9CC, \uC775\uC219\uD574\uC9C8
      \uAC83\uC774\uB2E4.\""
    - "\uD50C\uB77C\uC2A4\uD2F1\uBCC4 \uBD84\uB9AC\uBC30\uCD9C\uC774 \uADC0\uCC2E\uC544\uC11C
      \uBAA8\uB450 \uD569\uCCD0\uC11C \uBC84\uB838\uB2E4. \uB4A4\uC11E\uC778 \uD50C\uB77C\uC2A4\uD2F1\uC740
      \uC7AC\uD65C\uC6A9\uC774 \uC5B4\uB835\uB2E4\uB294 \uAC83\uC744 \uB098\uC911\uC5D0
      \uAE30\uC0AC\uB97C \uBCF4\uACE0 \uC54C\uAC8C \uB418\uC5C8\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uB9E4\uC77C\uB9E4\uC77C \uC313\uC774\uB294 \uC74C\uC2DD\uBB3C \uC4F0\uB808\uAE30\uB97C
      \uC5B4\uB5BB\uAC8C \uCC98\uB9AC\uD558\uB294 \uAC83\uC774 \uC88B\uC744\uAE4C?"
    choices:
    - "\"\uC81C\uB300\uB85C\uB41C \uC2DD\uB2E8\uD45C\uB97C \uACC4\uD68D\uD558\uACE0,
      \uC2E4\uCC9C\uD55C\uB2E4.\""
    - "\uD1F4\uBE44\uD654 \uC7A5\uBE44\uB97C \uB300\uC5EC\uD55C\uB2E4."
    - "\uC74C\uC2DD\uBB3C \uC4F0\uB808\uAE30 \uBD09\uD22C\uC5D0 \uB2F4\uC544 \uBC30\uCD9C\uD55C\uB2E4."
    results:
    - "\"\uC2DD\uB2E8\uC744 \uACC4\uD68D\uD558\uACE0, \uD544\uC694\uD55C \uB9CC\uD07C\uB9CC
      \uAD6C\uB9E4\xB7\uC870\uB9AC\uD558\uB2C8 \uC74C\uC2DD\uBB3C \uC4F0\uB808\uAE30\uAC00
      \uB9CE\uC774 \uC904\uC5C8\uB2E4. \""
    - "\"\uC7A5\uBE44 \uC0AC\uC6A9\uC774 \uCC98\uC74C\uC5D4 \uC870\uAE08 \uC5B4\uB824\uC6E0\uC9C0\uB9CC,
      \uC74C\uC2DD\uBB3C \uC4F0\uB808\uAE30\uB97C \uC9C1\uC811 \uD1F4\uBE44\uB85C
      \uC804\uD658\uD558\uB2C8 \uCC98\uB9AC\uAC00 \uAC04\uD3B8\uD588\uB2E4. \uB0B4\uAC00
      \uBA39\uACE0 \uB0A8\uC740 \uC74C\uC2DD\uC774 \uC790\uC6D0\uC774 \uB420 \uC218
      \uC788\uB2E4\uB294 \uAC83\uB3C4 \uC2E0\uAE30\uD588\uB2E4.\""
    - "\uBA38\uB9AC \uC544\uD504\uAC8C \uACE0\uBBFC\uD560 \uD544\uC694\uAC00 \uC788\uACA0\uB098
      \uC2F6\uC5B4 \uD3C9\uC18C\uCC98\uB7FC \uC74C\uC2DD\uBB3C \uC4F0\uB808\uAE30
      \uC804\uC6A9 \uBD09\uC9C0\uC5D0 \uB2F4\uC544 \uBC30\uCD9C\uD588\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uC4F0\uB808\uAE30 \uBD09\uC9C0\uB97C \uC77C\uC8FC\uC77C\uC5D0 3\uC7A5\uC529
      \uC4F0\uACE0 \uC788\uB2E4. \uC0AC\uC6A9\uB7C9\uC774 \uB9CE\uC73C\uB2C8 \uBD09\uC9C0
      \uAC00\uACA9\uB3C4 \uBB34\uC2DC\uD560 \uC218 \uC5C6\uAC8C \uB410\uB2E4."
    choices:
    - "\uC4F0\uB808\uAE30 \uBC30\uCD9C\uB7C9\uC744 \uCE21\uC815\uD558\uB294 \uC5B4\uD50C\uC744
      \uC124\uCE58\uD55C\uB2E4."
    - "\uB9AC\uD544/\uC7AC\uC0AC\uC6A9 \uC81C\uD488\uC744 \uC0AC\uC6A9\uD55C\uB2E4."
    - "\uC885\uB7C9\uC81C \uBD09\uD22C\uB97C \uB354 \uAD6C\uC785\uD55C\uB2E4."
    results:
    - "\uBC30\uCD9C\uB7C9\uC744 \uC2E4\uC2DC\uAC04\uC73C\uB85C \uAE30\uB85D \uBC0F
      \uAD00\uB9AC\uD560 \uC218 \uC788\uC5B4 \uC790\uC5F0\uC2A4\uB808 \uC4F0\uB808\uAE30\uAC00
      \uC870\uAE08 \uC904\uAC8C \uB418\uC5C8\uB2E4. \uB369\uB2EC\uC544 \uBD09\uC9C0\uAC12\uB3C4
      \uC544\uB084 \uC218 \uC788\uC5C8\uB2E4."
    - "\uD658\uACBD\uC5D0 \uC88B\uC740 \uC81C\uD488\uC744 \uC0AC\uC6A9\uD558\uB824\uB2C8
      \uBE44\uC6A9 \uBD80\uB2F4\uC774 \uC788\uC5C8\uB2E4. \uADF8\uB798\uB3C4 \uC7A5\uAE30\uC801\uC73C\uB85C\uB294
      \uD658\uACBD\uC5D0 \uC88B\uC740 \uC601\uD5A5\uC744 \uB07C\uCE60 \uC218 \uC788\uC744
      \uAC83\uC774\uB2E4."
    - "\uC4F0\uB808\uAE30 \uBC30\uCD9C\uB7C9\uC5D0 \uD070 \uBCC0\uD654\uAC00 \uC5C6\uC5C8\uAE30\uC5D0
      \uC5EC\uC804\uD788 \uBE44\uC6A9\uC740 \uBD80\uB2F4\uC2A4\uB7EC\uC6B4 \uC0C1\uD669\uC774\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC637\uC7A5 \uC18D\uC5D0 \uC61B\uB0A0\uC5D0 \uC785\uC5C8\uB358 \uD5CC
      \uC637\uC774 \uC794\uB729 \uC788\uB2E4. \uADF8\uB0E5 \uBC84\uB9AC\uAE30\uC5D4
      \uC870\uAE08 \uC544\uAE4C\uC6B4\uB370 \uC7AC\uD65C\uC6A9 \uD560 \uC218 \uC788\uB294
      \uBC29\uBC95\uC774 \uC788\uC744\uAE4C?"
    choices:
    - "\uC758\uB958 \uC218\uAC70\uD568\uC744 \uC774\uC6A9\uD55C\uB2E4."
    - "\uC7AC\uD65C\uC6A9 DIY\uB97C \uC2DC\uB3C4\uD55C\uB2E4."
    - "\uB2E4\uB978 \uC0AC\uB78C\uC5D0\uAC8C \uAE30\uBD80\uD55C\uB2E4."
    results:
    - "\"\uBE44\uAD50\uC801 \uAE68\uB057\uD55C \uC637\uC740 \uC758\uB958 \uC218\uAC70\uD568\uC744
      \uD1B5\uD574 \uB2E4\uB978 \uC0AC\uB78C\uC5D0\uAC8C \uC7AC\uC0AC\uC6A9\uB418\uAC70\uB098,
      \uC0C1\uD0DC\uC5D0 \uB530\uB77C \uB2E4\uC591\uD55C \uC790\uC6D0\uC73C\uB85C
      \uC7AC\uD65C\uC6A9\uB420 \uC218 \uC788\uB2E4\uACE0 \uD55C\uB2E4.\""
    - "\uD5CC \uC637\uC5D0 \uC640\uD39C\uC744 \uB2EC\uC544\uC11C \uB9AC\uD3FC\uC744
      \uD588\uB2E4. \uB098\uB9CC\uC758 \uD328\uC158 \uC544\uC774\uD15C\uC774 \uC0DD\uAE34
      \uAC83 \uAC19\uC544 \uAE30\uBD84\uC774 \uC88B\uB2E4."
    - "\uAD6C\uC785\uD558\uACE0 \uBA87 \uBC88 \uC785\uC9C0 \uC54A\uC740 \uC637\uC744
      \uC628\uB77C\uC778 \uC911\uACE0 \uAC70\uB798 \uD50C\uB7AB\uD3FC\uC744 \uD1B5\uD574
      \uBB34\uB8CC\uB85C \uAE30\uBD80\uD588\uB2E4. \uB0B4\uAC00 \uC785\uC9C0 \uC54A\uB294
      \uC637\uC774 \uB2E4\uB978 \uC774\uB4E4\uC5D0\uAC90 \uB3C4\uC6C0\uC774 \uB420
      \uC218 \uC788\uB294 \uAC83\uC774 \uBFCC\uB4EF\uD588\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uC9D1 \uC548\uC744 \uAC00\uB4DD \uBA54\uC6B4 \uCEE4\uD53C \uCEA1\uC290\uACFC
      \uD14C\uC774\uD06C\uC544\uC6C3 \uCEF5\uC744 \uBCF4\uB2C8 \uD55C\uC228\uC774
      \uC808\uB85C \uB098\uC628\uB2E4."
    choices:
    - "\uD140\uBE14\uB7EC \uC0AC\uC6A9\uC744 \uC2E4\uCC9C\uD55C\uB2E4."
    - "\uCEE4\uD53C\uB97C \uB9C8\uC2DC\uB294 \uD69F\uC218\uB97C \uC904\uC778\uB2E4."
    - "\"\uD3C9\uC18C\uCC98\uB7FC \uB9C8\uC2DC\uB418, \uBD84\uB9AC \uBC30\uCD9C\uD55C\uB2E4.\""
    results:
    - "\uB9E4\uC7A5\uC5D0\uC11C \uC8FC\uB294 \uD14C\uC774\uD06C\uC544\uC6C3 \uCEF5
      \uB300\uC2E0 \uD140\uBE14\uB7EC\uB97C \uC0AC\uC6A9\uD558\uB2C8 \uC4F0\uB808\uAE30\uB97C
      \uCC98\uB9AC\uD560 \uD544\uC694 \uC5C6\uC5B4 \uD3B8\uD588\uB2E4. \uC624\uB798
      \uC9C0\uC18D\uD558\uBA74 \uD658\uACBD\uC744 \uC9C0\uD0A4\uB294\uB370\uB3C4
      \uD070 \uAE30\uC5EC\uB97C \uD560 \uC218 \uC788\uC744 \uAC83\uC774\uB2E4."
    - "\"\uCEE4\uD53C \uC790\uCCB4\uB97C \uC904\uC774\uAE30\uB85C \uD588\uB2E4. \uB2F9\uC7A5\uC740
      \uD53C\uACE4\uD568\uC744 \uBC84\uD2F0\uAE30 \uD798\uB4E4\uC9C0\uB9CC, \uD658\uACBD\uACFC
      \uAC74\uAC15\uC744 \uBAA8\uB450 \uC9C0\uD0AC \uC218 \uC788\uC73C\uB2C8 \uB178\uB825\uD574\uBCF4\uAE30\uB85C
      \uD588\uB2E4.\""
    - "\"\uCEF5\uC740 \uD5F9\uAD6C\uC5B4\uB1A8\uB2E4\uAC00 \uC313\uC774\uBA74 \uACB9\uCCD0\uC11C
      \uBC84\uB9AC\uAE30 \uB54C\uBB38\uC5D0 \uBD80\uD53C\uAC00 \uD06C\uC9C4 \uC54A\uB2E4.
      \uC5B4\uB290 \uC815\uB3C4 \uC4F0\uB808\uAE30 \uBD09\uC9C0\uB97C \uC544\uB084
      \uC218 \uC788\uC9C0\uB9CC, TV\uC5D0\uC11C \uC598\uAE30\uD558\uB294 \uAC83\uCC98\uB7FC
      \uD658\uACBD\uC5D0\uB294 \uC88B\uC9C0 \uC54A\uACA0\uC9C0.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC774\uC0AC\uB97C \uD560 \uC2DC\uAE30\uAC00 \uB2E4\uAC00\uC628 \uAE40\uC5D0
      \uBB3C\uAC74\uC744 \uC815\uB9AC\uD558\uB824\uACE0 \uD55C\uB2E4. \uBD88\uD544\uC694\uD55C
      \uBB3C\uAC74\uB4E4\uC744 \uC5B4\uB5BB\uAC8C \uCC98\uB9AC\uD560\uAE4C?"
    choices:
    - "\uC911\uACE0 \uAC70\uB798 \uD50C\uB7AB\uD3FC\uC5D0 \uD310\uB9E4\uD55C\uB2E4."
    - "\uC9C0\uC790\uCCB4\uC758 \uC790\uC6D0\uC21C\uD658\uC13C\uD130\uB97C \uD65C\uC6A9\uD55C\uB2E4."
    - "\uC804\uBD80 \uB300\uD615 \uD3D0\uAE30\uBB3C\uB85C \uBC84\uB9B0\uB2E4."
    results:
    - "\uBD88\uD544\uC694\uD55C \uBB3C\uAC74\uC744 \uC911\uACE0\uB85C \uD310\uB9E4\uD574\uC11C
      \uC9ED\uC9E4\uD558\uAC8C \uC218\uC775\uC774 \uB0AC\uB2E4. \uC774\uC0BF\uC9D0\uB3C4
      \uB9CE\uC774 \uC904\uC5EC\uC11C \uC774\uC0AC \uBE44\uC6A9\uB3C4 \uD568\uAED8
      \uC904\uC5C8\uB2E4."
    - "\"\uAC00\uAE4C\uC6B4 \uC790\uC6D0\uC21C\uD658\uC13C\uD130\uC5D0 \uBB3C\uAC74\uC744
      \uAC00\uC838\uAC14\uB2E4. \uC7AC\uD65C\uC6A9\uC774 \uAC00\uB2A5\uD558\uBA74
      \uBD84\uB9AC \uBC0F \uC7AC\uD65C\uC6A9\uB418\uACE0, \uC77C\uBD80\uB294 \uC0AC\uD68C\uBCF5\uC9C0\uC2DC\uC124
      \uB4F1\uC5D0 \uAE30\uBD80\uAC00 \uB41C\uB2E4\uACE0 \uD55C\uB2E4.\""
    - "\"\uBD80\uD53C\uAC00 \uD070 \uAC00\uAD6C\uB4E4\uC744 \uC804\uBD80 \uB300\uD615
      \uD3D0\uAE30\uBB3C\uB85C \uBC84\uB838\uB2E4. \uC774\uC0AC \uC900\uBE44\uB294
      \uC5B4\uB835\uC9C0 \uC54A\uAC8C \uB05D\uB0AC\uC9C0\uB9CC, \uB300\uD615 \uD3D0\uAE30\uBB3C\uC740
      \uC7AC\uD65C\uC6A9\uC774 \uBE44\uAD50\uC801 \uC5B4\uB835\uACE0 \uB300\uBD80\uBD84
      \uC18C\uAC01\uC774 \uB41C\uB2E4\uACE0 \uD55C\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
