  m_Name: story_puz13_StorySet
  m_EditorClassIdentifier: 
  storyList:
  - question: "\uACA8\uC6B8\uCCA0 \uC2AC\uB85C\uD504 \uD655\uC7A5\uC744 \uC704\uD574\uC11C
      \uB098\uBB34\uB4E4\uC744 \uBCA0\uC5B4\uB0BC\uC9C0 \uACB0\uC815\uD574\uC57C
      \uD55C\uB2E4."
    choices:
    - "\"\uBCA0\uC9C0 \uC54A\uACE0, \uAE30\uC874 \uC2AC\uB85C\uD504\uB97C \uC815\uBE44\uD55C\uB2E4.\""
    - "\"\uC77C\uBD80 \uBCA0\uC5B4\uB0B4\uACE0, \uC2AC\uB85C\uD504\uB97C \uD655\uC7A5\uD55C\uB2E4.\""
    - "\"\uBAA8\uB450 \uBCA0\uC5B4\uB0B4\uACE0, \uC0C8 \uC2AC\uB85C\uD504\uB97C \uAC1C\uBC1C\uD55C\uB2E4.\""
    results:
    - "\"\uC0B0\uB9BC\uC758 \uCD94\uAC00\uC801\uC778 \uD6FC\uC190\uC740 \uBC1C\uC0DD\uD558\uC9C0
      \uC54A\uC558\uC9C0\uB9CC, \uAE30\uD6C4 \uBCC0\uD654\uB77C\uB294 \uADFC\uBCF8\uC801\uC778
      \uBB38\uC81C \uD574\uACB0\uC740 \uB418\uC9C0 \uC54A\uC558\uB2E4.\""
    - "\"\uB2E8\uAE30\uC801\uC73C\uB85C \uC6B4\uC601 \uAE30\uAC04 \uC5F0\uC7A5\uACFC
      \uC218\uC6A9 \uC778\uC6D0 \uC99D\uAC00\uC758 \uD6A8\uACFC\uAC00 \uC788\uC5C8\uC73C\uB098,
      \uAE30\uD6C4 \uBCC0\uD654 \uBB38\uC81C\uB294 \uD574\uACB0\uB418\uC9C0 \uC54A\uC558\uB2E4.\""
    - "\"\uD658\uACBD \uB2E8\uCCB4\uC758 \uAC15\uB825\uD55C \uBE44\uD310\uC744 \uBC1B\uC558\uB2E4.
      \uC778\uACF5 \uC81C\uC124 \uC758\uC874\uB3C4\uC640 \uBE44\uC6A9, \uC628\uC2E4\uAC00\uC2A4
      \uBC30\uCD9C\uB7C9, \uBB3C \uC18C\uBE44\uB7C9 \uB4F1 \uB2E4\uC591\uD55C \uBC29\uBA74\uC73C\uB85C
      \uD070 \uB3C8\uC774 \uB4E4\uC5C8\uC73C\uBA70, \uC2A4\uD0A4\uC7A5 \uC6B4\uC601\uC774
      \uC545\uD654 \uB418\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC2A4\uD0A4\uC7A5 \uC778\uACF5\uB208 \uC124\uBE44\uC758 \uAD50\uCCB4\uB97C
      \uAC80\uD1A0\uD574\uC57C \uD55C\uB2E4."
    choices:
    - "\uB2F9\uBD84\uAC04 \uAE30\uC874 \uC124\uBE44\uB97C \uC720\uC9C0\uD55C\uB2E4."
    - "\uC77C\uBD80 \uB178\uD6C4\uB41C \uC124\uBE44\uB9CC \uAD50\uCCB4\uD55C\uB2E4."
    - "\uBAA8\uB450 \uCD5C\uC2E0 \uCE5C\uD658\uACBD \uC124\uBE44\uB85C \uAD50\uCCB4\uD55C\uB2E4."
    results:
    - "\uAE30\uC874 \uC124\uBE44 \uC911 \uC77C\uBD80\uAC00 \uB178\uD6C4\uD654\uAC00
      \uB418\uC5B4\uC11C \uC2AC\uB85C\uD504\uC758 \uD488\uC9C8 \uAD00\uB9AC\uAC00
      \uC27D\uC9C0 \uC54A\uC544\uC84C\uB2E4."
    - "\"\uC6B0\uC120 \uC2EC\uD558\uAC8C \uB178\uD6C4\uB41C \uC124\uBE44\uB9CC \uAD50\uCCB4\uD588\uB2E4.
      \uBE44\uC6A9\uC774 \uD06C\uAC8C \uB4E4\uC9C0 \uC54A\uC558\uC73C\uBA70, \uC77C\uBD80
      \uAD6C\uAC04\uC758 \uC2AC\uB85C\uD504 \uD488\uC9C8\uC740 \uAC1C\uC120\uB418\uC5C8\uB2E4.\""
    - "\uBAA8\uB450 \uCE5C\uD658\uACBD\uC801\uC778 \uC124\uBE44\uB85C \uAD50\uCCB4\uD574\uC11C
      \uC628\uC2E4\uAC00\uC2A4 \uBC30\uCD9C\uB7C9\uACFC \uBB3C \uC0AC\uC6A9\uB7C9
      \uB4F1\uC744 \uD06C\uAC8C \uC904\uC600\uB2E4. \uBE44\uC6A9\uC774 \uB9CE\uC774
      \uB4E0 \uB9CC\uD07C \uD070 \uB3C4\uC6C0\uC774 \uB418\uC5B4\uC92C\uC73C\uBA74
      \uC88B\uACA0\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\"\uC9D1\uC911\uD638\uC6B0\uB85C \uCE68\uC218 \uD53C\uD574\uAC00 \uC6B0\uB824\uB418\uBA70,
      \uBC29\uC7AC \uC2DC\uC124 \uC124\uCE58\uAC00 \uD544\uC694\uD574 \uBCF4\uC778\uB2E4.\""
    choices:
    - "\uB2E4\uC74C\uC5D0 \uC124\uCE58\uD558\uAE30\uB85C \uD55C\uB2E4."
    - "\uAC04\uC774 \uB300\uD53C\uC18C\uC640 \uBC30\uC218\uB85C\uB97C \uAD6C\uCD95\uD55C\uB2E4."
    - "\uC644\uBCBD\uD55C \uBC29\uC7AC \uC2DC\uC124\uC744 \uC124\uCE58\uD55C\uB2E4."
    results:
    - "\"\uBE44\uC6A9\uC744 \uC544\uB07C\uAE30 \uC704\uD574 \uC2DC\uC124\uC744 \uC124\uCE58\uD558\uC9C0
      \uC54A\uC558\uC9C0\uB9CC, \uC774\uD6C4 \uC9D1\uC911\uD638\uC6B0\uC5D0\uC11C
      \uC0DD\uAC01\uBCF4\uB2E4 \uD070 \uD0C0\uACA9\uC744 \uC785\uC5C8\uB2E4.\""
    - "\uCE68\uC218 \uD53C\uD574\uB97C \uC77C\uC815 \uC218\uC900 \uB9C9\uC544\uB0BC
      \uC218 \uC788\uC5C8\uB2E4. \uD5A5\uD6C4 \uB354 \uAC15\uD55C \uBE44\uAC00 \uB0B4\uB9B0\uB2E4\uBA74
      \uC548\uC804\uD560 \uC218 \uC788\uC744\uAE4C?"
    - "\uB300\uADDC\uBAA8 \uBE57\uBB3C \uC800\uB958\xB7\uBC30\uC218 \uC2DC\uC124\uB85C
      \uCE68\uC218 \uD53C\uD574\uAC00 \uAC70\uC758 \uC5C6\uB2E4\uC2DC\uD53C \uD588\uB2E4.\uC55E\uC73C\uB85C\uB3C4
      \uAC71\uC815\uD560 \uD544\uC694\uB294 \uC5C6\uC744 \uAC83 \uAC19\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC9C0\uC5ED\uC0AC\uD68C\uC640 \uD568\uAED8 \uAE30\uD6C4 \uAD50\uC721
      \uD504\uB85C\uADF8\uB7A8\uC744 \uC5F4\uC790\uB294 \uC81C\uC548\uC744 \uBC1B\uC558\uB2E4."
    choices:
    - "\uC9C4\uD589\uD558\uC9C0 \uC54A\uB294\uB2E4."
    - "\uC2A4\uD0A4\uC7A5 \uC9C1\uC6D0\uB4E4\uB07C\uB9AC \uC6CC\uD06C\uC20D\uC744
      \uC9C4\uD589\uD55C\uB2E4."
    - "\uC8FC\uBBFC\uB4E4\uC774 \uD568\uAED8 \uCC38\uC5EC\uD558\uB294 \uB300\uADDC\uBAA8
      \uCEA0\uD398\uC778\uC744 \uAE30\uD68D\uD55C\uB2E4."
    results:
    - "\uAD50\uC721 \uD504\uB85C\uADF8\uB7A8\uC744 \uC9C4\uD589\uD558\uC9C0 \uC54A\uC73C\uB2C8
      \uAE30\uD6C4 \uBCC0\uD654\uC5D0 \uB300\uD55C \uC9C0\uC5ED\uC0AC\uD68C \uC778\uC2DD\uACFC
      \uB300\uC751 \uC5ED\uB7C9\uC774 \uB0AE\uC740 \uC0C1\uD0DC\uB2E4."
    - "\"\uC9C1\uC6D0\uB4E4\uC758 \uAE30\uD6C4 \uBCC0\uD654 \uC778\uC2DD\uACFC \uB300\uC751
      \uC5ED\uB7C9\uC740 \uC77C\uBD80 \uD5A5\uC0C1\uB418\uC5C8\uB2E4. \uADF8\uB7EC\uB098,
      \uC9C0\uC5ED\uC0AC\uD68C \uC804\uCCB4\uC758 \uC778\uC2DD \uAC1C\uC120 \uD6A8\uACFC\uB294
      \uD55C\uACC4\uAC00 \uC788\uC5C8\uB2E4.\""
    - "\"\uC9C0\uC5ED\uC0AC\uD68C \uC804\uCCB4\uAC00 \uAE30\uD6C4 \uBCC0\uD654\uC5D0
      \uB300\uD55C \uC778\uC2DD\uC774 \uB192\uC544\uC84C\uACE0, \uB300\uC751 \uC804\uB7B5\uC744
      \uBAA8\uC0C9\uD560 \uC218 \uC788\uC5C8\uB2E4. \uC2A4\uD0A4\uC7A5\uC758 \uBC29\uBB38\uAC1D\uC5D0\uAC8C\uB3C4
      \uAE0D\uC815\uC801\uC778 \uC601\uD5A5\uC744 \uBBF8\uCE60 \uC218 \uC788\uC744
      \uAC83 \uAC19\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uC8FC\uCC28\uC7A5\uC744 \uCE5C\uD658\uACBD \uC2DC\uC124\uB85C \uB9AC\uBAA8\uB378\uB9C1\uD560\uC9C0
      \uACB0\uC815\uD574\uC57C \uD55C\uB2E4."
    choices:
    - "\uC77C\uBC18 \uC544\uC2A4\uD314\uD2B8\uB85C \uB9C8\uAC10\uD55C\uB2E4."
    - "\uD0DC\uC591\uAD11 \uD328\uB110\uC744 \uC124\uCE58\uD55C\uB2E4."
    - "\uC9C0\uC5F4 \uB0C9\uB09C\uBC29 \uC2DC\uC124\uACFC \uD0DC\uC591\uAD11 \uD328\uB110\uC744
      \uBAA8\uB450 \uC124\uCE58\uD55C\uB2E4."
    results:
    - "\"\uC5EC\uB984\uCCA0\uC5D0 \uC5F4\uC12C \uD604\uC0C1\uC744 \uC720\uBC1C\uD560
      \uC218 \uC788\uB2E4\uB294 \uC9C0\uC801\uC774 \uC788\uC5C8\uC73C\uB098, \uBE44\uC6A9
      \uC808\uAC10\uC744 \uC704\uD574 \uC544\uC2A4\uD314\uD2B8\uB85C \uB9C8\uAC10\uD588\uB2E4.\""
    - "\uC8FC\uCC28\uC7A5 \uACF5\uAC04 \uC77C\uBD80\uB97C \uD65C\uC6A9\uD574 \uC2E0\uC7AC\uC0DD\uC5D0\uB108\uC9C0
      \uC0DD\uC0B0\uC774 \uAC00\uB2A5\uD1A0\uB85D \uD588\uB2E4. \uC8FC\uBCC0\uC5D0\uC11C
      \uCE5C\uD658\uACBD \uB9AC\uC870\uD2B8\uB77C\uB294 \uAE0D\uC815\uC801\uC778
      \uC778\uC2DD\uB3C4 \uC5BB\uC744 \uC218 \uC788\uC5C8\uB2E4."
    - "\"\uC9C0\uC5F4, \uD0DC\uC591\uC5F4 \uB4F1 \uB2E4\uD615\uC758 \uC2E0\uC7AC\uC0DD\uC5D0\uB108\uC9C0\uB85C
      \uD0C4\uC18C \uBC30\uCD9C \uC800\uAC10, \uC5D0\uB108\uC9C0 \uBE44\uC6A9 \uC808\uAC10
      \uB4F1 \uAE0D\uC815\uC801\uC778 \uC601\uD5A5\uC774 \uB9CE\uC558\uB2E4. \uCD08\uAE30
      \uD22C\uC790\uAE08\uC744 \uD68C\uC218\uD558\uB824\uBA74 \uC2DC\uAC04\uC774
      \uAC78\uB9AC\uACA0\uC9C0\uB9CC, \uC7A5\uAE30\uC801\uC73C\uB85C \uC6B4\uC601\uD560
      \uC218 \uC788\uC744 \uAC83\uC774\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC2A4\uD0A4\uC7A5 \uD64D\uBCF4 \uC804\uB7B5\uC744 \uAE30\uD6C4 \uB300\uC751
      \uC911\uC2EC\uC73C\uB85C \uBC14\uAFC0\uC9C0 \uACE0\uBBFC\uD55C\uB2E4."
    choices:
    - "\uC790\uC5F0 \uACBD\uAD00\uC744 \uC911\uC2EC\uC73C\uB85C \uD55C\uB2E4."
    - "\uC774\uC0C9 \uCCB4\uD5D8\uC744 \uC911\uC2EC\uC73C\uB85C \uD55C\uB2E4."
    - "\uAE30\uD6C4 \uC911\uB9BD\uC744 \uC911\uC2EC\uC73C\uB85C \uD55C\uB2E4."
    results:
    - "\"\uBCF4\uD1B5\uC758 \uC2A4\uD0A4\uC7A5\uCC98\uB7FC \uC790\uC5F0 \uACBD\uAD00\uC744
      \uAC15\uC870\uD574\uC11C \uD64D\uBCF4\uB97C \uC9C4\uD589\uD588\uB2E4. \uD558\uC9C0\uB9CC,
      \uCD5C\uADFC \uAE30\uD6C4 \uBCC0\uD654\uB85C \uC778\uD574 \uACBD\uC7C1\uB825\uC774
      \uB5A8\uC5B4\uC9C8 \uAC83\uC73C\uB85C \uBCF4\uC778\uB2E4.\""
    - "\uC774\uC0C9 \uCCB4\uD5D8\uC744 \uD1B5\uD574 \uBE44\uC218\uAE30\uC5D0\uB3C4
      \uC218\uC775 \uCC3D\uCD9C\uACFC \uBC29\uBB38\uAC1D \uB2E4\uC591\uD654\uAC00
      \uC774\uB8E8\uC5B4\uC9C0\uB3C4\uB85D \uD588\uB2E4. \uB355\uBD84\uC5D0 \uC2A4\uD0A4\uC7A5
      \uC0AC\uC5C5\uC758 \uC9C0\uC18D \uAC00\uB2A5\uC131\uC774 \uB192\uC544\uC84C\uB2E4."
    - "\uC9C0\uC18D \uAC00\uB2A5\uC131\uC5D0 \uBBFC\uAC10\uD55C \uC80A\uC740 \uC138\uB300\uC640
      \uD574\uC678 \uAD00\uAD11\uAC1D\uC758 \uAD00\uC2EC\uC744 \uB04C\uC5C8\uB2E4.
      \uC7A5\uAE30\uC801\uC73C\uB85C \uBCF4\uBA74 \uACBD\uC7C1\uB825 \uD655\uBCF4\uC5D0
      \uC774\uC810\uC774 \uC788\uC744 \uAC83\uC774\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uCD5C\uADFC \uB208 \uBD80\uC871 \uD604\uC0C1\uC774 \uC2EC\uAC01\uD574
      \uB300\uCC98 \uBC29\uC548\uC744 \uB9C8\uB828\uD574\uC57C \uD55C\uB2E4."
    choices:
    - "\uD604\uC7AC \uC778\uACF5\uB208 \uC124\uBE44\uC5D0 \uC758\uC874\uD55C\uB2E4."
    - "\"\uC2AC\uB85C\uD504\uB97C \uC77C\uBD80 \uD3D0\uC1C4\uD558\uACE0, \uC785\uC7A5\uB8CC\uB97C
      \uD560\uC778\uD55C\uB2E4.\""
    - "\"\uC8FC\uBCC0 \uC2A4\uD0A4\uC7A5\uACFC \uC81C\uC124 \uC7A5\uBE44, \uC790\uC6D0\uC744
      \uACF5\uC720\uD55C\uB2E4.\""
    results:
    - "\"\uC778\uACF5\uB208 \uC124\uBE44\uC5D0 \uACC4\uC18D \uC758\uC874\uD558\uC5EC
      \uC6B4\uC601 \uBE44\uC6A9\uC774 \uAC00\uD30C\uB974\uAC8C \uC99D\uAC00\uD558\uACE0,
      \uD658\uACBD\uC5D0 \uB300\uD55C \uBD80\uB2F4\uAC10\uC774 \uCEE4\uC84C\uB2E4.\""
    - "\"\uC548\uC804\uACFC \uC124\uC9C8 \uAD00\uB9AC\uB294 \uC5B4\uB290 \uC815\uB3C4
      \uBCF4\uC7A5\uC774 \uB418\uC5C8\uC9C0\uB9CC, \uBC29\uBB38\uAC1D\uACFC \uC218\uC775\uC774
      \uC18C\uD3ED \uC904\uC5C8\uB2E4.\""
    - "\"\uB2E4\uB978 \uC2A4\uD0A4\uC7A5\uACFC \uC790\uC6D0\uC744 \uACF5\uC720\uD574\uC11C
      \uC6B4\uC601 \uD6A8\uC728\uC131\uC744 \uB192\uC774\uACE0, \uC7A5\uBE44 \uBC0F
      \uC778\uB825 \uBD80\uC871 \uBB38\uC81C\uB97C \uC644\uD654\uD560 \uC218 \uC788\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
