  - question: "\uC2A4\uD0A4\uC7A5 \uB0B4 \uC0B0\uCC45\uB85C \uC815\uBE44 \uC694\uCCAD\uC774
      \uB298\uC5B4\uB098 \uACF5\uC0AC \uBC29\uC2DD\uC744 \uB17C\uC758\uD574\uC57C
      \uD55C\uB2E4."
    choices:
    - "\uCE5C\uD658\uACBD \uC7AC\uB8CC\uB85C \uC870\uC131\uD55C\uB2E4."
    - "\uC77C\uBC18 \uBCF4\uB3C4\uBE14\uB7ED\uC73C\uB85C \uC2DC\uACF5\uD55C\uB2E4."
    - "\uC2A4\uD0A4\uC7A5\uC5D0\uC11C \uC0B0\uCC45\uB85C\uB294 \uC911\uC694\uD558\uC9C0
      \uC54A\uB2E4."
    results:
    - "\"\uD658\uACBD\uC5D0 \uBBF8\uCE58\uB294 \uC601\uD5A5\uC774 \uC801\uACE0, \uC790\uC5F0\uACFC
      \uC870\uD654\uB97C \uC774\uB8E8\uB294 \uC0B0\uCC45\uB85C\uB97C \uC870\uC131\uD588\uB2E4.
      \uBC29\uBB38\uAC1D\uC5D0\uAC8C\uB294 \uAE0D\uC815\uC801\uC778 \uC774\uBBF8\uC9C0\uAC00
      \uC81C\uACF5\uB410\uB2E4.\""
    - "\"\uBCF4\uB3C4\uBE14\uB7ED\uC740 \uC2DC\uACF5\uB3C4 \uD3B8\uD558\uACE0, \uB192\uC740
      \uB0B4\uAD6C\uC131\uACFC \uC720\uC9C0\uBCF4\uC218\uC5D0\uC11C \uAC15\uC810\uC744
      \uBCF4\uC600\uB2E4. \uC5EC\uB984\uCCA0 \uC5F4\uC12C \uD604\uC0C1\uACFC \uACA8\uC6B8\uCCA0
      \uACB0\uBE59 \uD604\uC0C1\uC744 \uC8FC\uC758\uD574\uC57C\uACA0\uB2E4.\""
    - "\"\uC2A4\uD0A4\uC5D0\uB9CC \uC9D1\uC911\uD558\uACE0, \uC0B0\uCC45\uB85C\uB294
      \uBCC4\uB3C4\uB85C \uB9C8\uB828\uD558\uC9C0 \uC54A\uC558\uB2E4. \uC2DC\uACF5
      \uBE44\uC6A9\uC740 \uC808\uAC10\uD588\uC9C0\uB9CC, \uB2E4\uB978 \uC2A4\uD0A4\uC7A5\uC5D0
      \uBE44\uD574 \uACBD\uC7C1\uB825\uC774 \uB5A8\uC5B4\uC9C4\uB2E4\uB294 \uC9C0\uC801\uC774
      \uB098\uC654\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uC57C\uAC04 \uC548\uC804\uC744 \uC704\uD55C \uC870\uBA85 \uC124\uCE58\uB97C
      \uAC80\uD1A0\uD558\uACE0 \uC788\uB2E4."
    choices:
    - "\uAE30\uC874\uC5D0 \uC124\uCE58\uB41C \uC870\uBA85\uB9CC \uAD50\uCCB4\uD55C\uB2E4."
    - "\uD0DC\uC591\uAD11 \uAE30\uBC18\uC758 \uC2A4\uB9C8\uD2B8 \uC870\uBA85\uC744
      \uC124\uCE58\uD55C\uB2E4."
    - "\uC77C\uBD80 \uAD6C\uAC04\uB9CC \uCD94\uAC00\uB85C \uC124\uCE58\uD55C\uB2E4."
    results:
    - "\"\uCD94\uAC00\uB85C \uC124\uCE58\uD558\uC9C0 \uC54A\uACE0, \uAE30\uC874 \uC870\uBA85\uB9CC
      \uAD50\uCCB4\uD574\uC11C \uBC1D\uAE30 \uD5A5\uC0C1\uC774 \uC774\uB8E8\uC5B4\uC84C\uB2E4.\""
    - "\uC2A4\uB9C8\uD2B8 \uC870\uBA85\uC774 \uBC1D\uAE30\uC640 \uC810\uB4F1 \uC2DC\uAC04\uC744
      \uC790\uB3D9 \uC870\uC808\uD558\uC5EC \uBE5B \uACF5\uD574\uB97C \uCD5C\uC18C\uD654\uD588\uB2E4.
      \uD658\uACBD\uC5D0 \uB300\uD55C \uC774\uC810\uB3C4 \uD55C\uBAAB\uD588\uB2E4."
    - "\"\uC548\uC804 \uCDE8\uC57D \uAD6C\uAC04\uC758 \uC704\uD5D8\uC774 \uC18C\uD3ED
      \uAC10\uC18C\uD588\uB2E4. \uBE44\uC6A9\uC774 \uC801\uAC8C \uB4E4\uC5C8\uC9C0\uB9CC,
      \uBE5B \uACF5\uD574\uC640 \uC5D0\uB108\uC9C0 \uD6A8\uC728 \uB4F1\uC758 \uBB38\uC81C\uAC00
      \uB3D9\uBC18\uB418\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC9C0\uC5ED \uC8FC\uBBFC\uC73C\uB85C\uBD80\uD130 \uAE30\uD6C4 \uB300\uC751
      \uC544\uC774\uB514\uC5B4 \uACF5\uBAA8\uC804 \uC81C\uC548\uC744 \uBC1B\uC558\uB2E4."
    choices:
    - "\uACF5\uBAA8\uC804\uC744 \uC5F4\uACE0 \uC2E4\uD589 \uAC00\uB2A5\uD55C \uC758\uACAC\uC744
      \uBC18\uC601\uD55C\uB2E4."
    - "\uC804\uBB38\uAC00\uC758 \uC790\uBB38\uB9CC\uC744 \uBC18\uC601\uD55C\uB2E4."
    - "\uB2F9\uC7A5\uC758 \uC2A4\uD0A4\uC7A5 \uC6B4\uC601\uC5D0\uB9CC \uC9D1\uC911\uD55C\uB2E4."
    results:
    - "\uC9C0\uC5ED \uC8FC\uBBFC\uB4E4\uC758 \uB2E4\uC591\uD55C \uD604\uC7A5 \uACBD\uD5D8\uACFC
      \uCC3D\uC758\uC801\uC778 \uC544\uC774\uB514\uC5B4\uB97C \uD1B5\uD574\uC11C
      \uC2E4\uC81C \uAE30\uD6C4 \uB300\uC751 \uC0AC\uC5C5\uC774 \uBC18\uC601\uB418\uACE0
      \uC788\uB2E4. \uC9C0\uC5ED\uC0AC\uD68C\uC640 \uD611\uB825 \uAD00\uACC4\uAC00
      \uAC15\uD654 \uB418\uC5C8\uB2E4."
    - "\"\uC804\uBB38\uAC00\uB4E4\uC758 \uC790\uBB38\uB9CC \uBC18\uC601\uD588\uB2E4.
      \uACFC\uD559\uC801 \uADFC\uAC70\uC640 \uC804\uBB38\uC131\uC5D0 \uAE30\uBC18\uD55C
      \uC815\uCC45 \uC218\uB9BD\uC774 \uAC00\uB2A5\uD588\uC9C0\uB9CC, \uC9C0\uC5ED
      \uD2B9\uC218\uC131\uC744 \uBC18\uC601\uD558\uB294\uB370 \uD55C\uACC4\uAC00
      \uC788\uC5C8\uB2E4.\""
    - "\"\uC9C0\uC5ED\uC0AC\uD68C\uC640\uC758 \uD611\uB825 \uAE30\uD68C\uAC00 \uD06C\uAC8C
      \uC904\uACE0, \uC9C0\uC5ED \uB0B4 \uC785\uC9C0\uAC00 \uC57D\uD654 \uB418\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
