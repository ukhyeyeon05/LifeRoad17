%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2de8e05f04ca588419838d933500abaa, type: 3}
  m_Name: story_puz14_StorySet
  m_EditorClassIdentifier: 
  stories:
  - question: "\uB3D9\uB8CC \uC5B4\uBBFC\uB4E4\uC5D0\uAC8C\uC11C \uBC14\uB2F7\uC18D
      \uD3D0\uADF8\uBB3C \uC218\uAC70 \uC694\uCCAD\uC774 \uB4E4\uC5B4\uC654\uB2E4."
    choices:
    - "\uC778\uB825\uC744 \uACE0\uC6A9\uD574 \uC9D1\uC911\uC801\uC73C\uB85C \uC218\uAC70\uD55C\uB2E4."
    - "\uD3EC\uC0C1\uAE08\uC744 \uAC78\uC5B4 \uC5B4\uBBFC\uB4E4\uC758 \uC790\uBC1C\uC801\uC778
      \uC218\uAC70\uB97C \uC720\uB3C4\uD55C\uB2E4."
    - "\uD3D0\uADF8\uBB3C \uC548 \uBC84\uB9AC\uB294 \uC0AC\uB78C\uC740 \uC5C6\uB2E4."
    results:
    - "\uC804\uBB38 \uC778\uB825\uC744 \uD22C\uC785\uD558\uC5EC \uD3D0\uADF8\uBB3C
      \uC218\uAC70\uC5D0 \uC9D1\uC911\uD588\uB2E4. \uC5B4\uC7A5\uC758 \uD658\uACBD\uC774
      \uBE60\uB974\uAC8C \uAC1C\uC120\uB418\uC5B4 \uB2E8\uAE30\uC801\uC73C\uB85C
      \uC5B4\uD68D\uB7C9\uC774 \uC99D\uAC00\uD558\uB294 \uD6A8\uACFC\uAC00 \uB098\uD0C0\uB0AC\uB2E4."
    - "\uD3EC\uC0C1\uAE08 \uC81C\uB3C4\uB97C \uD1B5\uD574 \uC5B4\uBBFC\uB4E4\uC758
      \uC790\uBC1C\uC801\uC778 \uC218\uAC70\uC758 \uCC38\uC5EC\uB3C4\uB97C \uB192\uC600\uB2E4.
      \uD3EC\uC0C1\uAE08\uC774 \uC904\uAC70\uB098 \uC911\uB2E8\uB418\uBA74 \uCC38\uC5EC\uC728\uC774
      \uB5A8\uC5B4\uC9C8 \uC218 \uC788\uC73C\uB2C8 \uAD00\uB9AC\uAC00 \uD544\uC694\uD560
      \uAC83\uC774\uB2E4."
    - "\uD3D0\uADF8\uBB3C\uC744 \uBC29\uCE58\uD588\uB354\uB2C8 \uCD5C\uADFC \uC5B4\uD68D\uB7C9\uC774
      \uAE09\uAC10\uD558\uC5EC \uC5B4\uBBFC\uB4E4\uC774 \uD070 \uD53C\uD574\uB97C
      \uC785\uAC8C \uB418\uC5C8\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC870\uC5C5\uC744 \uD558\uB358 \uC911 \uD3D0\uD50C\uB77C\uC2A4\uD2F1\uC774
      \uBC1C\uACAC\uB418\uACE0 \uC788\uB2E4."
    choices:
    - "\uC8FC\uBCC0 \uB9C8\uC744 \uC5B4\uBBFC\uB4E4\uC5D0\uAC8C\uB3C4 \uC54C\uB824
      \uB9C8\uC744 \uB2E8\uC704\uB85C '\uC870\uC5C5 \uC911 \uC4F0\uB808\uAE30 \uD68C\uC218\uC81C'
      \uB3C4\uC785\uC744 \uCD94\uC9C4\uD55C\uB2E4."
    - "\uC77C\uB2E8 \uD63C\uC790\uB9CC \uC870\uAE08\uC529\uC774\uB77C\uB3C4 \uC9C1\uC811
      \uD68C\uC218\uD55C\uB2E4."
    - "\uC2DC\uCCAD\uC5D0 \uBBFC\uC6D0\uC744 \uB123\uACE0 \uAE30\uB2E4\uB9B0\uB2E4."
    results:
    - "\"\uB9C8\uC744 \uB2E8\uC704\uB85C \uC5B4\uBBFC\uB4E4\uC774 \uD574\uC591 \uC4F0\uB808\uAE30\uB97C
      \uD568\uAED8 \uC218\uAC70\uD558\uAE30\uB85C \uD588\uB2E4. \uACF5\uB3D9\uCCB4
      \uB2E8\uC704\uB85C \uCC38\uC5EC\uD558\uB2C8 \uC9C0\uC18D\uC131\uACFC \uD6A8\uACFC\uC131\uC774
      \uB192\uC544\uC84C\uACE0, \uC5B4\uBBFC\uB4E4 \uC0AC\uC774 \uCC45\uC784\uAC10\uB3C4
      \uC99D\uC9C4\uB418\uC5C8\uB2E4.\""
    - "\"\uAC1C\uC778\uC801\uC73C\uB85C \uC4F0\uB808\uAE30\uB97C \uC218\uAC70\uD558\uC5EC
      \uD574\uC591 \uC4F0\uB808\uAE30 \uAC10\uC18C\uC5D0 \uAE30\uC5EC\uD560 \uC218
      \uC788\uC5C8\uC9C0\uB9CC, \uADDC\uBAA8\uAC00 \uC81C\uD55C\uC801\uC774\uC5B4\uC11C
      \uC601\uD5A5\uB825\uC774 \uD06C\uC9C0 \uC54A\uC558\uB2E4.\""
    - "\"\uBBFC\uC6D0\uC744 \uC811\uC218\uD558\uACE0 \uB300\uC751\uC744 \uAE30\uB2E4\uB838\uC9C0\uB9CC,
      \uCC98\uB9AC\uAE4C\uC9C0 \uC0C1\uB2F9\uD55C \uC2DC\uAC04\uC774 \uAC78\uB838\uB2E4.
      \uCC98\uB9AC\uB418\uAE30\uAE4C\uC9C0 \uB354 \uC313\uC778 \uC4F0\uB808\uAE30\uB85C
      \uC778\uD574 \uD53C\uD574\uAC00 \uC99D\uAC00\uD588\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uC218\uC0B0 \uC790\uC6B0\uB108 \uBCF4\uD638\uB97C \uC704\uD55C \uC870\uC5C5
      \uC81C\uD55C \uC815\uCC45\uC774 \uBC1C\uD45C\uB418\uC5C8\uB2E4."
    choices:
    - "\"\uC815\uCC45\uC5D0 \uC21C\uC751\uD558\uACE0, \uC790\uC728 \uD734\uC2DD\uAE30\uB97C
      \uB3C4\uC785\uD55C\uB2E4.\""
    - "\uC870\uC5C5\uB7C9\uC744 \uC808\uBC18\uC73C\uB85C \uC904\uC778\uB2E4."
    - "\"\uC815\uCC45\uC744 \uBB34\uC2DC\uD558\uACE0, \uAE30\uC874\uB300\uB85C \uC870\uC5C5\uC744
      \uC9C4\uD589\uD55C\uB2E4.\""
    results:
    - "\"\uC815\uCC44\uACA1 \uB9DE\uCDB0\uC790\uC728\uC801\uC73C\uB85C \uC870\uC5C5\uC744
      \uC911\uB2E8\uD558\uB2C8, \uC218\uC0B0\uC790\uC6D0 \uD68C\uBCF5\uACFC \uC5B4\uC7A5
      \uD658\uACBD\uC758 \uAC1C\uC120 \uD6A8\uACFC\uAC00 \uBA85\uD655\uD558\uAC8C
      \uB098\uD0C0\uB0AC\uB2E4.\""
    - "\"\uC815\uCC45\uACFC \uAD00\uACC4\uC5C6\uC774 \uC870\uC5C5\uB7C9\uC744 \uC808\uBC18\uC73C\uB85C
      \uC904\uC774\uAE30\uB85C \uD588\uB2E4. \uC218\uC775\uB3C4 \uAC10\uC18C\uD588\uC9C0\uB9CC,
      \uC218\uC0B0\uC790\uC6D0\uC758 \uACE0\uAC08 \uC18D\uB3C4\uB3C4 \uB2A6\uCDB0\uC838
      \uC5B4\uD68D\uB7C9 \uC720\uC9C0\uC5D0 \uAE30\uC5EC\uD588\uB2E4.\""
    - "\"\uAE30\uC874\uB300\uB85C \uC870\uC5C5\uC744 \uC9C4\uD589\uD588\uB2E4. \uC218\uC0B0\uC790\uC6D0\uC758
      \uACE0\uAC08\uC774 \uAC00\uC18D\uD654\uB418\uACE0, \uC5B4\uD68D\uB7C9\uC774
      \uAE09\uAC10\uD588\uB2E4. \uC7A5\uAE30\uC801\uC73C\uB85C\uB294 \uC5B4\uC5C5
      \uAE30\uBC18 \uC790\uCCB4\uAC00 \uBD95\uAD34\uB420 \uC218\uB3C4 \uC788\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC5F0\uC548 \uBC14\uB2E4\uC5D0 \uC801\uC870 \uD604\uC0C1\uC774 \uBAA9\uACA9\uB418\uC5C8\uB2E4."
    choices:
    - "\uD574\uC591 \uC804\uBB38\uAC00\uB97C \uC12D\uC678\uD574 \uACF5\uB3D9 \uB300\uC751
      \uCCB4\uACC4\uB97C \uC218\uB9BD\uD55C\uB2E4."
    - "\uC801\uC870 \uD53C\uD574 \uC9C0\uC5ED\uB9CC \uD53C\uD574\uC11C \uC870\uC5C5\uC744
      \uC774\uC5B4\uB098\uAC04\uB2E4."
    - "\uC790\uC5F0\uC740 \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74 \uD574\uACB0\uB41C\uB2E4."
    results:
    - "\uD574\uC591 \uC804\uBB38\uAC00\uC640 \uD568\uAED8 \uCCB4\uACC4\uC801\uC73C\uB85C
      \uB300\uC751\uD558\uC5EC \uD53C\uD574\uB97C \uCD5C\uC18C\uD654\uD560 \uC218
      \uC788\uC5C8\uB2E4."
    - "\"\uD53C\uD574 \uC9C0\uC5ED\uC744 \uC81C\uC678\uD558\uACE0 \uC870\uC5C5\uC744
      \uC9C0\uC18D\uD588\uB2E4. \uC77C\uC2DC\uC801\uC73C\uB85C \uC5B4\uD68D\uB7C9\uC5D0
      \uB300\uD55C \uD53C\uD574\uB294 \uC904\uC77C \uC218 \uC788\uC5C8\uC9C0\uB9CC,
      \uC801\uC870\uAC00 \uBE60\uB974\uAC8C \uD655\uC0B0\uB418\uC5B4 \uD070 \uD53C\uD574\uB97C
      \uC785\uC5C8\uB2E4.\""
    - "\uC790\uC5F0\uC774 \uD574\uACB0\uD574\uC904 \uAC83\uC73C\uB85C \uBBFF\uACE0
      \uBC29\uCE58\uD588\uB2E4. \uD558\uC9C0\uB9CC \uC0C1\uD0DC\uAC00 \uC545\uD654\uB418\uC5B4
      \uB300\uADDC\uBAA8 \uC5B4\uB958 \uD3D0\uC0AC\uB85C \uC774\uC5B4\uC84C\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uD574\uC591 \uBCF4\uD638 \uAD6C\uC5ED \uD655\uB300\uC548' \uC8FC\uBBFC
      \uC124\uBA85\uD68C\uC5D0 \uB300\uD55C \uCC38\uC5EC \uC81C\uC548\uC774 \uC654\uB2E4."
    choices:
    - "\uD655\uB300\uC548\uC5D0 \uCC2C\uC131\uD55C\uB2E4"
    - "\uC911\uB9BD\uC744 \uC720\uC9C0\uD55C\uB2E4."
    - "\uD655\uB300\uC548\uC5D0 \uBC18\uB300\uD55C\uB2E4."
    results:
    - "\"\uD574\uC591 \uBCF4\uD638 \uAD6C\uC5ED\uC774 \uD655\uB300\uB418\uC5B4 \uD574\uC591\uC0DD\uBB3C\uC758
      \uB2E4\uC591\uC131 \uBCF4\uC804, \uC11C\uC2DD\uC9C0 \uBCF4\uD638 \uB4F1 \uAE0D\uC815\uC801\uC778
      \uD6A8\uACFC\uAC00 \uB098\uD0C0\uB0A0 \uAC83\uC73C\uB85C \uC608\uC0C1\uB41C\uB2E4.
      \uB2E8\uAE30\uC801\uC73C\uB85C \uC77C\uBD80 \uC5B4\uC5C5\uD65C\uB3D9\uC774
      \uC81C\uD55C\uB420 \uC218 \uC788\uB2E4.\""
    - "\uACB0\uC815\uC5D0 \uC18C\uADF9\uC801\uC73C\uB85C \uCC38\uC5EC\uD558\uC5EC
      \uC5B4\uBBFC\uB4E4\uC758 \uC785\uC7A5\uC774 \uCDA9\uBD84\uD788 \uBC18\uC601\uB418\uC9C0
      \uC54A\uC558\uB358 \uAC83 \uAC19\uB2E4."
    - "\"\uD655\uB300\uC548\uC5D0 \uBC18\uB300\uD574\uC11C \uB2E8\uAE30\uC801\uC778
      \uC5B4\uC5C5\uAD8C\uACFC \uC870\uC5C5 \uAD6C\uC5ED\uC744 \uC720\uC9C0\uD560
      \uC218 \uC788\uC5C8\uC9C0\uB9CC, \uC77C\uBD80 \uC5B4\uBBFC\uB4E4\uACFC\uC758
      \uAC08\uB4F1\uC774 \uBC1C\uC0DD\uD588\uB2E4. \uB610\uD55C, \uC218\uC0B0\uC790\uC6D0
      \uACE0\uAC08 \uC704\uD5D8\uC774 \uC787\uB530\uB978\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC8FC\uBBFC\uC13C\uD130\uC5D0 \uD574\uC591 \uC0B0\uC131\uD654\uC5D0
      \uB300\uD55C \uAD50\uC721 \uD504\uB85C\uADF8\uB7A8\uC774 \uAC1C\uC124\uB418\uC5C8\uB2E4."
    choices:
    - "\uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C\uB3C4 \uC54C\uB824 \uD568\uAED8
      \uCC38\uC5EC\uD55C\uB2E4."
    - "\"\uAD50\uC721\uC5D0 \uCC38\uC5EC\uD558\uC9C0 \uC54A\uACE0, \uC870\uC5C5\uC744
      \uC774\uC5B4\uB098\uAC04\uB2E4.\""
    - "\"\uC544\uBB34\uC5D0\uAC8C\uB3C4 \uC54C\uB9AC\uC9C0 \uC54A\uACE0, \uD63C\uC790
      \uC815\uBCF4\uB97C \uCDE8\uD55C\uB2E4.\""
    results:
    - "\uB9C8\uC744 \uC8FC\uBBFC\uB4E4\uB3C4 \uD568\uAED8 \uCC38\uC5EC\uD574 \uC9C0\uC5ED\uC0AC\uD68C
      \uC804\uCCB4\uC758 \uD574\uC591 \uD658\uACBD \uBCC0\uD654\uC5D0 \uB300\uD55C
      \uC778\uC2DD\uACFC \uB300\uC751 \uC5ED\uB7C9\uC774 \uB192\uC544\uC84C\uB2E4."
    - "\uAD50\uC721\uC5D0 \uCC38\uC5EC\uD558\uC9C0 \uC54A\uC544 \uD574\uC591 \uC0B0\uC131\uD654\uAC00
      \uC5B4\uC5C5\uACFC \uC0DD\uACC4\uC5D0 \uBBF8\uCE58\uB294 \uC601\uD5A5\uC5D0
      \uB300\uD55C \uC815\uBCF4\uC640 \uBC29\uC548\uC744 \uC2B5\uB4DD\uD560 \uAE30\uD68C\uB97C
      \uB193\uCE58\uAC8C \uB418\uC5C8\uB2E4."
    - "\"\uD640\uB85C \uC815\uBCF4\uB97C \uC2B5\uB4DD\uD574\uC11C \uAC1C\uC778\uC801\uC73C\uB85C
      \uD574\uC591 \uC0B0\uC131\uD654\uC5D0 \uB300\uD55C \uC774\uD574\uB3C4\uAC00
      \uB192\uC544\uC84C\uC73C\uB098, \uC9C0\uC5ED\uC0AC\uD68C \uC804\uCCB4\uC758
      \uB300\uC751\uB825\uC740 \uD5A5\uC0C1\uB418\uC9C0 \uC54A\uC558\uB2E4. \uC815\uBCF4\uAC00
      \uACF5\uC720\uB418\uC9C0 \uC54A\uC544 \uC2E4\uC9C8\uC801\uC778 \uD589\uB3D9
      \uBCC0\uD654\uC640 \uC815\uCC45 \uBC18\uC601\uC5D0 \uC5B4\uB824\uC6C0\uC744
      \uACAA\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
