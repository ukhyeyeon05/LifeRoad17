    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uC678\uBD80 \uC5C5\uCCB4\uC5D0\uC11C \uD574\uC591 \uC4F0\uB808\uAE30
      \uBAA8\uB2C8\uD130\uB9C1 \uC2DC\uC2A4\uD15C \uB3C4\uC785\uC5D0 \uB300\uD55C
      \uC81C\uC548\uC774 \uB4E4\uC5B4\uC654\uB2E4."
    choices:
    - "\uC2DC\uBC94 \uB3C4\uC785 \uD6C4 \uC815\uC2DD\uC73C\uB85C \uCD94\uC9C4\uD55C\uB2E4."
    - "\uAC70\uC808 \uC758\uC0AC\uB97C \uD45C\uD55C\uB2E4."
    - "\uC815\uBD80 \uCC28\uC6D0\uC758 \uBAA8\uB2C8\uD130\uB9C1 \uC2DC\uC2A4\uD15C\uC5D0
      \uC758\uC874\uD55C\uB2E4."
    results:
    - "\"\uBAA8\uB2C8\uD130\uB9C1 \uC2DC\uC2A4\uD15C\uC744 \uC2DC\uBC94 \uB3C4\uC785\uD588\uB2E4.
      \uB4DC\uB860, AI \uB4F1\uC758 \uCCA8\uB2E8 \uAE30\uC220\uC744 \uD65C\uC6A9\uD574
      \uC2E4\uC2DC\uAC04\uC73C\uB85C \uB370\uC774\uD130 \uC218\uC9D1\uACFC \uBD84\uC11D\uC774
      \uAC00\uB2A5\uD588\uB2E4. \uB192\uC740 \uD6A8\uC728\uC131\uACFC \uC815\uD655\uC131\uC744
      \uACBD\uD5D8\uD558\uACE0, \uC815\uC2DD\uC73C\uB85C \uCD94\uC9C4\uD558\uAE30\uB85C
      \uD588\uB2E4.\""
    - "\"\uC2DC\uC2A4\uD15C \uB3C4\uC785\uC744 \uAC70\uC808\uD558\uACE0 \uAE30\uC874\uC758
      \uC218\uC791\uC5C5 \uC911\uC2EC \uBAA8\uB2C8\uD130\uB9C1 \uCCB4\uACC4\uB97C
      \uC720\uC9C0\uD558\uAE30\uB85C \uD588\uB2E4. \uC2E0\uC18D\uC131\uC5D0\uC11C
      \uD55C\uACC4\uAC00 \uBC1C\uC0DD\uD558\uACE0, \uD574\uC591\uC4F0\uB808\uAE30
      \uBC1C\uC0DD\uC758 \uC6D0\uC778 \uBD84\uC11D, \uB300\uC751 \uC815\uCC45 \uC218\uB9BD
      \uB4F1\uC774 \uC9C0\uC5F0\uB418\uB294 \uBB38\uC81C\uAC00 \uC0DD\uACBC\uB2E4.\""
    - "\"\uC815\uBD80 \uC2DC\uC2A4\uD15C\uC758 \uC758\uC874\uD558\uC5EC \uAE30\uCD08\uC870\uC0AC\uC640
      \uC815\uAE30\uC801 \uB370\uC774\uD130 \uCD95\uC801\uC740 \uAC00\uB2A5\uD588\uC9C0\uB9CC,
      \uC9C0\uC5ED\uBCC4 \uD2B9\uC218 \uC0C1\uD669\uC774\uB098 \uC2E0\uC18D \uB300\uC751,
      \uCCA8\uB2E8 \uAE30\uC220 \uB3C4\uC785 \uB4F1\uC5D0\uC11C \uD55C\uACC4\uAC00
      \uC788\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC870\uC5C5 \uC704\uCE58 \uADFC\uCC98\uC5D0\uC11C \uC18C\uADDC\uBAA8
      \uAE30\uB984 \uC720\uCD9C \uC0AC\uACE0\uAC00 \uBC1C\uC0DD\uD588\uB2E4."
    choices:
    - "\uC8FC\uBBFC\uB4E4\uC5D0\uAC8C \uC54C\uB9AC\uACE0 \uAE34\uAE09 \uBC29\uC81C
      \uB300\uC751\uC744 \uD55C\uB2E4."
    - "\uADDC\uBAA8\uAC00 \uD06C\uC9C0 \uC54A\uC544 \uBB34\uC2DC\uD574\uB3C4 \uB41C\uB2E4."
    - "\uAC04\uB2E8\uD55C \uBC29\uC81C \uC791\uC5C5\uB9CC \uD55C\uB2E4."
    results:
    - "\uC989\uC2DC \uC8FC\uBBFC\uB4E4\uC5D0\uAC8C \uC0AC\uACE0\uB97C \uC54C\uB824
      \uAE34\uAE09 \uBC29\uC81C\uB97C \uC9C4\uD589\uD588\uB2E4. \uC2E0\uC18D\uD55C
      \uC815\uBCF4 \uACF5\uC720\uC640 \uC870\uC9C1\uC801\uC778 \uB300\uC751\uC73C\uB85C
      \uD574\uC591 \uC624\uC5FC\uC758 \uD655\uC0B0\uC744 \uCD5C\uC18C\uD654\uD588\uB2E4."
    - "\uADDC\uBAA8\uAC00 \uD06C\uC9C0 \uC54A\uC544 \uBC29\uCE58\uD588\uB354\uB2C8
      \uD574\uB958\uB97C \uB530\uB77C \uD655\uC0B0\uB418\uC5B4 \uC608\uC0C1\uBCF4\uB2E4
      \uB113\uC740 \uD574\uC5ED\uC5D0 \uD53C\uD574\uAC00 \uAC14\uB2E4. \uBE60\uB974\uAC8C
      \uC870\uCE58\uD558\uC9C0 \uC54A\uC73C\uBA74 \uC0AC\uD68C\uC801 \uD53C\uD574\uB85C
      \uC774\uC5B4\uC9C8 \uC218\uB3C4 \uC788\uC744 \uAC83\uC774\uB2E4."
    - "\"\uAC04\uB2E8\uD55C \uBC29\uC81C\uB9CC \uC2E4\uC2DC\uD558\uC5EC \uC77C\uC2DC\uC801\uC73C\uB85C
      \uD45C\uBA74 \uC624\uC5FC\uC740 \uC904\uC600\uC9C0\uB9CC, \uAE30\uB984\uC758
      \uC77C\uBD80\uB294 \uD574\uC800\uB85C \uCE68\uC804\uB418\uAC70\uB098 \uC218\uAC70\uB418\uC9C0
      \uC54A\uC544 \uC5B4\uC5C5\uC5D0 \uD53C\uD574\uAC00 \uBC1C\uC0DD\uD588\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uC5B4\uB290 \uBC29\uC1A1\uC0AC\uB85C\uBD80\uD130 \uD574\uC591 \uC0DD\uD0DC\uACC4
      \uAD00\uB828 \uB2E4\uD050\uBA58\uD130\uB9AC \uBC29\uC1A1 \uC694\uCCAD\uC774
      \uC654\uB2E4."
    choices:
    - "\"\uCD2C\uC601\uC5D0 \uD611\uC870\uD558\uACE0, \uAD00\uB828 \uC790\uB8CC\uB97C
      \uC81C\uACF5\uD55C\uB2E4.\""
    - "\uAD00\uB828 \uC790\uB8CC\uB9CC \uC81C\uACF5\uD55C\uB2E4."
    - "\uC81C\uC548\uC744 \uAC70\uC808\uD55C\uB2E4."
    results:
    - "\"\uD574\uC591 \uC0DD\uD0DC\uACC4 \uBCF4\uC804\uC758 \uC911\uC694\uC131\uC774
      \uB300\uC911\uC801\uC73C\uB85C \uB110\uB9AC \uC54C\uB824\uC9C0\uACE0, \uC9C0\uC5ED
      \uD574\uC591 \uD658\uACBD \uBB38\uC81C\uC5D0 \uB300\uD55C \uC0AC\uD68C\uC801
      \uAD00\uC2EC\uC774 \uD655\uB300\uB418\uC5C8\uB2E4.\""
    - "\"\uC815\uD655\uD55C \uC815\uBCF4 \uC804\uB2EC\uC5D0\uB294 \uAE30\uC5EC\uD588\uC73C\uB098,
      \uD604\uC7A5\uAC10\uC774\uB098 \uC9C0\uC5ED \uC5B4\uBBFC\uC758 \uBAA9\uC18C\uB9AC\uAC00
      \uBC18\uC601\uB418\uC9C0 \uC54A\uC544 \uBC29\uC1A1\uC758 \uC124\uB4DD\uB825\uACFC
      \uACF5\uAC10\uB300 \uD615\uC131\uC5D0 \uD55C\uACC4\uAC00 \uC788\uC5C8\uB2E4.\""
    - "\uBC29\uC1A1 \uC81C\uC548\uC744 \uAC70\uC808\uD574 \uD574\uC591 \uC0DD\uD0DC\uACC4
      \uBB38\uC81C\uC5D0 \uB300\uD55C \uB300\uC911\uC801 \uAD00\uC2EC\uACFC \uC0AC\uD68C\uC801
      \uB17C\uC758 \uAE30\uD68C\uAC00 \uC904\uC5C8\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uAD6D\uC81C \uD574\uC591 \uBCF4\uD638 \uCEA0\uD398\uC778\uC5D0 \uC5B4\uBBFC
      \uB300\uD45C\uB85C \uCC38\uC5EC\uD560 \uC218 \uC788\uB294 \uAE30\uD68C\uAC00
      \uC0DD\uACBC\uB2E4."
    choices:
    - "\"\uC5B4\uBBFC \uB300\uD45C\uB85C \uCC38\uAC00\uD574 \uB3D9\uC885\uC5C5\uC790,
      \uC804\uBB38\uAC00\uB4E4\uACFC \uC758\uACAC\uC744 \uACF5\uC720\uD55C\uB2E4.\""
    - "\uC11C\uBA74 \uC790\uB8CC\uB9CC \uC81C\uCD9C\uD558\uACE0 \uB9C8\uBB34\uB9AC\uB97C
      \uD55C\uB2E4."
    - "\uCEA0\uD398\uC778\uC5D0 \uCC38\uC5EC\uD558\uC9C0 \uC54A\uB294\uB2E4."
    results:
    - "\"\uC5B4\uBBFC\uC758 \uD604\uC7A5 \uACBD\uD5D8\uACFC \uC758\uACAC\uC774 \uC815\uCC45
      \uBC0F \uCEA0\uD398\uC778 \uBC29\uD5A5\uC5D0 \uC601\uD5A5\uC744 \uB07C\uCCE4\uACE0,
      \uB2E4\uC591\uD55C \uC774\uD574\uAD00\uACC4\uC790\uC640\uC758 \uB124\uD2B8\uC6CC\uD06C
      \uD615\uC131 \uBC0F \uACF5\uB3D9 \uB300\uC751 \uBC29\uC548 \uB9C8\uB828 \uB4F1\uC758
      \uAE0D\uC815\uC801\uC778 \uD6A8\uACFC\uAC00 \uB098\uD0C0\uB0AC\uB2E4.\""
    - "\"\uC815\uBCF4 \uC804\uB2EC\uC740 \uAC00\uB2A5\uD588\uC9C0\uB9CC, \uC9C1\uC811\uC801
      \uC758\uACAC \uAD50\uD658\uACFC \uB124\uD2B8\uC6CC\uD0B9, \uC2E4\uC9C8\uC801
      \uC601\uD5A5\uB825 \uD589\uC0AC\uC5D0\uB294 \uD55C\uACC4\uAC00 \uC788\uC5C8\uB2E4.\""
    - "\"\uC9C0\uC5ED \uC5B4\uBBFC\uC758 \uC785\uC7A5\uC774 \uAD6D\uC81C \uB17C\uC758\uC5D0\uC11C
      \uBC30\uC81C\uB418\uACE0, \uD574\uC591\uBCF4\uD638 \uAD00\uB828 \uC9C0\uC6D0\uC774\uB098
      \uD611\uB825 \uAE30\uD68C\uB97C \uB193\uCE58\uAC8C \uB418\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
