  - question: "\uBE44\uB8CC \uC0AC\uC6A9\uC744 \uC904\uC774\uB77C\uB294 \uC555\uBC15\uC774
      \uB298\uACE0 \uC788\uB2E4."
    choices:
    - "\uC720\uAE30\uB18D\uC73C\uB85C \uC804\uD658"
    - "\uAE30\uC874 \uBE44\uB8CC\uB97C \uAC00\uC774\uB4DC\uB77C\uC778\uC5D0 \uB9DE\uCD94\uC5B4
      \uC0AC\uC6A9"
    - "\uBE44\uB8CC \uD655\uB300\uB85C \uC0DD\uC0B0\uB7C9 \uC99D\uB300"
    results:
    - "\uBE44\uB8CC \uC0AC\uC6A9\uC744 \uC911\uB2E8\uD574 \uD1A0\uC591\xB7\uC218\uC9C8\uC758
      \uC624\uC5FC\uC744 \uC904\uC5EC\uB098\uAC00\uAE30\uB85C \uD588\uB2E4. \uADF8\uB7EC\uB098
      \uBC00\uC6D0\uC758 \uC131\uC7A5 \uBC0F \uC0DD\uC0B0\uB7C9\uB3C4 \uAC10\uC18C\uD568\uC5D0"
    - "\uAC00\uC774\uB4DC\uB77C\uC778\uC744 \uC900\uC218\uD558\uC5EC \uD658\uACBD
      \uD53C\uD574\uB97C \uCD5C\uC18C\uD654\uD558\uBA74\uC11C \uC77C\uC815 \uC218\uC900\uC758
      \uBC00\uC6D0 \uC0DD\uC0B0\uB7C9\uC744 \uC720\uC9C0\uD588\uB2E4. \uD569\uB9AC\uC801\uC73C\uB85C
      \uC0AC\uC6A9\uD558\uBA74 \uD1A0\uC591 \uAC74\uAC15\uACFC \uC0DD\uD0DC\uACC4
      \uBCF4\uC804\uC5D0 \uB3C4\uC6C0\uC774 \uB420 \uC218 \uC788\uB294 \uAC83 \uAC19\uB2E4."
    - "\"\uC678\uBD80 \uC555\uBC15\uC5D0 \uAC15\uD55C \uC2A4\uD2B8\uB808\uC2A4\uB85C
      \uBE44\uB8CC \uC0AC\uC6A9\uC744 \uD655 \uB298\uB838\uC5C8\uB2E4. \uD1A0\uC591
      \uC0B0\uC131\uD654, \uAFC0\uBC8C \uBC0F \uAE30\uD0C0 \uC0DD\uBB3C\uC758 \uAC74\uAC15
      \uC545\uD654 \uB4F1 \uC2EC\uAC01\uD55C \uD658\uACBD \uBB38\uC81C\uB97C \uCD08\uB798\uD558\uAC8C
      \uB418\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uBA67\uB3FC\uC9C0 \uB4F1\uC758 \uC57C\uC0DD\uB3D9\uBB3C\uC5D0\uAC8C
      \uC591\uBD09\uC7A5\uC774 \uC704\uD611 \uB2F9\uD558\uACE0 \uC788\uB2E4."
    choices:
    - "\uC6B8\uD0C0\uB9AC \uC124\uCE58"
    - "\uC74C\uD5A5 \uC7A5\uCE58\uB85C \uCAD3\uAE30"
    - "\uBCF4\uC774\uB294 \uC871\uC871 \uC0AC\uB0E5"
    results:
    - "\uC6B8\uD0C0\uB9AC \uB4F1 \uC57C\uC0DD\uB3D9\uBB3C \uCC28\uB2E8 \uC2DC\uC124\uC744
      \uC124\uCE58\uD574 \uBA67\uB3FC\uC9C0\uC758 \uCE68\uC785\uC744 \uD6A8\uACFC\uC801\uC73C\uB85C
      \uB9C9\uC744 \uC218 \uC788\uC5C8\uB2E4. \uC6B8\uD0C0\uB9AC\uB97C \uC8FC\uAE30\uC801\uC73C\uB85C
      \uAD50\uCCB4\uD574\uC57C \uB354\uC6B1 \uD6A8\uACFC\uAC00 \uC88B\uC744 \uAC83\uC774\uB2E4."
    - "\"\uC74C\uD5A5 \uC7A5\uCE58\uB85C \uD070 \uC18C\uB9AC\uB97C \uB0B4\uC5B4 \uC57C\uC0DD\uB3D9\uBB3C\uB4E4\uC744
      \uCAD3\uC544\uBCF4\uAE30\uB85C \uD588\uB2E4. \uCC98\uC74C\uC5D4 \uB2E4\uB4E4
      \uB180\uB77C \uB3C4\uB9DD\uAC00\uB294 \uB4EF \uD588\uC9C0\uB9CC, \uC810\uCC28
      \uC775\uC219\uD574\uC9C0\uBA74\uC11C \uB2E4\uC2DC \uD53C\uD574\uAC00 \uC0DD\uAE30\uACE0
      \uC788\uB2E4.\""
    - "\"\uC7A5\uBE44\uB97C \uB9C8\uB828\uD558\uACE0, \uC57C\uC0DD\uB3D9\uBB3C\uC774
      \uBCF4\uC774\uBA74 \uC0AC\uB0E5\uC744 \uD588\uB2E4. \uCD5C\uADFC\uC5D4 \uBA67\uB3FC\uC9C0\uB97C
      \uC0AC\uB0E5\uD558\uB2E4\uAC00 \uB2E4\uB9AC\uB97C \uB2E4\uCE58\uACE0 \uB9D0\uC558\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uAE30\uD6C4 \uBCC0\uD654\uB85C \uC0AC\uC721\uC774 \uC5B4\uB824\uC6CC\uC9C0\uACE0
      \uC788\uB2E4."
    choices:
    - "\uC2E4\uB0B4 \uC0AC\uC721 \uC2DC\uC2A4\uD15C \uB3C4\uC785"
    - "\uC0AC\uACC4\uC808 \uBC8C \uBCF4\uD638 \uD504\uB85C\uADF8\uB7A8 \uAC1C\uC124"
    - "\uC0AC\uC721 \uC911\uB2E8"
    results:
    - "\"\uC2E4\uB0B4 \uC591\uBD09 \uC2DC\uC2A4\uD15C\uC744 \uAD6C\uCD95\uD574 \uD1B5\uD574
      \uC628\uB3C4, \uC2B5\uB3C4, \uC9C8\uBCD1, \uD574\uCDA9 \uB4F1 \uB2E4\uBC29\uBA74\uC744
      \uD1B5\uC81C\uD560 \uC218 \uC788\uAC8C \uB418\uC5C8\uB2E4. \uD22C\uC790 \uBE44\uC6A9\uC774
      \uB9CC\uB9CC\uCE58 \uC54A\uC558\uC9C0\uB9CC, \uC7A5\uAE30\uC801\uC73C\uB85C
      \uC774\uC775\uC774 \uB420 \uAC83\uC73C\uB85C \uBCF4\uC778\uB2E4.\""
    - "\uAFC0\uBC8C\uB4E4\uC744 \uBCF4\uD638\uD560 \uC218 \uC788\uB294 \uC2DC\uC2A4\uD15C\uC744
      \uC870\uAE08 \uB9C8\uB828\uD588\uB2E4. \uAFC0\uBC8C\uB4E4\uC758 \uC2A4\uD2B8\uB808\uC2A4\uAC00
      \uC904\uC740 \uAC83\uC778\uC9C0 \uC0DD\uC0B0\uC131\uC744 \uC77C\uC815 \uBD80\uBD84
      \uC720\uC9C0\uD560 \uC218 \uC788\uC5C8\uB2E4."
    - "\uC591\uBD09\uC5C5\uC744 \uADF8\uB9CC\uB450\uAE30\uB85C \uD588\uB2E4."
