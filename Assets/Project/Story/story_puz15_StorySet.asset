  m_Name: story_puz15_StorySet
  m_EditorClassIdentifier: 
  storyList:
  - question: "\uBC8C\uB4E4\uC774 \uC0AC\uB77C\uC9C4 \uAFC0\uBC8C \uB18D\uAC00\uB4E4\uC774
      \uD558\uB098\uB458 \uBB38\uC744 \uB2EB\uACE0 \uC788\uB2E4."
    choices:
    - "\uC804\uAD6D \uC591\uBD09 \uD611\uD68C\uB97C \uACB0\uC131\uD574 \uC9C0\uC6D0\uC744
      \uC694\uCCAD"
    - "\uAD6D\uD68C\uC5D0 '\uBC8C \uBCF4\uD638\uBC95' \uC81C\uC815\uC744 \uC694\uCCAD"
    - "\uC77C\uB2E8 \uD574\uC678 \uAFC0\uC744 \uC218\uC785"
    results:
    - "\"\uD611\uD68C \uACB0\uC131 \uBC0F \uC9C0\uC6D0 \uC694\uCCAD\uC744 \uD1B5\uD574\uC11C
      \uC815\uBD80 \uBC0F \uAD00\uB828 \uAE30\uAD00\uC758 \uC815\uCC45\uC801, \uC7AC\uC815\uC801
      \uC9C0\uC6D0 \uB4F1\uC758 \uAC00\uB2A5\uC131\uC774 \uC5F4\uB838\uB2E4.\""
    - "\"\uAFC0\uBC8C\uACFC \uC591\uBD09\uC0B0\uC5C5 \uBCF4\uD638\uC5D0 \uB300\uD55C
      \uAD6D\uAC00\uC801 \uC758\uBB34\uB97C \uAC15\uD654\uB97C \uC704\uD574 \uBC95\uB960
      \uC81C\uC815\uC744 \uC694\uCCAD\uD588\uB2E4. \uADF8\uB7EC\uB098 \uC785\uBC95
      \uACFC\uC815\uC774 \uAE38\uC5B4 \uB2F9\uC7A5\uC740 \uC544\uBB34 \uD6A8\uACFC\uAC00
      \uC5C6\uACE0, \uC81C\uC815\uC5D0 \uC2E4\uD328\uD558\uBA74 \uBB34\uC0B0\uC774
      \uB418\uBC84\uB9B0\uB2E4.\""
    - "\"\uB2E8\uAE30\uC801\uC73C\uB85C \uAFC0 \uACF5\uAE09 \uBD80\uC871\uC744 \uD574\uC18C\uD588\uC9C0\uB9CC,
      \uC9C0\uC18D\uB41C\uB2E4\uBA74 \uAD6D\uB0B4 \uC591\uBD09\uC0B0\uC5C5\uC758
      \uACBD\uC7C1\uB825\uC774 \uC57D\uD654\uB418\uACE0, \uAD6D\uC0B0 \uAFC0 \uC2DC\uC7A5\uC774
      \uCD95\uC18C\uB418\uB294 \uB4F1 \uBD80\uC815\uC801 \uC601\uD5A5\uC774 \uBC1C\uC0DD\uD560
      \uC218 \uC788\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC778\uADFC \uB18D\uC7A5\uC5D0\uC11C \uBFCC\uB9B0 \uC0B4\uCDA9\uC81C\uAC00
      \uC591\uBD09\uC7A5\uAE4C\uC9C0 \uD758\uB7EC\uB4E4\uC5B4\uC654\uB2E4."
    choices:
    - "\uBBFC\uC0AC \uC18C\uC1A1\uC73C\uB85C \uCC45\uC784\uC744 \uBB3B\uAE30"
    - "\uCC28\uB2E8 \uC2DC\uC124 \uC124\uCE58"
    - "\uD53C\uD574 \uAC10\uC218"
    results:
    - "\uC0B4\uCDA9\uC81C\uB85C \uC778\uD55C \uD53C\uD574\uC5D0 \uB300\uD574 \uBBFC\uC0AC
      \uC18C\uC1A1\uC744 \uC81C\uAE30\uD588\uB2E4. \uC18C\uC1A1\uC5D0\uB294 \uAE34
      \uC2DC\uAC04\uACFC \uBE44\uC6A9\uC774 \uBD80\uB2F4\uB41C\uB2E4."
    - "\uCC28\uB2E8 \uC2DC\uC124\uC744 \uC124\uCE58\uD574\uC11C \uC0B4\uCDA9\uC81C\uC758
      \uC9C1\uC811\uC801\uC778 \uC720\uC785\uC744 \uC904\uC600\uB2E4. \uC9C0\uC18D\uC801\uC778
      \uBAA8\uB2C8\uD130\uB9C1\uACFC \uAD00\uB9AC\uAC00 \uD544\uC694\uD560 \uB4EF\uD558\uB2E4."
    - "\"\uC774\uBBF8 \uC5CE\uC9C8\uB7EC\uC9C4 \uBB3C\uC774\uAE30\uC5D0 \uD53C\uD574\uB97C
      \uAC10\uC218\uD558\uAE30\uB85C \uD588\uB2E4. \uC608\uC0C1\uD55C \uC77C\uC774\uC9C0\uB9CC,
      \uBC8C\uC774 \uB300\uB7C9 \uD3D0\uC0AC\uD558\uACE0 \uB9D0\uC544\uC11C \uBC8C\uC744
      \uCD94\uAC00\uB85C \uB4E4\uC5EC\uC654\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uC9C0\uC790\uCCB4\uAC00 \uC9C0\uC5ED\uAC1C\uBC1C\uC744 \uBA85\uBAA9\uC73C\uB85C
      \uBC8C\uD1B5\uC774 \uC788\uB294 \uC57C\uC0B0\uC744 \uBC00\uC5B4\uB0B4\uB824\uACE0
      \uD55C\uB2E4."
    choices:
    - "\uD658\uACBD\uC601\uD5A5\uD3C9\uAC00\uB97C \uC694\uCCAD\uD574 \uC0AC\uC5C5
      \uC911\uB2E8 \uCD94\uC9C4"
    - "\uAC1C\uBC1C \uCC2C\uC131 \uBC0F \uB300\uAC00\uB85C \uBCF4\uC870\uAE08 \uC218\uB839"
    - "\uC808\uBC18\uB9CC \uAC1C\uBC1C"
    results:
    - "\uAC1C\uBC1C\uC0AC\uC5C5\uC774 \uD658\uACBD\uC5D0 \uBBF8\uCE58\uB294 \uC601\uD5A5\uC744
      \uACFC\uD559\uC801\uC73C\uB85C \uC870\uC0AC \uBC0F \uD3C9\uAC00\uD558\uB3C4\uB85D
      \uD658\uACBD\uC601\uD5A5\uD3C9\uAC00\uB97C \uC694\uCCAD\uD588\uB2E4. \uD3C9\uAC00
      \uACB0\uACFC\uC5D0 \uB530\uB77C \uC0AC\uC5C5\uC774 \uCDE8\uC18C\uB420 \uC218\uB3C4
      \uC788\uB2E4."
    - "\uAC1C\uBC1C\uC5D0 \uCC2C\uC131\uD558\uACE0 \uBCF4\uC870\uAE08\uC744 \uC218\uB839\uD588\uB2E4.
      \uADF8\uB7EC\uB098 \uBC8C\uD1B5\uC774 \uC788\uB294 \uC57C\uC0B0 \uC77C\uBD80\uAC00
      \uD6FC\uC190\uB418\uC5B4\uC11C \uC591\uBD09\uC5C5\uC758 \uC9C0\uC18D \uAC00\uB2A5\uC131\uC774
      \uC18C\uD3ED \uAC10\uC18C\uD588\uB2E4."
    - "\uC0B0\uC758 \uC77C\uBD80\uB9CC \uAC1C\uBC1C\uD558\uAE30\uB85C \uC9C0\uC790\uCCB4\uC640
      \uD611\uC758\uD588\uB2E4. \uADF8\uB7EC\uB098 \uAC1C\uBC1C\uB85C \uC778\uD55C
      \uD658\uACBD \uBCC0\uD654\uC640 \uC11C\uC2DD\uC9C0 \uCD95\uC18C \uB4F1\uC740
      \uBD88\uAC00\uD53C\uD588\uAE30\uC5D0 \uC591\uBD09\uC5C5\uC5D0 \uBD80\uBD84\uC801\uC778
      \uD0C0\uACA9\uC774 \uBC1C\uC0DD\uD588\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uD76C\uADC0 \uC57C\uC0DD\uC885\uC774 \uADFC\uCC98\uC5D0\uC11C \uBC1C\uACAC\uB418\uC5C8\uB2E4."
    choices:
    - "\uC0DD\uBB3C\uB2E4\uC591\uC131 \uBCF4\uD638\uAD6C\uC5ED\uC73C\uB85C \uC9C0\uC815
      \uC694\uCCAD"
    - "\uC870\uC0AC\uB2E8\uB9CC \uD30C\uACAC"
    - "\uC0AC\uC5C5\uC9C0 \uC774\uC804\uC758 \uC5B4\uB824\uC6C0\uC73C\uB85C \uBCF4\uD638
      \uBD88\uAC00"
    results:
    - "\"\uBCF4\uD638 \uAD6C\uC5ED\uC73C\uB85C \uC9C0\uC815\uC744 \uC694\uCCAD\uD588\uB2E4.
      \uD76C\uADC0 \uC57C\uC0DD\uC885\uACFC \uC8FC\uBCC0 \uC0DD\uD0DC\uACC4\uB97C
      \uBCF4\uD638\uD560 \uC218 \uC788\uC5B4 \uC7A5\uAE30\uC801\uC73C\uB85C\uB294
      \uC0DD\uD0DC\uACC4\uC5D0 \uAE0D\uC815\uC801\uC778 \uC601\uD5A5\uC744 \uBBF8\uCE58\uC9C0\uB9CC,
      \uC9C0\uC5ED \uAC1C\uBC1C\uC5D0 \uC81C\uC57D\uC774 \uC0DD\uAE38 \uC218 \uC788\uC744
      \uAC83\uC774\uB2E4.\""
    - "\uC870\uC0AC\uB2E8\uC744 \uD30C\uACAC\uD574 \uD574\uB2F9 \uC885\uC758 \uBD84\uD3EC\uC640
      \uC0DD\uD0DC\uB9CC \uC870\uC0AC\uD558\uB294 \uAC83\uC73C\uB85C \uC9C4\uD589\uD588\uB2E4.
      \uBCC4\uB3C4\uC758 \uBCF4\uD638 \uC870\uCE58\uAC00 \uC774\uB8E8\uC5B4\uC9C0\uC9C0
      \uC54A\uC73C\uBA74 \uC778\uAC04\uC758 \uACBD\uC81C\uD65C\uB3D9 \uAC19\uC740
      \uC678\uBD80 \uC694\uC778\uC73C\uB85C \uC11C\uC2DD\uC9C0\uAC00 \uD30C\uAD34\uB420
      \uC218 \uC788\uB2E4."
    - "\uC591\uBD09\uC5C5\uC774 \uC911\uB2E8\uB420\uAE4C \uB5A8\uB824 \uBCF4\uD638
      \uC870\uCE58\uB97C \uB530\uB85C \uD558\uC9C0 \uC54A\uC558\uB2E4. \uC774\uC81C
      \uC774 \uC57C\uC0DD\uC885\uC744 \uB2E4\uC2DC \uB9CC\uB0A0 \uC218 \uC788\uC744\uC9C0
      \uBAA8\uB974\uACA0\uB2E4..."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
