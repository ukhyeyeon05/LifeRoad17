        value: -1
  - question: "\uAFC0 \uC0DD\uC0B0\uB7C9 \uC800\uD558\uB85C \uC218\uC775\uC774 \uBC18\uD1A0\uB9C9\uC774
      \uB0AC\uB2E4."
    choices:
    - "\uC815\uBD80\uC5D0 \uC0DD\uC0B0\uBCF4\uC870\uAE08\uC744 \uC694\uCCAD"
    - "\uC720\uAE30\uB18D \uAFC0\uB85C \uC804\uD658\uD558\uC5EC \uAC00\uCE58\uB85C
      \uC2B9\uBD80"
    - "\uAFC0 \uC218\uC785 \uD655\uB300"
    results:
    - "\"\uC815\uBD80\uC758 \uBCF4\uC870\uAE08 \uC815\uCC45\uC73C\uB85C \uB2E8\uAE30\uC801\uC73C\uB85C
      \uC218\uC775 \uAC10\uC18C\uBD84 \uC77C\uBD80\uB97C \uBCF4\uC804 \uBC1B\uC744
      \uC218 \uC788\uB2E4. \uD558\uC9C0\uB9CC \uC81C\uD55C\uC801\uC77C \uC218 \uC788\uC73C\uBA70,
      \uC7A5\uAE30\uC801\uC73C\uB85C\uB294 \uD574\uACB0\uCC45\uC774 \uB418\uC9C0
      \uBABB\uD560 \uAC83\uC774\uB2E4.\""
    - "\"\uC720\uAE30\uB18D \uAFC0 \uC2DC\uC7A5\uC740 \uC138\uACC4\uC801\uC73C\uB85C
      \uB192\uC740 \uC131\uC7A5\uC138\uB97C \uBCF4\uC774\uACE0, \uC18C\uBE44\uC790\uB4E4\uB3C4
      \uCC9C\uC5F0\xB7\uC720\uAE30\uB18D \uC81C\uD488\uC744 \uC120\uD638\uD558\uB294
      \uACBD\uD5A5\uC774 \uB69C\uB837\uD558\uB2E4. \uC218\uC775\uC131\uC758 \uAC1C\uC120\uC774
      \uAE30\uB300\uB41C\uB2E4.\""
    - "\"\uC218\uC785 \uAFC0\uC744 \uD1B5\uD574 \uB2E8\uAE30\uC801\uC73C\uB85C \uACF5\uAE09
      \uBD80\uC871\uC744 \uD574\uC18C\uD560 \uC218 \uC788\uACA0\uC9C0\uB9CC, \uAD6D\uB0B4\uC0B0
      \uAFC0 \uC2DC\uC7A5\uC758 \uC810\uC720\uC728\uACFC \uACBD\uC7C1\uB825\uC774
      \uB5A8\uC5B4\uC9C0\uB294 \uAC83\uC774 \uAD6D\uB0B4 \uC591\uBD09\uC5C5\uC5D0
      \uBD80\uC815\uC801\uC778 \uC601\uD5A5\uC744 \uB07C\uCE60 \uAC83\uC774\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC591\uBD09\uC7A5 \uC8FC\uBCC0\uC5D0 \uC678\uB798\uC885\uC774 \uBC1C\uACAC\uB418\uC5C8\uB2E4."
    choices:
    - "\uC989\uC2DC \uBC29\uC5ED \uC791\uC5C5\uC744 \uC2E4\uC2DC"
    - "\uB2F9\uC7A5 \uD53C\uD574\uAC00 \uC5C6\uC5B4 \uBB34\uC2DC"
    - "\uAC10\uC2DC \uCCB4\uACC4 \uAD6C\uCD95"
    results:
    - "\"\uBC14\uB85C \uC9C0\uC790\uCCB4\uC5D0 \uC54C\uB9AC\uACE0 \uBC29\uC5ED \uC791\uC5C5\uC774
      \uC774\uB8E8\uC5B4\uC838 \uC7A0\uC7AC\uC801 \uC704\uD5D8\uC744 \uC608\uBC29\uD588\uACE0,
      \uC5B8\uB860\uC744 \uD1B5\uD574 \uC804\uAD6D\uC5D0 \uC8FC\uC758\uD560 \uAC83\uC744
      \uC54C\uB838\uB2E4.\""
    - "\"\uCD08\uAE30\uC5D0\uB294 \uD53C\uD574\uAC00 \uC5C6\uC5C8\uC9C0\uB9CC, \uCD5C\uADFC
      \uBC88\uC2DD \uBC0F \uD655\uC0B0\uC774 \uC774\uB8E8\uC5B4\uC838 \uAFC0\uBC8C\uC5D0\uAC8C
      \uC704\uD611\uC774 \uB418\uACE0 \uC788\uB2E4.\""
    - "\uC678\uB798\uC885\uC758 \uD655\uC0B0 \uC0C1\uD669\uACFC \uD53C\uD574 \uBC1C\uC0DD
      \uC5EC\uBD80\uB97C \uC2E0\uC18D\uD558\uAC8C \uD30C\uC545\uD560 \uC218 \uC788\uC5C8\uB2E4.
      \uAC10\uC2DC\uC5D0\uC11C \uBA48\uCD94\uC9C0 \uC54A\uACE0 \uBC29\uC81C \uC870\uCE58\uAC00
      \uC774\uB8E8\uC5B4\uC838\uC57C \uD560 \uAC83\uC774\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uB3C4\uC2DC\uD654\uB85C \uAFC0\uBC8C\uC774 \uC810\uC810 \uC0AC\uB77C\uC9C0\uACE0
      \uC788\uB2E4."
    choices:
    - "\uB3C4\uC2DC \uC591\uBD09 \uD504\uB85C\uC81D\uD2B8 \uCD94\uC9C4"
    - "\uB3C4\uC2DC \uAC1C\uBC1C\uC9C0\uC5ED \uB0B4 \uBC8C\uC9D1 \uC124\uCE58 \uD5C8\uC6A9
      \uC694\uAD6C"
    - "\uBC29\uAD00"
    results:
    - "\uB3C4\uC2DC \uB0B4 \uB179\uC9C0 \uACF5\uAC04\uC744 \uD65C\uC6A9\uD558\uC5EC
      \uAFC0\uBC8C \uC11C\uC2DD\uC9C0\uC640 \uBA39\uC774\uC6D0\uC744 \uC81C\uACF5\uD588\uB2E4.
      \uB355\uBD84\uC5D0 \uAFC0\uBC8C \uAC1C\uCCB4 \uAC10\uC18C \uC644\uD654\uC5D0
      \uC870\uAE08\uC774\uB098\uB9C8 \uAE30\uC5EC\uB97C \uD560 \uC218 \uC788\uC5C8\uB2E4.
      \uB3C4\uC2DC\uC758 \uC704\uD5D8\uC694\uC778\uC740 \uCCB4\uAC8C\uC801\uC778
      \uAD00\uB9AC \uB300\uC0C1\uC774\uB2E4."
    - "\uAC1C\uBC1C\uC9C0\uC5ED \uB0B4 \uBC8C\uC9D1 \uC124\uCE58\uAC00 \uD5C8\uAC00\uB418\uC5B4
      \uC11C\uC2DD\uC9C0 \uBCF4\uC804 \uAC00\uB2A5\uC131\uC744 \uB192\uC600\uB2E4.
      \uD558\uC9C0\uB9CC \uB3C4\uC2DC\uAC1C\uBC1C\uB85C \uC778\uD55C \uC11C\uC2DD\uC9C0
      \uB2E8\uC808\uACFC \uB300\uAE30 \uC624\uC5FC \uB4F1\uC758 \uC704\uD5D8\uB3C4
      \uACF5\uC874\uD558\uAE30 \uB54C\uBB38\uC5D0 \uD6A8\uACFC\uAC00 \uC81C\uD55C\uC801\uC774\uC5C8\uB2E4."
    - "\uBCC4\uB3C4\uC758 \uB300\uC751 \uC5C6\uC774 \uBC29\uCE58\uD588\uB2E4. \uACB0\uAD6D
      \uACC4\uC18D\uB418\uB294 \uB3C4\uC2DC\uD654\uB85C \uC778\uD574 \uAFC0\uBC8C
      \uAC1C\uCCB4\uC218\uAC00 \uAE09\uAC10\uD558\uACE0 \uB9D0\uC558\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
