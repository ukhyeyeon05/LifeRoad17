  m_Script: {fileID: 11500000, guid: 2de8e05f04ca588419838d933500abaa, type: 3}
  m_Name: story_puz16_StorySet
  m_EditorClassIdentifier: 
  stories:
  - question: "\uC778\uD130\uB137\uC5D0 \uD53C\uD574 \uC0AC\uC9C4\uC774 \uBB34\uB2E8\uC73C\uB85C
      \uC62C\uB77C\uAC00\uACE0 \uC788\uB2E4."
    choices:
    - "\uBC95\uB960 \uC790\uBB38\uC744 \uBC1B\uACE0 \uBBFC\uC0AC\uC18C\uC1A1 \uC900\uBE44"
    - "\uD574\uB2F9 \uD50C\uB7AB\uD3FC\uC5D0 \uC0AD\uC81C \uC694\uCCAD"
    - "\uB313\uAE00 \uC2E0\uACE0"
    results:
    - "\"\uBC95\uB960 \uC790\uBB38\uC744 \uD1B5\uD574 \uB0B4 \uAD8C\uB9AC\uB97C \uBA85\uD655\uD788
      \uD655\uC778\uD558\uACE0, \uBBFC\uC0AC \uC18C\uC1A1\uC744 \uC81C\uAE30\uD588\uB2E4.
      \uC2DC\uAC04\uACFC \uBE44\uC6A9\uB3C4 \uBD80\uB2F4\uC774\uC9C0\uB9CC, \uAC00\uD574\uC790\uB97C
      \uC7A1\uC744 \uC218 \uC788\uC744\uC9C0 \uAC71\uC815\uB41C\uB2E4.\""
    - "\"\uB098\uB294 \uC2E0\uC18D\uD558\uAC8C \uAD00\uB9AC\uC790\uC5D0\uAC8C \uC0AD\uC81C
      \uC694\uCCAD\uC744 \uD588\uACE0, \uD574\uB2F9 \uD50C\uB7AB\uD3FC\uC758 \uAE00\uC740
      \uC9C0\uC6CC\uC84C\uB2E4.\""
    - "\uD574\uB2F9 \uD50C\uB7AB\uD3FC\uC758 \uC2E0\uACE0 \uAE30\uB2A5\uC73C\uB85C
      \uAC8C\uC2DC\uAE00\uC744 \uC2E0\uACE0\uD558\uC600\uB2E4. \uAD00\uB9AC\uC790\uAC00
      \uD574\uB2F9 \uC2E0\uACE0\uB97C \uD655\uC778\uD558\uB294\uB370 \uC2DC\uAC04\uC774
      \uC624\uB798 \uAC78\uB838\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uB313\uAE00\uC5D0 \uC678\uBAA8 \uBE44\uD558 \uBC0F \uD5C8\uC704\uC0AC\uC2E4\uC774
      \uD3EC\uD568\uB410\uB2E4."
    choices:
    - "\uC0AC\uC774\uBC84 \uBA85\uC608\uD6FC\uC190\uC73C\uB85C \uD615\uC0AC \uACE0\uC18C"
    - "\uC815\uC2E0\uC801 \uD53C\uD574 \uBCF4\uC0C1 \uC18C\uC1A1 \uC900\uBE44"
    - "\uAC00\uD574\uC790\uC640 \uC9C1\uC811 \uC5F0\uB77D"
    results:
    - "\uC0AC\uC774\uBC84 \uBA85\uC608\uD6FC\uC190\uC73C\uB85C \uD615\uC0AC \uACE0\uC18C\uB97C
      \uC9C4\uD589\uD588\uB2E4. \uBE44\uC6A9\uACFC \uAD00\uACC4\uC5C6\uC774 \uBD80\uB514
      \uCC98\uBC8C\uB418\uC5C8\uC73C\uBA74 \uD55C\uB2E4."
    - "\uC815\uC2E0\uC801 \uD53C\uD574 \uBCF4\uC0C1\uC5D0 \uB300\uD574 \uBBFC\uC0AC\uC0C1
      \uC190\uD574\uBC30\uC0C1\uC744 \uCCAD\uAD6C\uD588\uB2E4. \uD53C\uD574 \uC0BF\uC2E4\uC744
      \uC785\uC99D\uD558\uB294\uB370 \uCD5C\uC120\uC744 \uB2E4\uD574\uC57C\uACA0\uB2E4."
    - "\uB313\uAE00\uC758 \uC791\uC131\uC790\uC640 \uC9C1\uC811 \uC5F0\uB77D\uC744
      \uC2DC\uB3C4\uD588\uB2E4. \uADF8\uB7F0\uB370 \uC0C1\uB300\uBC29\uC758 2\uCC28
      \uAC00\uD574\uAC00 \uC774\uB8E8\uC5B4\uC9C0\uACE0 \uB9D0\uC558\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uD53C\uD574 \uC0AC\uC9C4\uC774 \uC9E4\uBC29\uC73C\uB85C \uD655\uC0B0\uB418\uACE0
      \uC788\uB2E4."
    choices:
    - "\uB514\uC9C0\uD138 \uC7A5\uC758\uC0AC \uC11C\uBE44\uC2A4 \uC774\uC6A9"
    - "\uB514\uC9C0\uD138 \uBC94\uC8C4 \uD53C\uD574 \uC9C0\uC6D0\uC13C\uD130\uC5D0
      \uB3C4\uC6C0 \uC694\uCCAD"
    - "\uBB34\uC2DC\uD558\uAE30"
    results:
    - "\"\uB514\uC9C0\uD138 \uC7A5\uC758\uC0AC \uC11C\uBE44\uC2A4\uB97C \uD1B5\uD574
      \uC778\uD130\uB137\uC5D0 \uC720\uD3EC\uB41C \uB0B4 \uC0AC\uC9C4\uC5D0 \uB300\uD574
      \uC0AD\uC81C\uB97C \uC694\uCCAD\uD588\uB2E4. \uD50C\uB7AB\uD3FC \uC815\uCC45,
      \uC720\uD3EC \uACBD\uB85C \uB4F1 \uC5EC\uB7EC \uC694\uC778\uC774 \uC788\uAE30\uC5D0
      \uBB34\uC870\uAC74 \uBAA8\uB450 \uC0AD\uC81C\uAC00 \uB418\uC9C4 \uC54A\uB294\uB2E4\uACE0
      \uD55C\uB2E4.\""
    - "\uB514\uC9C0\uD138 \uBC94\uC8C4\uC5D0 \uB300\uD574 \uC9C0\uC6D0\uC13C\uD130\uC5D0
      \uB3C4\uC6C0\uC744 \uC694\uCCAD\uD588\uB2E4. \uC9C0\uC6D0\uC13C\uD130\uC5D0\uC11C\uB294
      \uB514\uC9C0\uD138 \uC7A5\uC758\uC0AC\uCC98\uB7FC \uD53C\uD574 \uCD2C\uC601\uBB3C\uC758
      \uC0AD\uC81C\uC640 \uC2EC\uB9AC \uC0C1\uB2F4 \uB4F1 \uB2E4\uC591\uD55C \uC9C0\uC6D0\uC744
      \uBC1B\uC744 \uC218 \uC788\uC5C8\uB2E4."
    - "\uAC81\uC774 \uB098\uC11C \uC560\uC368 \uBB34\uC2DC\uD588\uB2E4. \uD53C\uD574
      \uC0AC\uC9C4\uC758 \uD655\uC0B0\uC774 \uACC4\uC18D\uB420 \uAC83\uC774\uB77C\uB294
      \uC0DD\uAC01\uC5D0 \uBC24\uB0AE\uC744 \uC774\uB8F0 \uC218 \uC5C6\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uD53C\uD574 \uC0AC\uB840\uB97C SNS\uC5D0 \uACF5\uAC1C\uD560\uC9C0
      \uACE0\uBBFC\uC774\uB2E4."
    choices:
    - "\uB2E4\uB978 \uD53C\uD574\uC790\uC640 \uC5F0\uB300\uD574 \uBAA9\uC18C\uB9AC
      \uB0B4\uAE30"
    - "\uC775\uBA85\uC73C\uB85C \uCEE4\uBBA4\uB2C8\uD2F0\uC5D0 \uAC8C\uC2DC"
    - "\uAC00\uB9CC\uD788 \uC788\uAE30"
    results:
    - "\"\uB2E4\uB978 \uD53C\uD574\uC790\uB4E4\uACFC \uC811\uCD09 \uBC0F \uC5F0\uB300\uD558\uC5EC
      \uC0AC\uD68C\uC801 \uAD00\uC2EC\uC744 \uB192\uC774\uACE0, \uC81C\uB3C4 \uAC1C\uC120\uC774\uB098
      \uD53C\uD574 \uD68C\uBCF5\uC744 \uC704\uD55C \uC9C0\uC6D0 \uD655\uB300\uB97C
      \uC774\uB044\uB294 \uC2DC\uB3C4\uB97C \uD588\uB2E4.\""
    - "\uC775\uBA85\uC131\uC744 \uD1B5\uD574 \uC2EC\uB9AC\uC801\uC778 \uBD80\uB2F4\uC744
      \uB35C\uACE0 \uD53C\uD574 \uC0AC\uC2E4\uC744 \uC54C\uB838\uB2E4. \uC775\uBA85
      \uCEE4\uBBA4\uB2C8\uD2F0\uC758 \uD2B9\uC131\uC0C1 2\uCC28 \uAC00\uD574\uAC00
      \uC774\uB8E8\uC5B4\uC9C0\uACE4 \uD588\uB2E4."
    - "\"\uC2E0\uC0C1 \uB178\uCD9C, 2\uCC28 \uAC00\uD574 \uB4F1\uC744 \uB9C9\uACE0\uC790
      \uC5EC\uAE30\uC800\uAE30 \uC54C\uB9AC\uACE0 \uB2E4\uB2C8\uC9C0 \uC54A\uC558\uB2E4.
      \uD604\uC7AC \uD640\uB85C \uBC84\uD168\uB0B4\uB824\uB2C8 \uC678\uB86D\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uC0AC\uC774\uBC84 \uD3ED\uB825 \uD53C\uD574\uAC00 \uC5B8\uB860\uC5D0
      \uC54C\uB824\uC84C\uB2E4."
    choices:
    - "\uAE30\uC790\uD68C\uACAC\uC744 \uC5F4\uACE0 \uC81C\uB3C4 \uAC1C\uC120\uC744
      \uC694\uAD6C"
    - "\uACF5\uB860\uD654\uBCF4\uB2E4 \uBC95\uC801 \uB300\uC751\uC5D0 \uC9D1\uC911"
    - "\uC5B8\uB860\uACFC \uC811\uCD09 \uD53C\uD558\uAE30"
    results:
    - "\uC5B8\uB860\uC758 \uC870\uBA85\uC744 \uBC1B\uC544 \uC0AC\uD68C\uC801 \uC774\uC288\uB85C
      \uBD80\uAC01\uB418\uAE30\uB97C \uB178\uB838\uB2E4. \uC815\uBD80\xB7\uAD6D\uD68C\uC758
      \uB300\uC751\uC744 \uCD09\uAD6C\uD558\uB294\uB370 \uC2E4\uC9C8\uC801\uC778
      \uC601\uD5A5\uC744 \uBBF8\uCCE4\uB2E4."
    - "\uC5B8\uB860 \uB178\uCD9C\uC5D0 \uB530\uB978 2\uCC28 \uAC00\uD574\uB97C \uC904\uC774\uACE0\uC790
      \uC0AC\uD68C\uC801 \uAD00\uC2EC\uC774\uB098 \uC81C\uB3C4 \uAC1C\uC120\uC744
      \uC774\uB04C\uC5B4\uB0B4\uB294 \uB300\uC2E0 \uBC95\uC801 \uC808\uCC28\uC5D0
      \uC9D1\uC911\uD558\uAE30\uB85C \uD588\uB2E4."
    - "\"\uC5B8\uB860\uC5D0 \uC54C\uB824\uC9C4\uB2E4 \uD55C\uB4E4, \uB2F9\uC7A5 \uBB38\uC81C\uAC00
      \uD574\uACB0\uB420 \uAC83 \uAC19\uC9C0 \uC54A\uC544\uC11C \uB354 \uC774\uC0C1\uC758
      \uACF5\uB860\uD654\uB294 \uD558\uC9C0 \uC54A\uAE30\uB85C \uD588\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uAC00\uD574\uC790\uC758 \uC2E0\uC0C1\uC774 \uB4DC\uB7EC\uB0AC\uB2E4\uB294
      \uC81C\uBCF4\uAC00 \uB4E4\uC5B4\uC654\uB2E4."
    choices:
    - "\uC0AC\uC801 \uBCF5\uC218 \uAC70\uBD80 \uBC0F \uBC95\uC801 \uC808\uCC28"
    - "\uC775\uBA85 \uCEE4\uBBA4\uB2C8\uD2F0\uC5D0 \uC554\uC2DC \uB0A8\uAE30\uAE30"
    - "\uC78A\uC5B4\uBC84\uB9AC\uAE30"
    results:
    - "\"\uB098\uB294 \uBD84\uB178\uB97C \uCC38\uC9C0 \uBABB\uD558\uACE0, \uAC00\uD574\uC790\uB97C
      \uCC3E\uC544\uAC00 \uBCF5\uC218\uB97C \uD588\uB2E4. \uD558\uC9C0\uB9CC, \uB098\uAE4C\uC9C0
      \uBC94\uC8C4\uC790\uAC00 \uB418\uAC8C \uC0DD\uACBC\uB2E4.\""
    - "\"\uB4DC\uB7EC\uB09C \uC2E0\uC0C1\uC744 \uBC14\uD0D5\uC73C\uB85C \uBC95\uC801
      \uC808\uCC28\uB97C \uBC1F\uC558\uB2E4. \uD53C\uD574\uC790 \uC2E0\uBCC0 \uBCF4\uD638,
      \uBD88\uBC95 \uCD2C\uC601\uBB3C \uC0AD\uC81C \uC9C0\uC6D0, \uC2EC\uB9AC \uC0C1\uB2F4
      \uB4F1 \uB2E4\uC591\uD55C \uC9C0\uC6D0\uC744 \uBC1B\uC744 \uC218 \uC788\uC5C8\uB2E4.\""
    - "\uAC00\uD574\uC790\uC5D0 \uB300\uD55C \uCD94\uAC00\uC801\uC778 \uC870\uCE58\uAC00
      \uC774\uB8E8\uC5B4\uC9C0\uC9C0 \uC54A\uC544 \uBC95\uC801 \uBCF4\uD638\uC640
      \uC9C0\uC6D0\uC744 \uBC1B\uAE30\uB294 \uC5B4\uB824\uC6CC\uC84C\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
