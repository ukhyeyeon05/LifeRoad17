%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2de8e05f04ca588419838d933500abaa, type: 3}
  m_Name: story_puz3_StorySet
  m_EditorClassIdentifier: 
  storyList:
  - question: "\"\uB098\uB294 \uC18C\uB3C4\uC2DC OO\uC2DC\uC5D0 \uC0B4\uACE0 \uC788\uB294
      \uC608\uBE44 \uC5C4\uB9C8\uC774\uB2E4. \uC815\uAE30 \uAC80\uC9C4\uC744 \uBC1B\uAE30
      \uC704\uD574\uC11C\uB294 \uB9E4\uBC88 \uB2E4\uB978 \uC9C0\uC5ED\uC73C\uB85C
      \uC774\uB3D9\uD574\uC57C \uD55C\uB2E4. \uD604\uC7AC \uCD9C\uC0B0 \uC608\uC815\uC77C\uAE4C\uC9C0
      \uB450 \uB2EC \uC815\uB3C4\uAC00 \uB0A8\uC544\uC788\uB294\uB370, \uB9CC\uC57D
      \uAC11\uC791\uC2A4\uB7EC\uC6B4 \uC77C\uC774 \uBC1C\uC0DD\uD558\uBA74 \uC5B4\uB5BB\uAC8C
      \uB420\uC9C0 \uB108\uBB34 \uAC71\uC815\uB41C\uB2E4. \uD604\uC7AC \uB2E4\uB2C8\uACE0
      \uC788\uB294 \uC9C1\uC7A5\uC740 \uC5B4\uB5BB\uAC8C \uD574\uC57C \uD560\uAE4C?\""
    choices:
    - "\uCD9C\uC0B0 \uC804\uAE4C\uC9C0 \uCD5C\uB300\uD55C \uC9C1\uC7A5\uC744 \uB2E4\uB2CC\uB2E4."
    - "\uCD9C\uC0B0 \uD55C \uB2EC \uC804\uAE4C\uC9C0\uB9CC \uC77C\uD558\uACE0 \uD734\uC9C1
      \uD55C\uB2E4."
    - "\"\uC6B0\uC120 \uD734\uC9C1\uC744 \uC2E0\uCCAD\uD558\uACE0, \uCD9C\uC0B0 \uC608\uC815\uC77C\uAE4C\uC9C0
      \uC548\uC815\uC744 \uCDE8\uD55C\uB2E4.\""
    results:
    - "\uCD5C\uB300\uD55C \uCD9C\uADFC\uC744 \uD574\uBCF4\uAE30\uB85C \uD588\uB2E4.
      \uD558\uC9C0\uB9CC \uB9CC\uC0AD\uC778 \uBAB8\uC73C\uB85C\uB294 \uD070 \uBD80\uB2F4\uC774
      \uB530\uB97C \uAC83\uC774\uB2E4."
    - "\uC6B0\uC120 \uD55C \uB2EC \uC815\uB3C4\uB9CC \uB354 \uC77C\uD574\uBCF4\uACE0
      \uC26C\uAE30\uB85C \uD588\uB2E4. \uADF8\uB7FC \uC18C\uB4DD\uACFC \uC548\uC815\uC774
      \uC5B4\uB290 \uC815\uB3C4 \uADE0\uD615\uC744 \uC774\uB8F0 \uC218 \uC788\uC9C0
      \uC54A\uC744\uAE4C?"
    - "\uB9CC\uC0AD\uC758 \uBAB8\uC73C\uB85C\uB294 \uCD9C\uD1F4\uADFC\uB3C4 \uB9CC\uB9CC\uCE58
      \uC54A\uC544\uC11C \uD734\uC9C1\uC744 \uD558\uAE30\uB85C \uD588\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\"\uC601\uC591\uC18C \uC12D\uCDE8\uAC00 \uC911\uC694\uD558\uB2E4\uB294
      \uAC78 \uC54C\uC9C0\uB9CC, \uB9E4\uBC88 \uB07C\uB2C8\uB97C \uAC74\uAC15\uC2DD\uC73C\uB85C
      \uC900\uBE44\uD558\uAE30\uC5D4 \uBE44\uC6A9\uB3C4 \uB9CE\uC774 \uB4E4\uACE0
      \uD53C\uACE4\uD558\uB2E4.\""
    choices:
    - "\uC880 \uB354 \uD22C\uC790\uD574\uC11C \uB9C8\uC74C\uC744 \uB193\uC744 \uC218
      \uC788\uB294 \uC720\uAE30\uB18D \uC2DD\uB2E8\uC744 \uC900\uBE44\uD55C\uB2E4."
    - "\uC628\uB77C\uC778 \uC1FC\uD551\uBAB0\uC5D0\uC11C \uD560\uC778 \uC911\uC778
      \uC2DD\uC7AC\uB8CC\uB85C \uC2DD\uB2E8\uC744 \uC900\uBE44\uD55C\uB2E4."
    - "\"\uAC04\uD3B8\uC2DD, \uB0C9\uB3D9 \uC2DD\uD488 \uB4F1\uC73C\uB85C\uB3C4 \uCDA9\uBD84\uD560
      \uAC83\uC774\uB2E4.\""
    results:
    - "\"\uAC00\uACA9\uC740 \uC880 \uBD80\uB2F4\uC774 \uB418\uC9C0\uB9CC, \uC544\uC774\uB97C
      \uC704\uD574 \uD22C\uC790\uD558\uAE30\uB85C \uD588\uB2E4. \uC5BC\uB9C8\uD6C4,
      \uB098\uB294 \uC720\uAE30\uB18D \uC2DD\uD488\uC774 \uC77C\uBC18 \uC2DD\uD488\uACFC
      \uD070 \uCC28\uC774\uAC00 \uC5C6\uB2E4\uB294 \uAE30\uC0AC\uB97C \uBC1C\uACAC\uD588\uB2E4.\""
    - "\uD560\uC778\uD558\uB294 \uC7AC\uB8CC\uB85C \uC2DD\uB2E8\uC744 \uC900\uBE44\uD558\uB2C8
      \uB3C8\uC744 \uB9CE\uC774 \uC544\uB084 \uC218 \uC788\uC5C8\uB2E4. \uD560\uC778\uD558\uB294
      \uC2DD\uD488\uC740 \uBCF4\uD1B5 \uC720\uD1B5\uAE30\uD55C\uC774 \uC9E7\uAE30\uC5D0
      \uBCF4\uAD00\uC5D0 \uC8FC\uC758\uD558\uB3C4\uB85D \uD558\uC790."
    - "\"\uAC04\uD3B8\uC2DD\uC73C\uB85C \uD574\uACB0\uD558\uB2C8 \uC870\uB9AC \uC2DC\uAC04,
      \uBE44\uC6A9 \uB4F1\uC774 \uD06C\uAC8C \uC904\uC5B4 \uD655\uC2E4\uD788 \uD3B8\uB9AC\uD574\uC84C\uB2E4.
      \uB2E4\uB9CC, \uAC00\uACF5\uB418\uBA74\uC11C \uC190\uC2E4\uB41C \uC601\uC591\uC18C,
      \uCCA8\uAC00\uBB3C \uB4F1\uC774 \uAC71\uC815\uB41C\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uCD9C\uC0B0 \uC608\uC815 \uBCD1\uC6D0\uC744 \uC608\uC57D\uD574\uC57C
      \uD55C\uB2E4. \uC5B4\uB514\uB85C \uD574\uC57C \uD560\uAE4C?"
    choices:
    - "\uC606 \uB3C4\uC2DC\uC5D0 \uC788\uB294 \uC0C1\uAE09 \uC885\uD569\uBCD1\uC6D0\uC5D0
      \uC608\uC57D\uD55C\uB2E4."
    - "\uC774\uB3D9 \uD3B8\uC758\uB97C \uC704\uD574 \uB3D9\uB124\uC758 \uC911\uC18C
      \uBCD1\uC6D0\uC5D0 \uC608\uC57D\uD55C\uB2E4."
    - "\uC0B0\uD6C4\uC870\uB9AC\uC6D0\uACFC \uC5F0\uACC4\uB41C \uC0B0\uBD80\uC778\uACFC\uC5D0
      \uC608\uC57D\uD55C\uB2E4."
    results:
    - "\"\uCCB4\uACC4\uC801\uC778 \uC2DC\uC2A4\uD15C, \uC2E0\uC0DD\uC544 \uC9D1\uC911
      \uCE58\uB8CC\uC2E4 \uB4F1 \uC88B\uC740 \uC810\uC774 \uB9CE\uC740 \uAC83 \uAC19\uB2E4.
      \uD558\uC9C0\uB9CC \uBCD1\uC6D0\uC744 \uC774\uC6A9\uD558\uB824\uBA74 \uC606
      \uB3C4\uC2DC\uB85C \uC774\uB3D9\uD574\uC57C \uD558\uAE30 \uB54C\uBB38\uC5D0
      \uAC70\uB9AC\uC640 \uC785\uC6D0\uC2E4 \uC608\uC57D \uB4F1\uC774 \uC27D\uC9C0
      \uC54A\uC744 \uAC83 \uAC19\uB2E4.\""
    - "\"\uAC70\uB9AC\uAC00 \uAC00\uAE4C\uC6CC \uC548\uC2EC\uC774 \uB418\uB294 \uAC83
      \uAC19\uB2E4. \uADF8\uB7EC\uC9C0 \uC54A\uAE38 \uBC14\uB77C\uC9C0\uB9CC, \uB9CC\uC57D
      \uC751\uAE09\uC0C1\uD669\uC774 \uBC1C\uC0DD\uD55C\uB2E4\uBA74 \uBCD1\uC6D0\uC758
      \uC778\uD504\uB77C\uAC00 \uAC71\uC815\uC774 \uB418\uAE30\uB294 \uD55C\uB2E4.\""
    - "\"\uCD9C\uC0B0 \uD6C4 \uBC14\uB85C \uC870\uB9AC\uC6D0\uC73C\uB85C \uC774\uB3D9\uD560
      \uC218 \uC788\uC73C\uB2C8 \uC544\uC8FC \uB9CC\uC871\uC2A4\uB7FD\uB2E4. \uC0B0\uBD80\uC778\uACFC\uC758
      \uADDC\uBAA8\uAC00 \uD06C\uC9C4 \uC54A\uC544\uB3C4, \uD070 \uBB38\uC81C\uB294
      \uC5C6\uC744 \uAC83\uC774\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uBCD1\uC6D0 \uC678\uB798 \uC9C4\uB8CC\uB97C \uAC00\uC57C\uD558\uB294\uB370
      \uB300\uAE30 \uC624\uC5FC \uACBD\uBCF4\uAC00 \uB5B4\uB2E4. \uC5B4\uB5BB\uAC8C
      \uD574\uC57C \uD560\uAE4C?"
    choices:
    - "\uB9C8\uC2A4\uD06C\uB294 \uC228\uC26C\uAE30 \uBD88\uD3B8\uD558\uB2C8 \uD3C9\uC18C\uCC98\uB7FC
      \uC678\uCD9C\uD55C\uB2E4."
    - "\uB9C8\uC2A4\uD06C\uB97C \uC4F0\uACE0 \uB300\uC911\uAD50\uD1B5\uC744 \uD1B5\uD574
      \uC678\uCD9C\uD55C\uB2E4."
    - "\"\uC678\uCD9C\uC744 \uCDE8\uC18C\uD558\uACE0, \uBE44\uB300\uBA74 \uC9C4\uB8CC\uB85C
      \uC804\uD658\uD55C\uB2E4.\""
    results:
    - "\uB9C8\uC2A4\uD06C\uAC00 \uB108\uBB34 \uAC11\uAC11\uD574\uC11C \uCC29\uC6A9\uD558\uC9C0
      \uC54A\uC558\uB2E4. \uADF8\uB7F0\uB370 \uBAA9\uC774 \uC880 \uCE7C\uCE7C\uD55C
      \uAC83 \uAC19\uB2E4."
    - "\"\uBCF4\uAC74\uC6A9 \uB9C8\uC2A4\uD06C\uB97C \uCC29\uC6A9\uD558\uACE0, \uB300\uC911\uAD50\uD1B5\uC744
      \uD1B5\uD574 \uB300\uAE30\uC640 \uC811\uCD09\uC744 \uC904\uC774\uBA70 \uBCD1\uC6D0\uC5D0
      \uAC14\uB2E4. \uC758\uC0AC \uC120\uC0DD\uB2D8\uAED8\uC11C\uB3C4 \uB0B4 \uC790\uC138\uC5D0
      \uB300\uD574 \uCE6D\uCC2C\uC744 \uD574\uC8FC\uC168\uB2E4.\""
    - "\"\uC758\uC0AC \uC120\uC0DD\uB2D8\uAED8 \uC591\uD574\uB97C \uAD6C\uD558\uACE0,
      \uBE44\uB300\uBA74 \uC9C4\uB8CC \uBC0F \uC0C1\uB2F4\uC73C\uB85C \uC804\uD658\uC744
      \uD588\uB2E4. \uC9C1\uC811 \uC774\uB3D9\uD558\uC9C0 \uC54A\uC544\uB3C4 \uB418\uB2C8
      \uBAB8\uC5D0\uB3C4 \uBD80\uB2F4\uC774 \uB35C\uD55C \uAC83 \uAC19\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uC694\uC998 \uB4E4\uC5B4 \uB9C8\uC74C\uC774 \uC2F1\uC22D\uC0DD\uC22D\uD558\uACE0
      \uBD88\uC548\uAC10\uC774 \uCEE4\uC84C\uB2E4."
    choices:
    - "\uC804\uBB38 \uC0C1\uB2F4\uC0AC\uC5D0\uAC8C \uC0C1\uB2F4\uC744 \uC694\uCCAD\uD55C\uB2E4."
    - "\uB0A8\uD3B8\uACFC\uC758 \uB300\uD654\uB85C \uD480\uC5B4\uBCF8\uB2E4."
    - "\uC790\uC5F0\uC2A4\uB7EC\uC6B4 \uD604\uC0C1\uC77C \uAC83\uC774\uB2E4. \uCC38\uACE0
      \uBC84\uD168\uBCF4\uC790."
    results:
    - "\uC804\uBB38\uAC00\uC758 \uB3C4\uC6C0\uC744 \uBC1B\uC73C\uB2C8 \uD55C\uACB0
      \uB098\uC544\uC84C\uB2E4. \uC0C1\uB2F4\uC0AC\uB2D8\uAED8\uC11C\uB294 \uC784\uC2E0
      \uC911 \uD638\uB974\uBAAC \uBCC0\uD654\uB85C \uC778\uD574 \uAC10\uC815 \uAE30\uBCF5\uC774
      \uC2EC\uD574\uC9C8 \uC218 \uC788\uB2E4\uACE0 \uD558\uC168\uB2E4."
    - "\uB0A8\uD3B8\uACFC \uC194\uC9C1\uD55C \uB300\uD654\uB97C \uB098\uB204\uACE0
      \uB098\uB2C8 \uC11C\uB85C\uB97C \uB354 \uAE4A\uAC8C \uC774\uD574\uD560 \uC218
      \uC788\uB294 \uC2DC\uAC04\uC744 \uAC00\uC9C4 \uAC83 \uAC19\uC544 \uD3B8\uC548\uD574\uC84C\uB2E4."
    - "\uB2E4\uB978 \uC77C\uC744 \uD558\uBA70 \uC78A\uC5B4\uBC84\uB9AC\uB824 \uB178\uB825\uD588\uB2E4.
      \uCD5C\uADFC \uC5B4\uC9F8\uC120\uC9C0 \uBD80\uCA4D \uC6B0\uC6B8\uD574\uC9C4
      \uAE30\uBD84\uC774 \uB4E0\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC9C0\uC5ED \uBCF4\uAC74\uC18C\uC5D0\uC11C \uD558\uB294 \uC784\uC0B0\uBD80
      \uAD50\uC721 \uD504\uB85C\uADF8\uB7A8\uC774 \uC788\uB2E4\uB294 \uC18C\uC2DD\uC744
      \uB4E4\uC5C8\uB2E4."
    choices:
    - "\uB300\uBA74 \uD504\uB85C\uADF8\uB7A8\uC5D0 \uC815\uAE30\uC801\uC73C\uB85C
      \uCC38\uC11D\uD55C\uB2E4."
    - "\uBE44\uB300\uBA74 \uBB34\uB8CC \uAC15\uC758\uB85C \uC694\uC810\uB9CC \uD655\uC778\uD55C\uB2E4."
    - "\uCEE8\uB514\uC158\uB3C4 \uC88B\uC9C0 \uC54A\uC544 \uB2E4\uC74C \uAE30\uD68C\uC5D0
      \uAD50\uC721\uC744 \uB4E3\uAE30\uB85C \uD55C\uB2E4."
    results:
    - "\"\uC784\uC2E0, \uCD9C\uC0B0, \uC721\uC544 \uB4F1\uC5D0 \uB300\uD574 \uB2E4\uC591\uD55C
      \uAD50\uC721\uC744 \uBC1B\uACE0, \uC0B0\uBAA8\uB4E4\uB07C\uB9AC \uB9CE\uC740
      \uC18C\uD1B5\uC744 \uD588\uB2E4.  \uC774\uC81C \uBB50\uB4E0 \uD574\uB0BC \uC218
      \uC788\uC744 \uAC83\uB9CC \uAC19\uC740 \uC790\uC2E0\uAC10\uC774 \uC19F\uAD6C\uCE5C\uB2E4.\""
    - "\uAF2D \uC2DC\uAC04\uC744 \uB530\uB85C \uB0B4\uC5B4 \uAD50\uC721\uC744 \uBC1B\uC73C\uB7EC
      \uC774\uB3D9\uD558\uC9C0 \uC54A\uC544\uB3C4 \uB418\uB2C8 \uD3B8\uD558\uB2E4.
      \uAD81\uAE08\uD55C \uC810\uC774 \uC0DD\uACBC\uB294\uB370 \uD655\uC2E4\uD788
      \uB300\uBA74 \uAD50\uC721\uC5D0 \uBE44\uD574\uC11C\uB294 \uC9C8\uC758\uC751\uB2F5\uC774
      \uC5B4\uB824\uC6B4 \uAC83 \uAC19\uB2E4."
    - "\"\uBAB8\uB3C4 \uD53C\uACE4\uD558\uB2C8 \uAD50\uC721\uC744 \uB530\uB85C \uBC1B\uC9C0
      \uC54A\uC558\uB2E4. \uD558\uC9C0\uB9CC, \uB3C4\uC6C0\uB418\uB294 \uB9CE\uC740
      \uC815\uBCF4\uB97C \uB193\uCE5C \uAC83\uC774 \uC870\uAE08\uC740 \uD6C4\uD68C\uAC00
      \uB41C\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uB0A8\uD3B8\uC774 \uC57C\uADFC\uC744 \uC9C0\uC18D\uD574\uB3C4 \uB420\uC9C0
      \uB098\uC640 \uB17C\uC758\uD558\uC790\uACE0 \uD55C\uB2E4."
    choices:
    - "\uC218\uC785\uC740 \uC904\uC5B4\uB4E4\uB354\uB77C\uB3C4 \uC870\uAE30 \uD1F4\uADFC\uD558\uB294
      \uAC83\uC73C\uB85C \uACB0\uC815\uD55C\uB2E4."
    - "\uD0DC\uC5B4\uB0A0 \uC544\uAE30\uB97C \uC704\uD574\uC11C\uB77C\uB3C4 \uC77C\uB2E8
      \uACC4\uC18D \uC57C\uADFC\uD558\uBA70 \uC5EC\uC720 \uC790\uAE08\uC744 \uB9C8\uB828\uD55C\uB2E4."
    - "\"\uC57C\uADFC\uC740 \uCD5C\uC18C\uD654\uD558\uB418, \uAC00\uC871\uACFC\uC758
      \uC2DC\uAC04\uACFC \uACBD\uC81C\uC801 \uC5EC\uC720\uB97C \uADE0\uD615 \uC788\uAC8C
      \uB9DE\uCD98\uB2E4.\""
    results:
    - "\"\uB0A8\uD3B8\uACFC \uBCF4\uB0B4\uB294 \uC2DC\uAC04\uC774 \uB298\uC5B4\uB098\uC11C
      \uB9C8\uC74C\uC774 \uD3B8\uD574\uC84C\uB2E4. \uB2F9\uC7A5\uC758 \uC218\uC785\uC740
      \uC880 \uC904\uACA0\uC9C0\uB9CC, \uAC00\uC815\uC774 \uD654\uBAA9\uD558\uB2C8
      \uB354 \uC88B\uB2E4.\""
    - "\uB0A8\uD3B8 \uACE0\uC0DD\uD558\uB294 \uB355\uBD84\uC5D0 \uACBD\uC81C\uC801\uC778
      \uBD80\uB2F4\uC744 \uB35C\uAC8C \uB418\uC5C8\uB2E4. \uD558\uC9C0\uB9CC \uC694\uC998
      \uB0A8\uD3B8\uC774 \uB9CE\uC774 \uD53C\uACE4\uD574 \uBCF4\uC5EC\uC11C \uAC19\uC774
      \uC2DC\uAC04\uC744 \uBCF4\uB0B4\uAE30 \uD798\uB4E4\uB2E4."
    - "\uB0A8\uD3B8\uC774 \uD68C\uC0AC\uC5D0 \uC591\uD574\uB97C \uAD6C\uD574 \uC57C\uADFC
      \uD69F\uC218\uB97C \uC870\uAE08 \uC904\uC774\uAE30\uB85C \uD558\uC600\uB2E4.
      \uAC00\uACC4\uC640 \uB9C8\uC74C\uC758 \uC548\uC815\uC744 \uB3D9\uC2DC\uC5D0
      \uCDE8\uD560 \uC218 \uC788\uB2E4\uB2C8!"
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
