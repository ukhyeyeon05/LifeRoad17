%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2de8e05f04ca588419838d933500abaa, type: 3}
  m_Name: story_puz4_StorySet
  m_EditorClassIdentifier: 
  stories:
  - question: "\"\uB098\uB294 \uC778\uAD6C 100\uC5EC \uBA85\uC758 \uC791\uC740 \uC12C\uC5D0\uC11C
      \uC0B4\uACE0 \uC788\uB294 \uC911\uD559\uC0DD\uC774\uB2E4. \uC9C0\uB09C \uACA8\uC6B8,
      \uD1B5\uC2E0\uB9DD\uC774 \uB04A\uACA8\uBC84\uB824 \uC6D0\uD65C\uD55C \uD559\uC2B5
      \uD658\uACBD\uC744 \uB204\uB9B4 \uC218 \uC5C6\uC5C8\uB2E4. \uC9C0\uB09C \uACA8\uC6B8\uC5D0
      \uB09C \uBB58 \uD558\uBA74\uC11C \uC9C0\uB0C8\uC744\uAE4C?\""
    choices:
    - "\uB9E4\uC77C \uC77C\uAE30\uB97C \uC4F0\uACE0 \uCC45\uC744 \uC77D\uC73C\uBA70
      \uC790\uAE30\uC8FC\uB3C4\uD559\uC2B5 \uC2B5\uAD00\uC744 \uAE38\uB800\uB2E4."
    - "\uB9C8\uC744\uD68C\uAD00\uC5D0\uC11C \uB274\uC2A4\uC640 \uB4DC\uB77C\uB9C8\uB97C
      \uBCF4\uBA70 \uC9C0\uB0C8\uB2E4."
    - "\uC544\uBC84\uC9C0 \uC5B4\uC5C5 \uC77C\uC744 \uB3C4\uC6B0\uBA70 \uAC00\uC871
      \uC0DD\uACC4\uC5D0 \uBCF4\uD0EC\uC774 \uB418\uC5C8\uB2E4."
    results:
    - "\uB9E4\uC77C \uC77D\uC740 \uCC45\uC758 \uAC10\uC0C1\uC774\uB098 \uBC30\uC6B4
      \uC810\uC744 \uAF3C\uAF3C\uD788 \uC77C\uAE30\uC5D0 \uAE30\uB85D\uD558\uB2C8
      \uC790\uAE30\uC8FC\uB3C4\uC801\uC778 \uC2B5\uAD00\uC774 \uC798 \uC7A1\uD600\uB098\uAC00\uAC8C
      \uB418\uC5C8\uB2E4."
    - "\"\uB9C8\uC744 \uC5B4\uB974\uC2E0\uB4E4\uACFC \uC2DC\uC0AC \uC774\uC288\uC5D0
      \uB300\uD574 \uC598\uAE30\uD558\uAE30\uB3C4 \uD558\uACE0, \uB4DC\uB77C\uB9C8\uB97C
      \uBCF4\uBA70 \uC990\uAC70\uC6B4 \uC2DC\uAC04\uC744 \uBCF4\uB0B4\uAE30\uB3C4
      \uD588\uB2E4. \uBB38\uD574\uB825\uC774\uB098 \uC0C1\uC2DD\uC740 \uB298\uC5C8\uC9C0\uB9CC
      \uC8FC\uC694 \uACFC\uBAA9\uC758 \uAE30\uCD08 \uAC1C\uB150\uC740 \uC870\uAE08
      \uBD80\uC871\uD55C \uC0C1\uD0DC\uB2E4.\""
    - "\"\uC0DD\uC5C5\uC744 \uD558\uBA70 \uAC00\uC871\uC758 \uC18C\uC911\uD568\uACFC
      \uCC45\uC784\uAC10\uC744 \uBC30\uC6E0\uC9C0\uB9CC, \uD559\uC5C5\uC5D0 \uC3DF\uC744
      \uC2DC\uAC04\uC774 \uBD80\uC871\uD574 \uC131\uC801\uC774 \uB9CE\uC774 \uB5A8\uC5B4\uC9C0\uAC8C
      \uB418\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\"\uC6B0\uB9AC \uD559\uAD50\uC5D0 \uB2E8 \uD55C \uBA85\uBFD0\uC774\uB358
      \uC120\uC0DD\uB2D8\uAED8\uC11C \uC721\uC9C0\uB85C \uC804\uADFC\uC744 \uAC00\uC168\uB2E4.
      \uB300\uCCB4 \uC120\uC0DD\uB2D8\uC740 \uB2F9\uBD84\uAC04 \uBABB \uC624\uC2DC\uACE0,
      \uD559\uAD50\uB3C4 \uD55C\uB3D9\uC548 \uC790\uC728 \uD559\uC2B5 \uC704\uC8FC\uB85C
      \uBC14\uB014 \uC608\uC815\uC774\uB2E4.\""
    choices:
    - "\uC778\uD130\uB137 \uAC15\uC758 \uD504\uB9AC\uD328\uC2A4\uB97C \uACB0\uC81C\uD55C\uB2E4."
    - "\uAC00\uC7A5 \uD544\uC694\uD55C \uD55C \uACFC\uBAA9\uB9CC \uC120\uD0DD\uD574\uC11C
      \uACB0\uC81C\uD55C\uB2E4."
    - "\uAE30\uC874 \uC218\uC5C5 \uC790\uB8CC\uB85C \uD63C\uC790 \uACF5\uBD80\uD55C\uB2E4."
    results:
    - "\uC790\uC728 \uD559\uC2B5 \uC0C1\uD669\uC5D0\uC11C \uC9D1\uC911\uC774 \uC5B4\uB835\uC9C0\uB9CC
      \uC778\uD130\uB137 \uAC15\uC758\uB85C \uC5B4\uB290 \uC815\uB3C4 \uCEE4\uBC84
      \uAC00\uB2A5\uD588\uB2E4."
    - "\uC790\uC728\uC131\uC774 \uB192\uC544\uC84C\uC9C0\uB9CC \uAFB8\uC900\uD55C
      \uD559\uC2B5 \uC2B5\uAD00\uC774 \uC5C6\uC73C\uBA74 \uD6A8\uACFC\uAC00 \uB5A8\uC5B4\uC838
      \uB9CE\uC774 \uD798\uB4E4\uC5C8\uB2E4."
    - "\"\uC790\uAE30 \uC8FC\uB3C4\uC801\uC73C\uB85C \uD559\uC2B5\uD560 \uC218 \uC788\uC5C8\uC9C0\uB9CC,
      \uD55C\uACC4\uB3C4 \uBA85\uD655\uD574 \uD6A8\uACFC\uAC00 \uB9CE\uC774 \uB5A8\uC5B4\uC84C\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uC5B4\uC5C5\uC744 \uB098\uAC00\uC154\uC57C \uD558\uB294 \uC544\uBC84\uC9C0\uC758
      \uBC30\uAC00 \uACE0\uC7A5\uB098 \uD55C\uB3D9\uC548 \uC0DD\uACC4\uAC00 \uB9C9\uB9C9\uD574\uC84C\uB2E4."
    choices:
    - "\uC544\uBC84\uC9C0\uB97C \uB3C4\uC6B0\uBA70 \uC77C\uC744 \uBC30\uC6B0\uACE0
      \uC0DD\uACC4\uC5D0 \uBCF4\uD0F0\uB2E4."
    - "\"\uC544\uBC84\uC9C0\uC758 \uC77C\uC190\uC744 \uB3D5\uACE0, \uC2DC\uAC04\uC744
      \uCABC\uAC1C \uACF5\uBD80\uB97C \uD55C\uB2E4.\""
    - "\"\uACF5\uBD80\uC5D0 \uC9D1\uC911\uD558\uACE0, \uC77C\uC190\uC740 \uB2E4\uC74C\uC5D0
      \uB3D5\uB294\uB2E4.\""
    results:
    - "\"\uACF5\uBD80 \uC2DC\uAC04\uC744 \uC904\uC774\uACE0 \uC0DD\uACC4\uC5D0 \uBCF4\uD0EC\uC774
      \uB418\uC5C8\uC9C0\uB9CC, \uCCB4\uB825\uC801 \uBD80\uB2F4\uC774 \uCEF8\uB2E4.\""
    - "\uB2A6\uC740 \uBC24\uC5D0 \uACF5\uBD80\uD558\uBA70 \uB0AE\uC5D4 \uC77C\uD558\uB294
      \uC77C\uC815\uC73C\uB85C \uD53C\uB85C\uAC00 \uB9CE\uC774 \uB204\uC801\uB418\uC5C8\uB2E4."
    - "\"\uD559\uC5C5 \uC131\uC801\uC774 \uB9CE\uC774 \uD5A5\uC0C1\uB418\uC5C8\uC9C0\uB9CC,
      \uC5EC\uC804\uD788 \uC0DD\uACC4\uB294 \uC5B4\uB824\uC6B4 \uC0C1\uD0DC\uB77C
      \uAC71\uC815\uC774 \uB9CE\uC774 \uB41C\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\"\uC815\uBD80 \uC9C0\uC6D0\uAE08\uC774 \uB098\uC654\uB2E4. \uD559\uC2B5
      \uC790\uB8CC\uB098 \uC0DD\uD65C\uBE44\uB85C\uB9CC \uC0AC\uC6A9\uD560 \uC218
      \uC788\uB294\uB370, \uC5B4\uB5BB\uAC8C \uD560\uAE4C?\""
    choices:
    - "\uC804\uBD80 \uC628\uB77C\uC778 \uAC15\uC758\uC640 \uCC45 \uAD6C\uB9E4\uC5D0
      \uC4F4\uB2E4."
    - "\"\uBC18\uC740 \uC0DD\uD65C\uBE44, \uBC18\uC740 \uAD50\uC7AC\uC5D0 \uC4F4\uB2E4.\""
    - "\uC804\uBD80 \uC800\uCD95\uD558\uACE0 \uAE30\uC874 \uC790\uB8CC\uB97C \uD65C\uC6A9\uD55C\uB2E4."
    results:
    - "\uD559\uC2B5\uC5D0 \uD544\uC694\uD55C \uB3C4\uAD6C\uB97C \uB300\uBD80\uBD84
      \uD655\uBCF4\uD588\uC9C0\uB9CC \uC0DD\uD65C\uBE44 \uBD80\uB2F4\uC774 \uCEE4\uC84C\uB2E4."
    - "\"\uACA8\uC6B0 \uADE0\uD615\uC744 \uC7A1\uC740 \uC9C0\uCD9C\uB85C \uB9CC\uC871\uC2A4\uB7FD\uC9C4
      \uC54A\uC9C0\uB9CC, \uC0DD\uACC4\uC640 \uD559\uC2B5\uC744 \uD568\uAED8 \uC720\uC9C0\uD560
      \uC218 \uC788\uC5C8\uB2E4.\""
    - "\"\uACBD\uC81C\uC801 \uC548\uC815\uC740 \uC720\uC9C0\uB410\uC9C0\uB9CC, \uD559\uC2B5
      \uC790\uB8CC \uBD80\uC871\uC73C\uB85C \uC9C4\uB3C4\uC5D0 \uC5B4\uB824\uC6C0\uC774
      \uC788\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uB4E3\uACE0 \uC788\uB294 \uC778\uD130\uB137 \uAC15\uC758\uAC00 \uBB34\uB8CC\uC5D0\uC11C
      \uC720\uB8CC\uB85C \uC804\uD658\uB410\uB2E4."
    choices:
    - "\uC778\uD130\uB137 \uAC15\uC758 \uD504\uB9AC\uD328\uC2A4\uB97C \uACB0\uC81C\uD55C\uB2E4."
    - "\uC800\uB834\uD55C \uACFC\uBAA9 \uBA87 \uAC1C\uB9CC \uACE8\uB77C\uC11C \uC218\uAC15\uD55C\uB2E4."
    - "\uAD50\uACFC\uC11C\uC640 \uC788\uB294 \uC790\uB8CC\uB85C \uB3C5\uD559\uD55C\uB2E4."
    results:
    - "\uC591\uC9C8\uC758 \uAC15\uC758\uB97C \uBB34\uC81C\uD55C\uC73C\uB85C \uB4E3\uAC8C
      \uB418\uC5B4 \uACF5\uBD80 \uD6A8\uC728\uC774 \uC62C\uB77C\uAC14\uB2E4."
    - "\uC911\uC694\uD55C \uACFC\uBAA9\uB9CC \uC218\uAC15 \uAC00\uB2A5\uD574 \uD6A8\uC728\uC740
      \uC788\uC5C8\uC9C0\uB9CC \uBC94\uC704\uAC00 \uC81C\uD55C\uB410\uB2E4."
    - "\"\uC0C8 \uC790\uB8CC\uAC00 \uC5C6\uC5B4 \uC9C4\uB3C4\uAC00 \uB354\uB3A0\uACE0,
      \uACF5\uBD80 \uD765\uBBF8\uB3C4 \uB5A8\uC5B4\uC84C\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uBC29\uACFC \uD6C4\uC5D0 \uB0B4\uAC00 \uD558\uACE0 \uC2F6\uC740 \uD65C\uB3D9\uB4E4\uC744
      \uD558\uBA70 \uC2DC\uAC04\uC744 \uBCF4\uB0B4\uB824\uACE0 \uD55C\uB2E4."
    choices:
    - "\uB9C8\uC744\uD68C\uAD00\uC5D0\uC11C \uBD09\uC0AC\uD65C\uB3D9 \uD6C4 \uB9C8\uC744
      \uC5B4\uB974\uC2E0\uACFC \uC778\uD130\uBDF0\uD558\uBA70 \uAE30\uB85D\uC744
      \uB0A8\uAE34\uB2E4."
    - "\uC120\uC0DD\uB2D8\uAED8 \uBA58\uD1A0\uB9C1\uC744 \uC694\uCCAD\uD574 \uBC29\uACFC
      \uD6C4 \uC2DC\uAC04\uC744 \uCC44\uC6B4\uB2E4."
    - "\uADF8\uB0E5 \uC9D1\uC5D0\uC11C \uB180\uBA74\uC11C \uC270\uB2E4."
    results:
    - "\uACBD\uD5D8\uB3C4 \uC313\uACE0 \uC6A9\uB3C8\uB3C4 \uBC8C\uC5C8\uC9C0\uB9CC
      \uCCB4\uB825\uC801\uC73C\uB85C \uD798\uB4E4\uC5C8\uB2E4."
    - "\"\uB2E4\uC591\uD55C \uD559\uC2B5\uC744 \uD558\uBA70 \uC131\uC801\uC774 \uD5A5\uC0C1\uB418\uC5C8\uC9C0\uB9CC,
      \uBB38\uB4DD \uC0DD\uACC4\uB97C \uC704\uD55C \uD65C\uB3D9\uC744 \uD558\uC9C0
      \uBABB\uD55C \uAC83\uC5D0 \uB300\uD55C \uC544\uC26C\uC6C0\uC774 \uB0A8\uB294\uB2E4.\""
    - "\uD734\uC2DD\uC73C\uB85C \uCEE8\uB514\uC158\uC740 \uD68C\uBCF5\uB410\uC9C0\uB9CC
      \uD559\uC2B5\xB7\uACBD\uD5D8\uC774\uB098 \uC0DD\uACC4\uC5D0 \uB3C4\uC6C0\uC774
      \uB418\uB294 \uAE30\uD68C\uB294 \uB193\uCCE4\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uD0DD\uBC30\uC0AC \uC0AC\uC815\uC73C\uB85C \uD544\uC694\uD55C \uBB3C\uD488\uB4E4\uACFC
      \uAD50\uC7AC\uAC00 \uC81C \uB54C \uB3C4\uCC29\uD558\uAE30 \uC5B4\uB835\uB2E4\uACE0
      \uD55C\uB2E4."
    choices:
    - "\uC544\uBC84\uC9C0\uAED8 \uBD80\uD0C1\uB4DC\uB824\uC11C \uBC30\uB97C \uD0C0\uACE0
      \uAC00 \uC9C1\uC811 \uC218\uB839\uD55C\uB2E4."
    - "\uAC19\uC740 \uD559\uAD50 \uCE5C\uAD6C\uC5D0\uAC8C \uBE4C\uB9B0\uB2E4."
    - "\uC77C\uB2E8 \uC9D1\uC5D0 \uC788\uB294 \uAC83\uB4E4\uB85C \uBC84\uD2F4\uB2E4."
    results:
    - "\"\uC2DC\uAC04\uC744 \uB4E4\uC5EC \uD655\uBCF4\uD588\uC9C0\uB9CC \uC5D0\uB108\uC9C0\uAC00
      \uB9CE\uC774 \uB4E4\uC5C8\uACE0, \uADF8 \uC2DC\uAC04 \uB3D9\uC548 \uC544\uBC84\uC9C0\uAC00
      \uC5B4\uC5C5\uC744 \uD558\uC9C0 \uBABB\uD558\uC168\uB2E4.\""
    - "\uC77C\uC815 \uC9C0\uC5F0\uC740 \uC788\uC5C8\uC9C0\uB9CC \uCE5C\uAD6C \uB355\uBD84\uC5D0
      \uCD5C\uC545\uC740 \uBA74\uD558\uBA70 \uACF5\uBD80\uD560 \uC218 \uC788\uC5C8\uB2E4."
    - "\uD544\uC694\uD55C \uBB3C\uD488\uB4E4\uC774 \uC5C6\uC5B4\uC11C \uD55C\uB3D9\uC548
      \uACF5\uBD80\uD558\uB294 \uB370 \uB9CE\uC740 \uC5B4\uB824\uC6C0\uC744 \uACAA\uC5C8\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uD559\uC0DD \uACF5\uBAA8\uC804\uC744 \uD1B5\uD574 \uB610\uB2E4\uC2DC
      \uC815\uBD80 \uC9C0\uC6D0\uAE08\uC744 \uBC1B\uC744 \uC218 \uC788\uB294 \uAE30\uD68C\uAC00
      \uC654\uB2E4. \uD558\uC9C0\uB9CC \uD655\uC2E4\uD558\uAC8C \uACF5\uBAA8\uC804\uC744
      \uC900\uBE44\uD558\uB824\uBA74 \uC721\uC9C0\uC5D0 \uC5EC\uB7EC \uBC88 \uB2E4\uB140\uC640\uC57C
      \uD574\uC11C \uC9C0\uC6D0\uAE08\uC774 \uAC70\uC758 \uB0A8\uC9C0 \uC54A\uB294\uB2E4.
      \uC5B4\uB5BB\uAC8C \uD560\uAE4C?"
    choices:
    - "\uACF5\uBAA8\uC804\uC5D0 \uC2DC\uAC04\uC744 \uC3DF\uAE30 \uBCF4\uB2E4\uB294
      \uD559\uAD50 \uACF5\uBD80\uC5D0 \uC5F4\uC911\uD55C\uB2E4."
    - "\"\uC9C0\uC6D0\uAE08\uC744 \uD655\uC2E4\uD558\uAC8C \uBC1B\uC744 \uC218 \uC788\uC744\uC9C0\uB294
      \uBAA8\uB974\uACA0\uC9C0\uB9CC, \uC12C\uC5D0\uC11C\uB9CC \uC900\uBE44\uD55C\uB2E4.\""
    - "\uACBD\uD5D8\uC744 \uC313\uC744\uACB8 \uACF5\uBAA8\uC804 \uC900\uBE44\uC5D0
      \uC5F4\uC911\uD55C\uB2E4."
    results:
    - "\"\uBE44\uC6A9\uC801 \uBD80\uB2F4 \uC694\uC18C\uB294 \uC0AC\uB77C\uC84C\uC9C0\uB9CC,
      \uC5BB\uAE30 \uD798\uB4E0 \uAE30\uD68C\uB97C \uB193\uCCD0 \uC544\uC26C\uC6C0\uC774
      \uB9CE\uC774 \uB0A8\uC558\uB2E4.\""
    - "\"\uC12C\uC5D0\uC11C \uC900\uBE44\uD55C \uD55C\uACC4 \uB54C\uBB38\uC778\uC9C0
      \uC9C0\uC6D0\uAE08\uC740 \uBC1B\uC9C0 \uBABB\uD588\uC9C0\uB9CC, \uB2E4\uC591\uD55C
      \uACBD\uD5D8\uC744 \uC313\uC558\uB2E4.\""
    - "\"\uB2E4\uC591\uD55C \uD559\uC2B5 \uACBD\uD5D8\uC744 \uC313\uACE0, \uC6B4\uC774
      \uC88B\uAC8C \uC9C0\uC6D0\uAE08\uB3C4 \uBC1B\uC558\uC9C0\uB9CC, \uADF8\uB3D9\uC548
      \uB4E4\uC5B4\uAC04 \uBE44\uC6A9 \uB54C\uBB38\uC5D0 \uC0DD\uACC4\uB294 \uC5EC\uC804\uD788
      \uD30D\uD30D\uD558\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\"\uC721\uC9C0 \uD559\uAD50\uC640 \uC628\uB77C\uC778 \uAD50\uB958
      \uC218\uC5C5\uC744 \uD558\uAE30\uB85C \uD588\uB294\uB370, \uC778\uD130\uB137\uC774
      \uACE0\uC7A5\uB098\uBC84\uB838\uB2E4.\""
    choices:
    - "\uD734\uB300\uD3F0 \uC720\uB8CC \uB370\uC774\uD130\uB85C \uC811\uC18D\uC744
      \uC2DC\uB3C4\uD55C\uB2E4."
    - "\uC606 \uB9C8\uC744\uC5D0 \uC788\uB294 \uB9C8\uC744 \uD68C\uAD00\uC5D0 \uAC00\uC11C
      \uC640\uC774\uD30C\uC774\uB97C \uBE4C\uB824 \uC4F4\uB2E4."
    - "\uCE5C\uAD6C\uC5D0\uAC8C \uB179\uD654\uB97C \uBD80\uD0C1\uD55C \uD6C4 \uC790\uB8CC\uB97C
      \uB098\uC911\uC5D0 \uBC1B\uC544\uBCF8\uB2E4."
    results:
    - "\"\uAE34\uAE09 \uB300\uCC98\uB294 \uAC00\uB2A5\uD588\uC9C0\uB9CC, \uB370\uC774\uD130
      \uC694\uAE08 \uBD80\uB2F4\uC774 \uC0DD\uACBC\uB2E4.\""
    - "\uC774\uB3D9 \uC2DC\uAC04\uC740 \uB9CE\uC774 \uB4E4\uC9C0\uB9CC \uAE09\uD55C
      \uBB38\uC81C\uB294 \uD574\uACB0\uB418\uC5C8\uB2E4."
    - "\"\uC218\uC5C5 \uCC38\uC5EC\uB3C4\uAC00 \uB9CE\uC774 \uB5A8\uC5B4\uC9C0\uACE0,
      \uACF5\uBD80\uC5D0 \uD765\uBBF8\uAC00 \uC870\uAE08 \uB5A8\uC5B4\uC84C\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\"\uC5B4\uB835\uAC8C \uACF5\uBD80\uD558\uB2E4 \uBCF4\uB2C8 \uBB38\uB4DD,
      \uACF5\uBD80\uBCF4\uB2E4\uB294 \uC5B4\uC5C5\uC744 \uBB3C\uB824\uBC1B\uB294
      \uAC8C \uB354 \uB0AB\uC9C0 \uC54A\uC744\uAE4C\uB77C\uB294 \uC0DD\uAC01\uC744
      \uD558\uAC8C \uB418\uC5C8\uB2E4.\""
    choices:
    - "\uADF8\uB798\uB3C4 \uACF5\uBD80\uB97C \uACC4\uC18D \uC5F4\uC2EC\uD788 \uD55C\uB2E4."
    - "\"\uACF5\uBD80\uB97C \uC644\uC804\uD788 \uB193\uC9C4 \uC54A\uC9C0\uB9CC, \uC544\uBC84\uC9C0\uAED8
      \uC5B4\uC5C5\uC744 \uC870\uAE08\uC529 \uBC30\uC6CC\uB454\uB2E4.\""
    - "\uACF5\uBD80\uB294 \uD798\uB4DC\uB2C8\uAE4C \uC544\uC608 \uC5B4\uC5C5\uCABD\uC73C\uB85C
      \uC9C4\uB85C\uB97C \uC0BC\uB294\uB2E4."
    results:
    - "\"\uC131\uC801\uC740 \uC720\uC9C0\uB418\uC5C8\uC9C0\uB9CC, \uACBD\uC81C\uC801\uC778
      \uBD88\uC548\uAC10\uC740 \uC5EC\uC804\uD588\uB2E4.\""
    - "\"\uC0DD\uACC4\uC640 \uD559\uC5C5\uC744 \uBAA8\uB450 \uACE0\uB824\uD55C \uACB0\uC815\uC774\uC5C8\uC9C0\uB9CC,
      \uC560\uB9E4\uD558\uAC8C \uB458 \uBAA8\uB450\uB97C \uCC59\uAE30\uB824\uB294
      \uC695\uC2EC\uC778\uAC00\uD558\uB294 \uAC71\uC815\uC774 \uB4E4\uC5C8\uB2E4.\""
    - "\"\uC0DD\uACC4\uB97C \uACE0\uB824\uD55C \uC0C8\uB85C\uC6B4 \uBC29\uD5A5\uC744
      \uC7A1\uC558\uC9C0\uB9CC, \uC8FC\uBCC0\uC758 \uC6B0\uB824\uAC00 \uB9E4\uC6B0
      \uCEE4\uC84C\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
