  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2de8e05f04ca588419838d933500abaa, type: 3}
  m_Name: story_puz5_StorySet
  m_EditorClassIdentifier: 
  storyList:
  - question: "\"\uB098\uB294 OO\uC2DC\uC5D0 \uC0B4\uACE0 \uC788\uB294 \uB450 \uC544\uC774\uC758
      \uC5C4\uB9C8\uB2E4. 6\uB144 \uC804 \uB458\uC9F8\uB97C \uB0B3\uACE0 \uC5BC\uB9C8
      \uC548\uB3FC\uC11C \uC9C1\uC7A5\uC744 \uADF8\uB9CC \uB450\uC5C8\uACE0, \uC9C0\uAE08\uAE4C\uC9C0
      \uC721\uC544\uC640 \uC9D1\uC548\uC77C\uC744 \uB3C4\uB9E1\uACE0 \uC788\uB2E4.
      \uC774\uC81C \uB458\uC9F8\uB3C4 \uC5B4\uB290\uC815\uB3C4 \uCEF8\uACE0 \uC77C\uC744
      \uB2E4\uC2DC \uC2DC\uC791\uD558\uACE0 \uC2F6\uC740\uB370.. \uD63C\uC790 \uCDE8\uC5C5
      \uC900\uBE44\uB97C \uC2DC\uC791\uD558\uC790\uB2C8 \uC5C4\uB450\uAC00 \uB098\uC9C8
      \uC54A\uB294\uB2E4. \uC544\uC774\uB4E4\uC744 \uD0A4\uC6B0\uB294 \uC9C0\uB09C
      6\uB144 \uB3D9\uC548 \uD574\uC628 \uAC83\uC774 \uC788\uC744\uAE4C?\""
    choices:
    - "\uC544\uC774 \uB3CC\uBD04\uACFC \uC0B4\uB9BC\uC5D0\uB9CC \uC9D1\uC911\uD588\uB2E4."
    - "\"\uC628\uB77C\uC778 \uAC15\uC88C\uB97C \uC218\uAC15\uD558\uBA70, \uC790\uACA9\uC99D
      \uACF5\uBD80\uB97C \uC721\uC544\uC640 \uBCD1\uD589\uD588\uB2E4.\""
    - "\"\uC721\uC544\uB97C \uD558\uBA70 \uBE14\uB85C\uADF8, SNS\uB85C \uC77C\uC0C1\uC744
      \uAE30\uB85D\uD558\uBA70 \uBCF4\uB0C8\uB2E4.\""
    results:
    - "\"\uC774\uB825\uC11C\uB97C \uD3BC\uCCD0\uBCF4\uC790 \uC9C0\uB09C \uACF5\uBC31\uC774
      \uC120\uBA85\uD558\uAC8C \uB4DC\uB7EC\uB0AC\uACE0, \uAD6C\uC9C1\uC5D0 \uB300\uD55C
      \uC790\uC2E0\uAC10\uC774 \uB9CE\uC774 \uB5A8\uC5B4\uC838 \uAC14\uB2E4.\""
    - "\"\uCCB4\uB825\uC801\uC73C\uB85C \uB9CE\uC774 \uD798\uB4E4\uC5C8\uC9C0\uB9CC,
      \uC721\uC544 \uD2C8\uD2C8\uC774 \uC2A4\uB9C8\uD2B8\uD3F0\uC73C\uB85C \uAC15\uC758\uB97C
      \uB4E4\uC5C8\uC5C8\uB2E4. \uC544\uC9C1 \uACBD\uB825\uC758 \uACF5\uBC31\uC744
      \uC644\uC804\uD788 \uCC44\uC6B8 \uC21C \uC5C6\uC9C0\uB9CC, \uADF8\uB798\uB3C4
      \uBB50\uB77C\uB3C4 \uCC44\uC6CC\uC838 \uC788\uC73C\uB2C8 \uC870\uAE08\uC740
      \uC548\uC2EC\uB41C\uB2E4.\""
    - "\"\uC544\uAE30\uC758 \uC131\uC7A5\uC77C\uAE30, \uC0B4\uB9BC \uB178\uD558\uC6B0
      \uB4F1\uB4F1\uC744 \uAE30\uB85D\uD588\uACE0, \uC5B4\uB290 \uB0A0 \uD55C \uC721\uC544
      \uBE0C\uB79C\uB4DC\uC5D0\uC11C \uD611\uC5C5 \uC81C\uC548\uC744 \uBC1B\uC544
      \uACBD\uC81C\uC801\uC73C\uB85C \uB9CE\uC740 \uC9C0\uC6D0\uC744 \uBC1B\uAC8C
      \uB418\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uAD6C\uC9C1 \uC0AC\uC774\uD2B8\uC5D0 \uC774\uB825\uC11C\uB97C \uB4F1\uB85D\uD574\uC57C
      \uD55C\uB2E4."
    choices:
    - "\uC774\uB825\uC11C \uCEE8\uC124\uD305 \uC11C\uBE44\uC2A4\uB97C \uC774\uC6A9\uD55C\uB2E4."
    - "6\uB144 \uC804 \uC774\uB825\uC11C\uB97C \uADF8\uB300\uB85C \uC62C\uB780\uB2E4."
    - "\uC774\uB825\uC11C\uB97C \uD63C\uC790\uC11C \uC0C8\uB85C \uC791\uC131\uD55C\uB2E4."
    results:
    - "\"\uCEE8\uC124\uD134\uD2B8\uB97C \uB9CC\uB098 \uB2E4\uC2DC \uC774\uB825\uC11C\uB97C
      \uC791\uC131\uD574\uBCF4\uC558\uB2E4. \uD655\uC2E4\uD788 \uC804\uBB38\uAC00\uAC00
      \uC788\uC73C\uB2C8, \uBCC4 \uBCFC\uC77C \uC5C6\uC5B4 \uBCF4\uC774\uB294 \uB0B4
      \uC774\uB825\uC11C\uAC00 \uC870\uAE08\uC740 \uADF8\uB7F4\uC2F8\uD574 \uBCF4\uC774\uB294
      \uAC83 \uAC19\uB2E4.\""
    - "6\uB144 \uC804\uC5D0\uB294 \uADF8\uB798\uB3C4 \uC5EC\uB7EC \uACF3\uC5D0 \uC11C\uB958
      \uD569\uACA9\uC744 \uD55C \uC774\uB825\uC11C\uC774\uB2C8 \uBBFF\uACE0 \uADF8\uB300\uB85C
      \uC0AC\uC6A9\uD55C\uB2E4."
    - "\uC544\uC774\uB4E4\uC744 \uC7AC\uC6B0\uACE0 \uBC24\uB9C8\uB2E4 \uC774\uB825\uC11C\uB97C
      \uB2E4\uC2DC \uB2E4\uB4EC\uC5C8\uB2E4. \uCD5C\uC2E0 \uC591\uC2DD\uACFC \uCD94\uAC00\uB41C
      \uB0B4\uC6A9\uB4E4\uB3C4 \uC5C5\uB370\uC774\uD2B8 \uD558\uBA70 \uD53C\uACE4\uD55C
      \uD558\uB8E8\uD558\uB8E8\uB97C \uBCF4\uB0C8\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\"\uC774\uB825\uC11C\uB97C \uB354 \uBCF4\uAC15\uD558\uAE30 \uC704\uD574
      \uC790\uAE30\uACC4\uBC1C\uC744 \uD574\uC57C\uD560 \uAC83 \uAC19\uC740\uB370,
      \uC2DC\uAC04\uC774 \uB9CE\uC774 \uBD80\uC871\uD558\uB2E4.\""
    choices:
    - "\uADF8\uB798\uB3C4 \uD2C8\uD2C8\uC774 \uD559\uC6D0\uC744 \uB2E4\uB2C8\uBA70
      \uC790\uACA9\uC99D\uC744 \uCDE8\uB4DD\uD55C\uB2E4."
    - "\"\uC800\uB834\uD55C \uC628\uB77C\uC778 \uAC15\uC758\uB97C \uCC3E\uC544 \uC9D1\uC5D0\uC11C
      \uACF5\uBD80\uD558\uACE0, \uC790\uACA9\uC99D\uC744 \uCDE8\uB4DD\uD55C\uB2E4.\""
    - "\uC544\uC9C1\uC740 \uC721\uC544\uC640 \uC0B4\uB9BC\uC744 \uB0B4\uAC00 \uB3C4\uB9E1\uC544\uC57C\uD558\uBBC0\uB85C
      \uC790\uAE30\uACC4\uBC1C\uC740 \uB2E4\uC74C\uC5D0 \uD55C\uB2E4."
    results:
    - "\"\uAC00\uC871\uC758 \uB3C4\uC6C0 \uB355\uC5D0 \uC218\uC5C5\uC744 \uB4E4\uC744
      \uC218 \uC788\uC5C8\uACE0, \uC5B4\uB835\uAC8C \uC790\uACA9\uC99D\uB3C4 \uB544\uB2E4.
      \uD604\uC7A5\uC5D0 \uBC14\uB85C \uC801\uC6A9\uC740 \uC5B4\uB835\uC9C0\uB9CC
      \uBA74\uC811\uC5D0\uC11C \uD070 \uBB34\uAE30\uAC00 \uB418\uC5C8\uB2E4.\""
    - "\"\uACBD\uC81C\uC801 \uBD80\uB2F4\uC740 \uC801\uC5C8\uC9C0\uB9CC, \uD63C\uC790
      \uACF5\uBD80\uD558\uB294 \uB370 \uD55C\uACC4\uAC00 \uC788\uC5C8\uB2E4. \uADF8\uB798\uB3C4
      \uB178\uB825\uC758 \uD754\uC801\uC774 \uB0A8\uC544 \uC2A4\uC2A4\uB85C \uBFCC\uB4EF\uD588\uB2E4.\""
    - "\uC2DC\uAC04\uC774 \uC9C0\uB0A0\uC218\uB85D \u201C\uB098\uB9CC \uB4A4\uCC98\uC9C0\uACE0
      \uC788\uB294 \uAC74 \uC544\uB2D0\uAE4C\u201D\uB77C\uB294 \uBD88\uC548\uC774
      \uC313\uC600\uB2E4. \uB3D9\uC2DC\uC5D0 \uC8C4\uCC45\uAC10\uB3C4 \uCEE4\uC838\uAC14\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uB2E4\uD589\uD788 \uD55C \uAE30\uC5C5\uC5D0\uC11C \uBA74\uC811 \uC81C\uC758\uAC00
      \uC654\uB2E4. \uD558\uC9C0\uB9CC \uADF8 \uB0A0 \uC544\uC774\uB4E4 \uCF00\uC5B4\uB294
      \uB204\uAD6C\uC5D0\uAC8C \uB9E1\uACA8\uC57C \uD560\uAE4C?"
    choices:
    - "\uD558\uB8E8\uB3D9\uC548 \uC2DC\uD130\uB97C \uACE0\uC6A9\uD55C\uB2E4."
    - "\uBD80\uBAA8\uB2D8\uAED8 \uC5F0\uB77D\uD574 \uBD80\uD0C1\uB4DC\uB9B0\uB2E4."
    - "\uB3D9\uB124\uC5D0 \uC788\uB294 \uC544\uC774 \uB3CC\uBD04 \uC2DC\uC124\uC5D0
      \uB9E1\uAE34\uB2E4."
    results:
    - "\"\uC2DC\uD130\uBE44\uB294 \uC608\uC0C1\uBCF4\uB2E4 \uB192\uC558\uC9C0\uB9CC,
      \uBA74\uC811\uC5D0 \uC9D1\uC911\uD560 \uC218 \uC788\uC5B4 \uC88B\uC558\uB2E4.
      \uD558\uC9C0\uB9CC \uACBD\uC81C\uC801 \uBD80\uB2F4\uC774 \uD06C\uAC8C \uB290\uAEF4\uC84C\uB2E4.\""
    - "\"\uBD80\uBAA8\uB2D8\uB3C4 \uC77C\uC815\uC774 \uC788\uC5C8\uC9C0\uB9CC, \uBD80\uD0C1\uB4DC\uB824
      \uD574\uACB0\uB410\uB2E4. \uD558\uC9C0\uB9CC \uC758\uC874\uC5D0 \uB300\uD55C
      \uBBF8\uC548\uD568\uACFC \uBD80\uCC44\uAC10\uC774 \uB0A8\uC558\uB2E4.\""
    - "\uB0AF\uC120 \uD658\uACBD\uC5D0 \uC801\uC751 \uBABB\uD55C \uC544\uC774\uAC00
      \uC6B8\uC74C\uC744 \uD130\uB728\uB838\uB2E4. \uBA74\uC811 \uB0B4\uB0B4 \uB9C8\uC74C\uC774
      \uBD88\uD3B8\uD588\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uBA74\uC811\uC5D0\uC11C \uC721\uC544 \uAE30\uAC04 \uB3D9\uC548\uC758
      \uACF5\uBC31\uAE30\uC5D0 \uB300\uD574 \uC9C8\uBB38\uC774 \uB4E4\uC5B4\uC654\uB2E4."
    choices:
    - "\uC9C4\uC194\uD558\uAC8C \uB2F5\uBCC0\uD558\uBA70 \uAC00\uC0AC\uB178\uB3D9\uC5D0
      \uB300\uD55C \uAC00\uCE58\uB97C \uC124\uBA85\uD55C\uB2E4."
    - "\uB2F5\uBCC0\uC744 \uCD5C\uB300\uD55C \uD68C\uD53C\uD558\uB824 \uD574\uBCF8\uB2E4."
    - "\uBD88\uCF8C\uAC10\uC744 \uD45C\uD604\uD55C\uB2E4."
    results:
    - "\"\uBA74\uC811\uAD00 \uC77C\uBD80\uB294 \uACF5\uAC10\uD588\uACE0, \uB610 \uC77C\uBD80\uB294
      \uACE0\uAC1C\uB97C \uAC38\uC6C3\uAC70\uB838\uB2E4. \uD3C9\uAC00 \uACB0\uACFC\uB294
      \uC5C7\uAC08\uB838\uB2E4.\""
    - "\"\uB531\uD788 \uBD80\uC815\uC801\uC778 \uBC18\uC751\uC740 \uC5C6\uC5C8\uC9C0\uB9CC,
      \uC9C4\uC815\uC131\uB3C4 \uC804\uB2EC\uB418\uC9C0 \uC54A\uC740 \uB4EF\uD588\uB2E4.\""
    - "\"\uBD84\uC704\uAE30\uAC00 \uC2F8\uB298\uD574\uC84C\uB2E4. \uC774\uD6C4 \uCD94\uAC00
      \uC9C8\uBB38\uC740 \uC5C6\uC5C8\uACE0, \uACB0\uACFC\uB3C4 \uBD88\uD569\uACA9\uC774\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC8FC\uBCC0 \uC9C0\uC778\uC73C\uB85C \uBD80\uD130 \uC9C1\uC5C5\uD6C8\uB828
      \uAE30\uAD00\uC5D0\uC11C \uD6C8\uB828 \uBC1B\uC744 \uAC83\uC744 \uC81C\uC548\uBC1B\uC558\uB2E4."
    choices:
    - "\uAE30\uAD00\uC5D0\uC11C \uD6C8\uB828\uBC1B\uB294 \uAC83\uC744 \uC218\uB77D\uD55C\uB2E4."
    - "\uC77C\uB2E8 \uB300\uAE30 \uBA85\uB2E8\uC5D0\uB9CC \uB4F1\uB85D\uD55C\uB2E4."
    - "\uCC38\uC5EC\uD558\uC9C0 \uC54A\uB294\uB2E4."
    results:
    - "\"\uCC98\uC74C\uC5D4 \uB0AF\uC124\uACE0 \uC5B4\uB835\uC9C0\uB9CC, \uC810\uCC28
      \uC2E4\uB825\uC744 \uD0A4\uC6B0\uBA70 \uC7AC\uCDE8\uC5C5\uC5D0 \uD55C \uAC78\uC74C
      \uB2E4\uAC00\uAC14\uB2E4.\""
    - "\uB4F1\uB85D \uD6C4 \uC5F0\uB77D\uC774 \uC5C6\uC5B4 \uD750\uC9C0\uBD80\uC9C0
      \uC78A\uD614\uB2E4. \uBCF8\uC778\uB3C4 \uC758\uC9C0\uB97C \uB2E4\uC9C0\uC9C0
      \uBABB\uD588\uB2E4."
    - "\uC2DC\uAC04\uC774 \uC9C0\uB0A0\uC218\uB85D \u201C\uAD1C\uD788 \uC548 \uD588\uB098?\u201D
      \uD558\uB294 \uD6C4\uD68C\uAC00 \uCC3E\uC544\uC654\uB2E4. \uB2E4\uC2DC \uC2DC\uC791\uD558\uAE30\uAC00
      \uB354 \uC5B4\uB824\uC6CC\uC84C\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\"\uC9D1\uC548\uC77C\uC5D0 \uC2E0\uACBD\uC744 \uBABB\uC4F0\uB2E4\uBCF4\uB2C8
      \uB0A8\uD3B8\uACFC \uAC08\uB4F1\uC774 \uC0DD\uACBC\uB2E4. \uC544\uC774\uB4E4
      \uCF00\uC5B4\uC640 \uC9D1\uC548\uC77C\uC774 \uC81C\uB300\uB85C \uC774\uB8E8\uC5B4\uC9C0\uC9C0
      \uBABB\uD558\uACE0 \uC788\uC5B4, \uC81C\uB300\uB85C\uB41C \uB300\uD654\uAC00
      \uD544\uC694\uD55C \uAC83 \uAC19\uB2E4.\""
    choices:
    - "\uB0A8\uD3B8\uB3C4 \uBC14\uC05C\uAC78 \uC54C\uAE30\uC5D0 \uAFB9 \uCC38\uACE0
      \uC9D1\uC548\uC77C\uC5D0 \uC880 \uB354 \uC2E0\uACBD\uC4F0\uAE30\uB85C \uD55C\uB2E4."
    - "\uAC10\uC815\uC744 \uD138\uC5B4\uB193\uACE0 \uC9C4\uC194\uD55C \uB300\uD654\uB97C
      \uB098\uB204\uBA70 \uB0A8\uD3B8\uACFC \uC9D1\uC548\uC77C \uBD84\uB2F4\uC744
      \uD55C\uB2E4."
    - "\uAC00\uC0AC \uB3C4\uC6B0\uBBF8\uB97C \uCC44\uC6A9\uD55C\uB2E4."
    results:
    - "\"\uAC08\uB4F1\uC740 \uC904\uC5C8\uC9C0\uB9CC, \uB0B4\uBA74\uC758 \uC2A4\uD2B8\uB808\uC2A4\uB294
      \uC810\uC810 \uC313\uC600\uB2E4. \uACB0\uAD6D \uBAB8\uC0B4\uAE4C\uC9C0 \uC654\uB2E4.\""
    - "\"\uB300\uD654\uB294 \uCC98\uC74C\uC5D4 \uC5B4\uC0C9\uD588\uC9C0\uB9CC, \uC774\uD6C4
      \uAC00\uC0AC \uBD84\uB2F4\uD45C\uB97C \uD568\uAED8 \uB9CC\uB4E4\uBA70 \uBCC0\uD654\uAC00
      \uC2DC\uC791\uB410\uB2E4.\""
    - "\"\uACBD\uC81C\uC801 \uBD80\uB2F4\uC740 \uC788\uC5C8\uC9C0\uB9CC, \uC2A4\uD2B8\uB808\uC2A4\uB294
      \uB9CE\uC774 \uC904\uC5C8\uB2E4. \uC544\uC774\uB4E4\uACFC \uBCF4\uB0B4\uB294
      \uC2DC\uAC04\uB3C4 \uB298\uC5B4\uB0AC\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\"\uC544\uC774\uB97C \uC7AC\uC6B4 \uBC24, \uD63C\uC790 \uC549\uC544
      \uAC11\uC791\uC2A4\uB7EC\uC6B4 \uACF5\uD5C8\uAC10\uC774 \uBAB0\uB824\uC628\uB2E4.\""
    choices:
    - "\uC870\uC6A9\uD788 \uC6B8\uB2E4\uAC00 \uD63C\uC790 \uB2E4\uC774\uC5B4\uB9AC\uB97C
      \uC4F0\uBA70 \uB9C8\uC74C\uC744 \uC815\uB9AC\uD55C\uB2E4."
    - "\uC778\uD130\uB137\uC5D0\uC11C \uC815\uC2E0\uAC74\uAC15 \uC0C1\uB2F4\uC5D0
      \uB300\uD574 \uC54C\uC544\uBCF8\uB2E4."
    - "\uD55C\uB3D9\uC548 \uAD6C\uC9C1 \uD65C\uB3D9\uC744 \uC270\uB2E4."
    results:
    - "\uAC10\uC815\uC774 \uC815\uB3C8\uB418\uBA70 \uB2E4\uC74C\uB0A0\uC5D0 \uB300\uD55C
      \uC758\uC695\uC774 \uC870\uAE08 \uC0DD\uACBC\uB2E4. \uAE00\uC4F0\uAE30\uB294
      \uC2A4\uC2A4\uB85C\uB97C \uB3CC\uC544\uBCF4\uB294 \uD798\uC774 \uB418\uC5C8\uB2E4."
    - "\"\uBB34\uB8CC \uC0C1\uB2F4 \uD504\uB85C\uADF8\uB7A8\uC744 \uBC1C\uACAC\uD558\uACE0,
      \uC0C1\uB2F4\uC744 \uC608\uC57D\uD588\uB2E4. \uC77C\uC0C1\uC744 \uB418\uB3CC\uC544\uBCFC
      \uAE30\uD68C\uAC00 \uB418\uC5C8\uB2E4.\""
    - "\"\uBC29\uCE58\uB41C \uCC44 \uC2DC\uAC04\uC774 \uD758\uB800\uACE0, \uB2E4\uC2DC
      \uC77C\uC5B4\uC11C\uB294 \uB370 \uB354 \uD070 \uC5D0\uB108\uC9C0\uAC00 \uD544\uC694\uD588\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uC9C0\uC778 \uCD94\uCC9C\uC73C\uB85C \uD55C \uC911\uC18C\uAE30\uC5C5\uC5D0
      \uACC4\uC57D\uC9C1\uC73C\uB85C \uC785\uC0AC\uD560 \uC218 \uC788\uB294 \uAE30\uD68C\uAC00
      \uB4E4\uC5B4\uC654\uB2E4."
    choices:
    - "\uBC14\uB85C \uC2DC\uC791\uD558\uBA70 \uC2E4\uBB34 \uC801\uC751\uC5D0 \uC9D1\uC911\uD55C\uB2E4."
    - "\uBC18\uB098\uC808 \uB2E8\uAE30\uADFC\uBB34\uB85C \uD611\uC758\uD574 \uC77C\uC744
      \uC2DC\uC791\uD55C\uB2E4."
    - "\uB354 \uB098\uC740 \uAE30\uD68C\uB97C \uAE30\uB2E4\uB9AC\uAE30\uB85C \uD558\uACE0
      \uAC70\uC808\uD55C\uB2E4."
    results:
    - "\"\uBE60\uB974\uAC8C \uC5C5\uBB34\uC5D0 \uC775\uC219\uD574\uC84C\uACE0, \uC790\uC2E0\uAC10\uB3C4
      \uC0DD\uACBC\uB2E4. \uD558\uC9C0\uB9CC \uCCB4\uB825\uC740 \uD55C\uACC4\uC600\uB2E4.\""
    - "\uCCB4\uB825\uC740 \uC720\uC9C0\uD560 \uC218 \uC788\uC5C8\uC9C0\uB9CC \uC218\uC785\uC774
      \uC801\uC5C8\uB2E4. \uC77C\uACFC \uC0DD\uD65C\uC758 \uADE0\uD615\uC740 \uC870\uAE08
      \uB354 \uC548\uC815\uB410\uB2E4."
    - "\"\uC9C0\uC6D0\uC11C\uB97C \uB123\uC5C8\uC9C0\uB9CC \uACB0\uACFC\uB294 \uC5C6\uC5C8\uACE0,
      \uBA87 \uC8FC\uAC04\uC758 \uBB34\uC9C1 \uAE30\uAC04\uC774 \uC774\uC5B4\uC84C\uB2E4.
      \uD310\uB2E8\uC774 \uB9DE\uC558\uB294\uC9C0\uB294 \uBAA8\uB974\uACA0\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\"6\uAC1C\uC6D4 \uB3D9\uC548 \uC721\uC544\uC640 \uC0B4\uB9BC, \uC77C\uC744
      \uBCD1\uD589\uD558\uBA70 \uD798\uB4E4\uAC8C \uBC84\uD168\uC654\uB2E4. \uBCF4\uB78C\uC740
      \uC788\uC5C8\uC9C0\uB9CC, \uBAB8\uC740 \uB108\uBB34 \uD53C\uB85C\uD574\uC9C4
      \uC0C1\uD0DC\uB2E4. \uADF8\uB7EC\uB358 \uC640\uC911 \uC815\uADDC\uC9C1 \uC804\uD658
      \uC81C\uC758\uAC00 \uB4E4\uC5B4\uC654\uB2E4. \uC5B4\uB5BB\uAC8C \uD574\uC57C\uD560\uAE4C?\""
    choices:
    - "\uC548\uC815\uC801\uC778 \uC9C1\uC7A5\uC0DD\uD65C\uC744 \uC704\uD574 \uC815\uADDC\uC9C1
      \uC804\uD658\uC744 \uC218\uB77D\uD55C\uB2E4."
    - "\uACC4\uC57D\uC9C1\uC744 \uC5F0\uC7A5\uD558\uBA70 \uC0C1\uD669\uC744 \uC870\uAE08
      \uB354 \uC9C0\uCF1C\uBCF8\uB2E4."
    - "\uB098\uC758 \uAC74\uAC15\uACFC \uC721\uC544\uC640 \uC0B4\uB9BC\uC758 \uC6B0\uC120\uC21C\uC704\uB97C
      \uACE0\uB824\uD574 \uC77C\uC744 \uADF8\uB9CC\uB454\uB2E4."
    results:
    - "\"\uBCF4\uB78C\uC740 \uC788\uC5C8\uC9C0\uB9CC, \uC721\uC544\uC640 \uC0B4\uB9BC\uC744
      \uBCD1\uD589\uD558\uAE30\uC5D4 \uB108\uBB34 \uBC85\uCC3C\uB2E4. \uC77C\uACFC
      \uAC00\uC815 \uC0AC\uC774\uC5D0\uC11C \uB298 \uC591\uBCF4\uAC00 \uD544\uC694\uD588\uB2E4.\""
    - "\"\uC815\uADDC\uC9C1\uC740 \uBD88\uC548\uD588\uC9C0\uB9CC, \uC720\uC5F0\uD55C
      \uADFC\uBB34\uB85C \uC77C\uC0C1\uC740 \uC720\uC9C0\uB410\uB2E4. \uC2DC\uAC04\uC740
      \uBC8C\uC5C8\uC9C0\uB9CC, \uBD88\uC548\uB3C4 \uC5EC\uC804\uD588\uB2E4.\""
    - "\"\uB9CE\uC740 \uACE0\uBBFC \uB05D\uC5D0 \uB0B4\uB9B0 \uACB0\uC815\uC774\uC5C8\uB2E4.
      \uC8C4\uCC45\uAC10\uB3C4 \uC788\uC5C8\uC9C0\uB9CC, \uC9C0\uAE08 \uC774 \uC120\uD0DD\uC774
      \uC544\uC774\uB4E4\uACFC \uB098\uC5D0\uAC90 \uB354 \uB9DE\uB2E4\uACE0 \uBBFF\uB294\uB2E4.\""
