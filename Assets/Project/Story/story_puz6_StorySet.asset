        value: -1
  - question: "\uD55C\uD30C\uB85C \uC218\uB3C4\uAD00\uC774 \uC5BC\uC5B4\uC11C \uBB3C\uC774
      \uB098\uC624\uC9C0 \uC54A\uB294\uB2E4."
    choices:
    - "\uC628\uC218\uB85C \uD574\uB3D9\uC744 \uC2DC\uB3C4\uD55C\uB2E4."
    - "\uC804\uBB38\uAC00\uB97C \uBD88\uB7EC \uC218\uB9AC\uD55C\uB2E4."
    - "\uB0A0\uC528\uAC00 \uC870\uAE08 \uD480\uB9B4 \uB54C\uAE4C\uC9C0 \uC0DD\uC218\uB97C
      \uC0AC\uC11C \uC0AC\uC6A9\uD55C\uB2E4."
    results:
    - "\"\uCD08\uBC18\uC5D4 \uBB3C\uC774 \uB098\uC624\uB294 \uB4EF\uD588\uC9C0\uB9CC,
      \uAE09\uC18D \uD574\uB3D9\uC73C\uB85C \uD30C\uC5F4\uC774 \uC0DD\uACA8 \uBB3C\uB09C\uB9AC\uB97C
      \uACAA\uAC8C \uB418\uC5C8\uB2E4.\""
    - "\"\uBE44\uC6A9\uC774 \uB9CE\uC774 \uB4E4\uC5C8\uC9C0\uB9CC, \uBE60\uB974\uAC8C
      \uBCF5\uAD6C\uB418\uC5C8\uACE0 \uB09C\uBC29 \uBC0F \uBCF4\uC628 \uC870\uCE58\uB97C
      \uD568\uAED8 \uBC1B\uC744 \uC218 \uC788\uC5C8\uB2E4.\""
    - "\"\uC0DD\uC218\uB85C\uB9CC \uC53B\uACE0 \uC124\uAC70\uC9C0\uAE4C\uC9C0 \uD558\uB824\uB2C8
      \uBB3C\uC774 \uB108\uBB34 \uBD80\uC871\uD588\uACE0, \uB9E4\uB144 \uACA8\uC6B8\uB9C8\uB2E4
      \uC0DD\uC218 \uAD6C\uB9E4\uC5D0 \uB9CE\uC740 \uB3C8\uC744 \uC0AC\uC6A9\uD558\uAC8C
      \uB418\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uD654\uC7A5\uC2E4 \uBB3C \uB0B4\uB9AC\uB294 \uB370\uC5D0 \uBB3C\uC774
      \uB108\uBB34 \uB9CE\uC774 \uC4F0\uC778\uB2E4. \uC808\uC218 \uBC29\uBC95\uC744
      \uACE0\uBBFC\uD574\uBD10\uC57C \uD560 \uAC83 \uAC19\uB2E4."
    choices:
    - "\uC808\uC218\uD615 \uBCC0\uAE30\uB85C \uAD50\uCCB4\uD55C\uB2E4."
    - "\uBCC0\uAE30 \uBB3C\uD0F1\uD06C\uC5D0 \uBCBD\uB3CC\uC744 \uB123\uC5B4 \uC218\uB7C9\uC744
      \uC904\uC778\uB2E4."
    - "\uADF8\uB0E5 \uC9C0\uAE08\uCC98\uB7FC \uC0AC\uC6A9\uD55C\uB2E4."
    results:
    - "\"\uBCC0\uAE30 \uAD50\uCCB4\uC5D0 \uB9CE\uC740 \uBE44\uC6A9\uC774 \uB4E4\uC5C8\uC9C0\uB9CC,
      \uC774\uD6C4\uC5D0\uB294 \uBB3C \uC0AC\uC6A9\uB7C9\uC774 \uB208\uC5D0 \uB744\uAC8C
      \uC904\uC5C8\uB2E4.\""
    - "\uAC04\uB2E8\uD55C \uC870\uCE58\uC600\uC9C0\uB9CC \uAF64 \uD6A8\uACFC \uC788\uB294
      \uBC29\uBC95\uC774\uC5C8\uB358 \uAC83 \uAC19\uB2E4."
    - "\"\uADF8\uB798\uB3C4 \uC0DD\uB9AC\uD604\uC0C1\uC5D0 \uAD00\uD55C\uAC74\uB370,
      \uC774 \uBD80\uBD84\uC740 \uC720\uC9C0\uD558\uAE30\uB85C \uD588\uB2E4. \uD558\uC9C0\uB9CC
      \uC5B4\uB514\uC11C \uB354 \uBB3C\uC744 \uC808\uC57D\uD574\uC57C\uD560\uC9C0\uB294
      \uB354 \uACE0\uBBFC\uD574\uBD10\uC57C \uD560 \uAC83 \uAC19\uB2E4.\""
