%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2de8e05f04ca588419838d933500abaa, type: 3}
  m_Name: story_puz6_StorySet
  m_EditorClassIdentifier: 
  stories:
  - question: "\"\uC6B0\uB9AC \uB3D9\uB124\uB294 \uC5BC\uB9C8 \uC804 \uADF9\uC2EC\uD55C
      \uAC00\uBB44\uC73C\uB85C \uAE30\uB85D\uC801\uC778 \uB2E8\uC218 \uC0AC\uD0DC\uB97C
      \uACAA\uC5C8\uB2E4. \uAE34\uAE09 \uAE09\uC218\uB97C \uD1B5\uD574 \uBC1B\uC740
      \uBB3C\uC744 \uC544\uB07C\uBA70 \uBA70\uCE60\uAC04 \uC5B4\uB835\uAC8C \uC0DD\uD65C\uD588\uC9C0\uB9CC,
      \uB3D9\uB124\uC758 \uC0C1\uC218\uB3C4\uAD00\uC774 \uB178\uD6C4\uB85C \uD30C\uC5F4\uB418\uC5C8\uB2E4\uB294
      \uC18C\uC2DD\uC744 \uB4E4\uC5C8\uB2E4. \uBB3C\uC774 \uAC70\uC758 \uB2E4 \uB5A8\uC5B4\uC838\uC11C
      \uC0C8\uB85C \uAD6C\uBE44\uD574\uC57C \uD558\uB294\uB370, \uC0DD\uC218 \uAC00\uACA9\uC740
      \uC810\uC810 \uC624\uB978\uB2E4. \uC5B4\uB5BB\uAC8C \uD574\uC57C\uD560\uAE4C?\""
    choices:
    - "\uB300\uD615 \uC0DD\uC218\uD1B5\uC744 \uB300\uB7C9 \uAD6C\uB9E4\uD574 \uBE44\uCD95\uD574
      \uB454\uB2E4."
    - "\uC18C\uD615 \uC0DD\uC218 \uBA87 \uBC15\uC2A4\uB9CC \uC0AC\uC11C \uC0C1\uD669\uC744
      \uC9C0\uCF1C \uBCF8\uB2E4."
    - "\"\uC9D1\uC5D0 \uAD6C\uBE44\uD574\uB454 \uBB3C\uACFC, \uC870\uAE08\uC740 \uB098\uC624\uB294
      \uC218\uB3D7\uBB3C\uB85C \uC808\uC57D\uD558\uBA70 \uBC84\uD2F4\uB2E4.\""
    results:
    - "\uD55C\uB3D9\uC548 \uC0DD\uC218 \uAC71\uC815 \uC5C6\uC774 \uBC84\uD2F8 \uC218
      \uC788\uC5C8\uB2E4. \uD558\uC9C0\uB9CC \uAC11\uC791\uC2A4\uB808 \uD070 \uC9C0\uCD9C\uC774
      \uC0DD\uAE34 \uD0D3\uC5D0 \uB2E4\uB978 \uBD80\uBD84\uB4E4\uC5D0\uC11C \uC0DD\uD65C\uBE44\uB97C
      \uB9CE\uC774 \uC544\uAEF4\uC57C \uD588\uB2E4."
    - "\"\uBA70\uCE60\uC740 \uAD1C\uCC2E\uC558\uC9C0\uB9CC, \uAC00\uBB44\uC774 \uAE38\uC5B4\uC9C0\uBA70
      \uB3D9\uB124 \uB9C8\uD2B8 \uC0DD\uC218\uB294 \uD488\uC808 \uC0C1\uD0DC\uAC00
      \uB418\uC5C8\uB2E4. \uACB0\uAD6D \uACE7 \uB2E4\uC2DC \uBB3C\uC744 \uAD6C\uD558\uB7EC
      \uB3CC\uC544\uB2E4\uB140\uC57C\uB9CC \uD588\uB2E4.\""
    - "\"\uAC00\uC7A5 \uC808\uC57D\uC801\uC778 \uC120\uD0DD\uC774\uC5C8\uB2E4. \uADF8\uB7EC\uB098,
      \uB9E4\uC77C \uBB3C\uC758 \uC0AC\uC6A9\uB7C9\uC744 \uACC4\uC0B0\uD558\uACE0,
      \uCD5C\uC18C\uD55C\uC73C\uB85C\uB9CC \uC0AC\uC6A9\uD558\uB2E4 \uBCF4\uB2C8
      \uD0C8\uC218 \uC99D\uC138\uAC00 \uC640 \uBCD1\uC6D0\uC5D0 \uAC00\uAC8C \uB418\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uAE09\uC218\uCC28\uAC00 \uC640\uC11C \uBB3C\uC744 \uB098\uB220\uC8FC\uACE0
      \uC788\uB2E4. \uD558\uC9C0\uB9CC \uBB3C\uC774 \uC218\uB3D7\uBB3C\uC774\uB098
      \uB0B4\uAC00 \uAD6C\uBE44\uD574\uB454 \uBB3C\uCC98\uB7FC \uAE68\uB057\uD558\uC9C0\uB294
      \uC54A\uC544 \uBCF4\uC778\uB2E4."
    choices:
    - "\uBC1B\uC544\uB454 \uBB3C\uC744 \uB053\uC774\uAC70\uB098 \uC815\uC218\uAE30
      \uD544\uD130\uB97C \uAD6C\uB9E4\uD558\uC5EC \uC2DD\uC218\uB85C \uC0AC\uC6A9\uD55C\uB2E4."
    - "\"\uC138\uCC99, \uC0E4\uC6CC \uC6A9\uB3C4\uB85C\uB9CC \uC0AC\uC6A9\uD55C\uB2E4.\""
    - "\uC704\uC0DD\uC774 \uAC71\uC815\uB418\uC5B4 \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uB294\uB2E4."
    results:
    - "\"\uAC00\uC2A4\uBE44\uAC00 \uB9CE\uC774 \uB098\uC624\uACE0 \uB9E4\uBC88 \uBB3C\uC744
      \uB053\uC774\uACE0 \uC2DD\uD788\uB294 \uBC88\uAC70\uB85C\uC6C0\uC774 \uC313\uC5EC\uAC14\uC9C0\uB9CC,
      \uD0C8 \uC5C6\uC774 \uBA70\uCE60\uC740 \uBC84\uD2F8 \uC218 \uC788\uC5C8\uB2E4.\""
    - "\"\uC2DD\uC218\uAC00 \uC880 \uBD80\uC871\uD558\uC5EC \uBD88\uD3B8\uD558\uACE0,
      \uC704\uC0DD \uAC71\uC815\uB3C4 \uC870\uAE08 \uB418\uC5C8\uC9C0\uB9CC \uC798
      \uBC84\uD2F8 \uC218 \uC788\uC5C8\uB2E4.\""
    - "\"\uBB3C\uC774 \uB9CE\uC774 \uBD80\uC871\uD574\uC9C0\uACE0, \uD6C4\uC5D0 \uBB3C\uC744
      \uBC1B\uC9C0 \uC54A\uC740 \uAC83\uC5D0 \uD6C4\uD68C\uB97C \uD558\uAC8C \uB418\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\"\uB354\uC6B4 \uC5EC\uB984, \uB3D9\uB124 \uD558\uCC9C \uC8FC\uBCC0\uC758
      \uD3D0\uC790\uC7AC\uB97C \uBAA8\uC544 \uC7AC\uD65C\uC6A9\uC13C\uD130\uC5D0
      \uAC00\uC838\uAC00\uBA74 \uD604\uAE08\uC73C\uB85C \uBCF4\uC0C1\uD574\uC900\uB2E4\uACE0
      \uD55C\uB2E4.\""
    choices:
    - "\uD558\uCC9C \uC8FC\uBCC0 \uD3D0\uC790\uC7AC\uC640 \uD568\uAED8 \uC9D1\uC548
      \uBB3C\uAC74\uAE4C\uC9C0 \uC815\uB9AC\uD574 \uAC00\uC838\uAC04\uB2E4."
    - "\uAC04\uB2E8\uD558\uAC8C \uC8FC\uBCC0 \uC0AC\uB78C\uB4E4\uACFC \uD558\uCC9C\uC758
      \uD3D0\uC790\uC7AC\uB97C \uBAA8\uC544 \uC81C\uCD9C\uD55C\uB2E4."
    - "\"\uADC0\uCC2E\uAE30\uB3C4 \uD558\uACE0, \uBC16\uC774 \uB108\uBB34 \uB354\uC6B0\uB2C8
      \uD3EC\uAE30\uD55C\uB2E4.\""
    results:
    - "\"\uD3D0\uC790\uC81C \uCC98\uB9AC\uB3C4 \uD558\uACE0 \uD604\uAE08 \uBCF4\uC0C1\uB3C4
      \uBC1B\uC544 \uC77C\uC11D\uC774\uC870\uC600\uC9C0\uB9CC, \uBB34\uAC70\uC6B4
      \uC9D0\uC744 \uC62E\uAE30\uB2E4 \uD5C8\uB9AC\uB97C \uC090\uB057\uD574\uC11C
      \uBCD1\uC6D0\uBE44\uB85C \uC77C\uBD80 \uBE60\uC838\uB098\uAC14\uB2E4.\""
    - "\uD070 \uB3C8\uC740 \uC544\uB2C8\uC9C0\uB9CC \uC0DD\uD544\uD488 \uC0B4 \uC815\uB3C4\uB294
      \uBC8C \uC218 \uC788\uC5C8\uB2E4. \uC624\uB79C\uB9CC\uC5D0 \uBC14\uB78C\uB3C4
      \uC42C\uACE0 \uAE30\uBD84\uC774 \uC0C1\uCF8C\uD588\uB2E4."
    - "\uADF8\uB300\uB85C \uB450\uC5C8\uB358 \uD3D0\uC790\uC7AC\uAC00 \uBE44\uC5D0
      \uC816\uC5B4 \uC545\uCDE8\uB97C \uB0B4\uACE0 \uBC8C\uB808\uAC00 \uC0DD\uAE30\uBA74\uC11C
      \uC774\uC6C3\uACFC \uAC08\uB4F1\uC774 \uC0DD\uACBC\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uB0A0\uC528\uAC00 \uB108\uBB34 \uB354\uC6CC\uC838 \uC2DD\uC218 \uC18C\uBE44\uAC00
      \uAE09\uC99D\uD55C\uB2E4."
    choices:
    - "\uBC1B\uC544\uB454 \uBB3C\uC744 \uB053\uC5EC \uC2DD\uC218\uB85C \uC0AC\uC6A9\uD55C\uB2E4."
    - "\uB9C8\uD2B8\uC5D0\uC11C \uC815\uC218 \uC0DD\uC218\uB97C \uAD6C\uC785\uD55C\uB2E4."
    - "\uC218\uB3D7\uBB3C\uC744 \uC815\uC218\uD558\uB294 \uB2E4\uD68C\uC6A9 \uD544\uD130\uB97C
      \uC0C8\uB85C \uAD6C\uB9E4\uD55C\uB2E4."
    results:
    - "\"\uB053\uC778 \uBB3C\uC774\uB77C \uADF8\uB7F0\uC9C0 \uB9DB\uC740 \uC870\uAE08
      \uBC0B\uBC0B\uD588\uC9C0\uB9CC, \uD0C8 \uC5C6\uC774 \uBA70\uCE60\uC744 \uBC84\uD2F8
      \uC218 \uC788\uC5C8\uB2E4. \uB2E4\uB9CC, \uB9E4\uBC88 \uBB3C\uC744 \uB053\uC774\uACE0
      \uC2DD\uD788\uB294 \uBC88\uAC70\uB85C\uC6C0\uC774 \uC313\uC5EC\uAC14\uB2E4.\""
    - "\"\uC2DC\uC6D0\uD55C \uBB3C\uC744 \uB9C8\uC2E4 \uC218 \uC788\uC5C8\uB2E4.
      \uADF8\uB7EC\uB098 \uB9E4\uBC88 \uB9C8\uD2B8\uAE4C\uC9C0 \uAC00\uB294 \uC2DC\uAC04\uACFC
      \uBB34\uAC8C, \uAC00\uACA9 \uBD80\uB2F4\uC740 \uC0DD\uAC01\uBCF4\uB2E4 \uCEF8\uB2E4.
      \uC5EC\uB984 \uD55C \uCCA0\uC5D0\uB9CC \uC0DD\uC218\uAC12\uC774 \uAF64 \uB098\uAC14\uB2E4.\""
    - "\"\uCC98\uC74C\uC5D4 \uD070 \uC9C0\uCD9C\uCC98\uB7FC \uB290\uAEF4\uC84C\uC9C0\uB9CC,
      \uC2DC\uAC04\uC774 \uAC08\uC218\uB85D \uBE44\uC6A9 \uB300\uBE44 \uB9CC\uC871\uB3C4\uAC00
      \uB192\uC558\uB2E4. \uD544\uD130 \uAD50\uCCB4 \uC8FC\uAE30\uB97C \uC798 \uAD00\uB9AC\uD574\uC57C
      \uD588\uACE0, \uCD08\uAE30\uC5D0 \uC124\uCE58\uD558\uB290\uB77C \uC0B4\uC9DD
      \uACE0\uC0DD\uD588\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uC774\uBC88\uC5D0 \uB9C8\uC744\uC5D0\uC11C '\uBB3C \uC808\uC57D \uAD50\uC721'\uC744
      \uAC1C\uCD5C\uD55C\uB2E4\uACE0 \uD55C\uB2E4. \uB300\uBA74 \uAD50\uC721\uACFC
      \uC628\uB77C\uC778 \uAC15\uC758\uC5D0\uB294 \uC870\uAE08\uC758 \uCC38\uAC00\uBE44\uAC00
      \uB4E4 \uAC83 \uAC19\uB2E4."
    choices:
    - "\uB300\uBA74 \uAD50\uC721\uC5D0 \uCC38\uC5EC\uD558\uACE0 \uC2E4\uC2B5\uAE4C\uC9C0
      \uB9C8\uCE5C\uB2E4."
    - "\uC628\uB77C\uC778 \uAC15\uC758\uB85C \uC694\uC810\uB9CC \uB118\uACA8\uBCF8\uB2E4."
    - "\uADF8\uB0E5 \uCC38\uC5EC\uD558\uC9C0 \uC54A\uB294\uB2E4."
    results:
    - "\"\uC2DC\uAC04\uACFC \uC774\uB3D9\uD558\uAE30 \uC704\uD55C \uAD50\uD1B5\uBE44\uAC00
      \uC880 \uB4E4\uACE0 \uCD08\uAE30\uC5D4 \uB0AF\uC124\uC5C8\uC9C0\uB9CC, \uBB3C
      \uC18C\uBE44\uB7C9\uC774 \uB208\uC5D0 \uB744\uAC8C \uC904\uC5B4\uB4E0 \uAC83\uC744
      \uBCF4\uACE0 \uBFCC\uB4EF\uD568\uC744 \uB290\uAF08\uB2E4.\""
    - "\uC720\uC775\uD55C \uB0B4\uC6A9\uC774 \uB9CE\uC558\uB358 \uAC83 \uAC19\uC9C0\uB9CC
      \uC2E4\uC0DD\uD65C\uC5D0 \uC801\uC6A9\uD558\uB824\uB2C8 \uB9C9\uC0C1 \uC190\uC774
      \uC798 \uAC00\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB798\uB3C4 \u2018\uBB3C\u2019\uC5D0
      \uB300\uD574 \uC870\uAE08 \uB354 \uC0DD\uAC01\uD558\uAC8C \uB41C \uACC4\uAE30\uAC00
      \uB418\uC5C8\uB2E4."
    - "\"\uC694\uC998 \uD558\uB8E8\uD558\uB8E8 \uBC84\uD2F0\uB294 \uAC83\uB3C4 \uBC85\uCC3C\uAE30\uC5D0
      \uAD50\uC721\uC740 \uC0AC\uCE58\uCC98\uB7FC \uB290\uAEF4\uC84C\uB2E4. \uD558\uC9C0\uB9CC,
      \uACC4\uC18D\uB418\uB294 \uAC00\uBB44\uACFC \uBB3C\uAC12 \uC778\uC0C1\uC5D0
      \uB098\uC911\uC5D0\uC11C\uC57C \uD6C4\uD68C\uAC00 \uBC00\uB824\uC654\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\"\uC218\uB3D7\uBB3C\uC774 \uD0C1\uD574\uC84C\uB294\uB370, \uC815\uC218
      \uD544\uD130\uB97C \uC0C8\uB85C \uC0B4\uC9C0 \uACE0\uBBFC\uB41C\uB2E4.\""
    choices:
    - "\uB2E4\uD68C\uC6A9 \uACE0\uAE09 \uC815\uC218 \uD544\uD130\uB97C \uAD6C\uB9E4\uD55C\uB2E4."
    - "\uC815\uC218\uB41C \uC0DD\uC218\uB97C \uBCD1\uD589\uD574 \uC0AC\uC6A9\uD55C\uB2E4."
    - "\uBB3C\uC744 \uB053\uC5EC\uC11C \uB9C8\uC2E0\uB2E4."
    results:
    - "\"\uD544\uD130 \uC124\uCE58\uC5D0 \uC2DC\uAC04\uC774 \uB4E4\uACE0 \uAD00\uB9AC\uAC00
      \uD544\uC694\uD588\uC9C0\uB9CC, \uC548\uC804\uD558\uACE0 \uAE68\uB057\uD55C
      \uBB3C\uC744 \uC548\uC815\uC801\uC73C\uB85C \uD655\uBCF4\uD560 \uC218 \uC788\uC5C8\uB2E4.\""
    - "\"\uC2DC\uC6D0\uD55C \uBB3C\uC744 \uB9C8\uC2E4 \uC218 \uC788\uC5C8\uC9C0\uB9CC,
      \uB9E4\uBC88 \uC0AC\uB7EC \uAC00\uB294 \uC218\uACE0\uC640 \uB192\uC740 \uAC00\uACA9\uC774
      \uBD80\uB2F4\uB410\uB2E4. \uC5EC\uB984 \uD55C \uCCA0 \uC0DD\uC218 \uAC12\uB9CC
      \uC218\uB9CC \uC6D0\uC774 \uB4E4\uC5C8\uB2E4.\""
    - "\uD0C8\uC740 \uC5C6\uC5C8\uC9C0\uB9CC \uB9E4\uBC88 \uB053\uC774\uACE0 \uC2DD\uD788\uB294
      \uBC88\uAC70\uB85C\uC6C0\uC5D0 \uC810\uC810 \uC9C0\uCCD0\uAC14\uB2E4. \uAC00\uC2A4\uBE44\uB3C4
      \uBB34\uC2DC \uBABB\uD560 \uC218\uC900\uC73C\uB85C \uB098\uC654\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uBD80\uC871\uD55C \uBB3C\uB85C \uC124\uAC70\uC9C0\uB97C \uD574\uACB0\uD574\uC57C
      \uD55C\uB2E4."
    choices:
    - "\uBB3C \uBC1B\uC544\uC11C \uD5F9\uAD7C\uC218\uB85C \uC7AC\uD65C\uC6A9\uD55C\uB2E4."
    - "\uC2DD\uCD08\uBB3C\uC744 \uC0AC\uC6A9\uD55C\uB2E4."
    - "\uD750\uB974\uB294 \uBB3C\uC5D0 \uADF8\uB300\uB85C \uC138\uCC99\uD55C\uB2E4."
    results:
    - "\uC124\uAC70\uC9C0 \uBB3C\uC744 \uD5F9\uAD7C\uBB3C\uB85C \uC7AC\uD65C\uC6A9\uD558\uB294
      \uC2B5\uAD00\uC73C\uB85C \uBB3C \uC0AC\uC6A9\uB7C9\uC774 \uB208\uC5D0 \uB744\uAC8C
      \uC904\uC5B4\uB4E4\uC5C8\uB2E4."
    - "\"\uC2DD\uCD08\uBB3C\uB85C \uC0B4\uADE0 \uD6A8\uACFC\uB294 \uC788\uC5C8\uC9C0\uB9CC,
      \uB0C4\uC0C8\uC640 \uD53C\uBD80 \uC790\uADF9 \uB54C\uBB38\uC5D0 \uAC00\uC871\uB4E4\uACFC
      \uB9C8\uCC30\uC774 \uC0DD\uACBC\uB2E4.\""
    - "\"\uAE68\uB057\uD558\uAC8C \uB290\uAEF4\uC838 \uB9CC\uC871\uC2A4\uB7EC\uC6E0\uC9C0\uB9CC,
      \uC218\uB3C4\uC138\uAC00 \uAE09\uB4F1\uD588\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
