        value: 5
  - question: "\"\uBCF5\uAD6C \uAE30\uAC04 \uC911 \uC0AC\uC6A9\uD55C \uBB3C\uD1B5,
      \uC0DD\uC218\uBCD1 \uB4F1\uC774 \uC794\uB729 \uC313\uC5EC \uC788\uB2E4.\""
    choices:
    - "\uBD84\uB9AC\uC218\uAC70\uC7A5\uC5D0 \uC9C1\uC811 \uAC00\uC11C \uCC98\uB9AC\uD55C\uB2E4."
    - "\uC2DC\uAC04\uC774 \uC5C6\uC73C\uB2C8 \uADF8\uB0E5 \uB300\uCDA9 \uB0B4\uB193\uB294\uB2E4."
    - "\uC218\uAC70 \uC5C5\uCCB4\uC5D0 \uBE44\uC6A9\uC744 \uB0B4\uACE0 \uCC98\uB9AC
      \uC694\uCCAD \uD55C\uB2E4."
    results:
    - "\uD798\uB4E4\uC5C8\uC9C0\uB9CC \uC815\uB9AC \uD6C4 \uAC1C\uC6B4\uD568\uC774
      \uB0A8\uC558\uB2E4. \uC8FC\uBBFC\uC13C\uD130\uC5D0\uC11C \uAE68\uB057\uD558\uAC8C
      \uBD84\uB9AC\uD55C \uAC00\uC815\uC73C\uB85C \uD3EC\uC778\uD2B8\uB97C \uC8FC\uAE30\uB3C4
      \uD588\uB2E4."
    - "\uB2E4\uC74C\uB0A0 \uC774\uC6C3\uC758 \uD56D\uC758 \uBA54\uBAA8\uB97C \uBC1B\uC558\uB2E4.
      \uC218\uAC70\uB3C4 \uC81C\uB300\uB85C \uB418\uC9C0 \uC54A\uC544 \uC7AC\uC815\uB9AC\uD574\uC57C
      \uD588\uB2E4."
    - "\uBE60\uB974\uACE0 \uD3B8\uD588\uC9C0\uB9CC \uC218\uAC70\uBE44\uAC00 \uC608\uC0C1\uBCF4\uB2E4
      \uB192\uC544 \uBD80\uB2F4\uC2A4\uB7EC\uC6E0\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
