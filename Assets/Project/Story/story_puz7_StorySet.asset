%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2de8e05f04ca588419838d933500abaa, type: 3}
  m_Name: story_puz7_StorySet
  m_EditorClassIdentifier: 
  stories:
  - question: "\uCD5C\uADFC \uC0B4\uB358 \uB3D9\uB124\uC758 \uC7AC\uAC1C\uBC1C\uC774
      \uD655\uC815\uB418\uBA70 \uAC70\uC8FC\uC9C0\uB97C \uC62E\uACA8\uC57C \uD588\uB2E4.
      \uC8FC\uC5B4\uC9C4 \uC608\uC0B0 \uC548\uC5D0\uC11C \uB2E4\uC74C \uC911 \uC5B4\uB5A4
      \uACF3\uC73C\uB85C \uC774\uC0AC\uD560\uAE4C?"
    choices:
    - "\"\uAD00\uB9AC\uBE44\uC640 \uC9D1\uAC12\uC774 \uB9CE\uC774 \uB4E4\uC9C0\uB9CC,
      \uC2E0\uCD95 \uC5D0\uB108\uC9C0 \uACE0\uD6A8\uC728 \uC544\uD30C\uD2B8\uB85C
      \uC774\uC0AC\uD55C\uB2E4.\""
    - "\uC606 \uB3D9\uB124 \uC544\uD30C\uD2B8\uB85C \uC774\uC0AC\uD55C\uB2E4."
    - "\uC870\uAE08 \uB178\uD6C4\uB41C \uBE4C\uB77C\uB85C \uC774\uC0AC\uD55C\uB2E4."
    results:
    - "\"\uC804\uAE30\xB7\uB09C\uBC29\uBE44\uB294 \uD655\uC2E4\uD788 \uC904\uC5C8\uACE0,
      \uC8FC\uAC70 \uCF8C\uC801\uC131\uB3C4 \uB192\uC544\uC84C\uB2E4. \uB2E4\uB9CC
      \uCD08\uAE30 \uBD84\uC591\uAC00\uC640 \uAD00\uB9AC\uBE44\uAC00 \uBD80\uB2F4\uB418\uC5B4
      \uB2E4\uB978 \uC18C\uBE44\uB97C \uC904\uC5EC\uC57C \uD588\uB2E4.\""
    - "\uC0DD\uD65C \uBC18\uACBD\uC740 \uC720\uC9C0\uD560 \uC218 \uC788\uC5C8\uC9C0\uB9CC
      \uB2E8\uC5F4\xB7\uD6A8\uC728\uC131\uC740 \uB0AE\uC544 \uACA8\uC6B8\uB9C8\uB2E4
      \uB09C\uBC29\uBE44\uAC00 \uAC71\uC815\uC774\uC5C8\uB2E4."
    - "\"\uC6D4\uC138\uB294 \uC800\uB834\uD588\uC9C0\uB9CC \uACF0\uD321\uC774, \uACB0\uB85C
      \uB4F1\uC73C\uB85C \uC0DD\uD65C \uB9CC\uC871\uB3C4\uAC00 \uD06C\uAC8C \uB5A8\uC5B4\uC84C\uB2E4.
      \uACB0\uAD6D \uAC74\uAC15 \uBB38\uC81C\uB3C4 \uC0DD\uAE30\uAE30 \uC2DC\uC791\uD588\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\"\uC9D1\uC5D0\uC11C \uD68C\uC0AC\uAE4C\uC9C0\uC758 \uAC70\uB9AC\uAC00
      \uBA40\uB2E4. \uD1B5\uADFC \uBC29\uBC95\uC744 \uACB0\uC815\uD574\uC57C \uD558\uB294\uB370,
      \uC5B4\uB5BB\uAC8C \uD574\uC57C \uD560\uAE4C?\""
    choices:
    - "\uB300\uC911\uAD50\uD1B5\uC744 \uD0C0\uACE0 \uD1B5\uADFC\uD55C\uB2E4."
    - "\uC624\uB798\uB410\uC9C0\uB9CC \uC9D1\uC5D0 \uC788\uB358 \uCC28\uB97C \uC880
      \uB354 \uD0C0\uACE0 \uB2E4\uB2CC\uB2E4."
    - "\uBE44\uC2F8\uB354\uB77C\uB3C4 \uC815\uCC45\uC744 \uD1B5\uD574 \uBCF4\uC870\uAE08\uB3C4
      \uC9C0\uC6D0 \uBC1B\uC744 \uC218 \uC788\uC73C\uB2C8 \uC0C8\uB85C \uC804\uAE30\uCC28\uB97C
      \uAD6C\uB9E4\uD55C\uB2E4."
    results:
    - "\"\uCD9C\uD1F4\uADFC \uC2DC\uAC04\uC774 \uB9CE\uC774 \uB4E4\uC5B4 \uD798\uB4E4\uC5C8\uC9C0\uB9CC,
      \uB300\uC911\uAD50\uD1B5 \uCE74\uB4DC(\uAE30\uD6C4\uB3D9\uD589, K\uD328\uC2A4)\uB97C
      \uD65C\uC6A9\uD558\uB2C8 \uD1B5\uADFC\uBE44 \uC808\uC57D\uC5D0 \uB9CE\uC740
      \uB3C4\uC6C0\uC774 \uB418\uC5C8\uB2E4.\""
    - "\"\uC2DC\uAC04\uC740 \uB2E8\uCD95\uB410\uC9C0\uB9CC \uB9E4\uB2EC \uC720\uB958\uBE44\uAC00
      \uD06C\uAC8C \uB4E4\uC5C8\uACE0, \uC815\uAE30\uC810\uAC80\uBE44\uC6A9\uAE4C\uC9C0
      \uACB9\uCE58\uBA70 \uBD80\uB2F4\uC774 \uB298\uC5C8\uB2E4.\""
    - "\uCD08\uAE30 \uAD6C\uC785\uBE44\uB294 \uB192\uC558\uC9C0\uB9CC \uBCF4\uC870\uAE08\uACFC
      \uC138\uAE08\uAC10\uBA74 \uB355\uBD84\uC5D0 \uC7A5\uAE30\uC801\uC73C\uB860
      \uC808\uC57D\uB410\uB2E4. \uD558\uC9C0\uB9CC \uC804\uAE30\uCC28 \uCDA9\uC804
      \uAC00\uB2A5\uD55C \uACF3\uC774 \uBD80\uC871\uD55C \uC9C0\uC5ED\uC774\uB77C
      \uC870\uAE08\uC740 \uBD88\uD3B8\uD55C \uBD80\uBD84\uC774 \uC788\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uCD5C\uADFC \uBD04\uCCA0 \uBBF8\uC138\uBA3C\uC9C0\uAC00 \uB354 \uC2EC\uD574\uC84C\uB2E4.
      \uB54C\uBB38\uC5D0 \uC911\uD559\uC0DD \uB538\uC758 \uCC9C\uC2DD \uC99D\uC138\uB3C4
      \uC2EC\uD574\uC84C\uB2E4. \uC5B4\uB5BB\uAC8C \uD574\uC57C\uD560\uAE4C?"
    choices:
    - "\uACF5\uAE30\uCCAD\uC815\uAE30\uB97C \uCD94\uAC00\uB85C \uC124\uCE58\uD558\uACE0
      \uC678\uCD9C\uC744 \uC790\uC81C\uD55C\uB2E4."
    - "\uD658\uAE30\uB97C \uC790\uC81C\uD558\uACE0 \uC2B5\uB3C4 \uC870\uC808\uC5D0\uB9CC
      \uC870\uAE08 \uB354 \uC2E0\uACBD\uC368\uC900\uB2E4."
    - "\uC77C\uB2E8\uC740 \uD560 \uC218 \uC788\uB294\uAC8C \uC5C6\uB2E4."
    results:
    - "\uC2E4\uB0B4 \uACF5\uAE30\uC9C8\uC774 \uAC1C\uC120\uB418\uC5B4 \uB538\uC758
      \uAC74\uAC15\uC774 \uB9CE\uC774 \uC88B\uC544\uC84C\uB2E4. \uC678\uCD9C\uC740
      \uC904\uC5C8\uC9C0\uB9CC \uAC74\uAC15\uC5D0 \uB300\uD55C \uB9CC\uC871\uB3C4\uB294
      \uB192\uC558\uB2E4."
    - "\"\uB538\uC758 \uCC9C\uC2DD \uC99D\uC0C1\uC740 \uC904\uC5C8\uC9C0\uB9CC, \uD658\uAE30\uB97C
      \uBABB\uD558\uB2C8 \uC2B5\uB3C4 \uC870\uC808\uC5D0 \uC2E0\uACBD\uC368\uB3C4
      \uACF0\uD321\uC774\xB7\uC2E4\uB0B4 \uB0C4\uC0C8 \uBB38\uC81C\uB294 \uC644\uC804\uD788
      \uB9C9\uC744 \uC218 \uC5C6\uC5C8\uB2E4.\""
    - "\uB538\uC758 \uCC9C\uC2DD\uC774 \uC545\uD654\uB418\uC5C8\uACE0 \uBCD1\uC6D0
      \uBC29\uBB38\uC774 \uC7A6\uC544\uC84C\uB2E4. \uC57D\uAC12\uACFC \uD1B5\uC6D0
      \uBE44\uC6A9\uC774 \uBD80\uB2F4\uB410\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC8FC\uBBFC \uB2E8\uCCB4 \uCC44\uD305\uBC29\uC5D0\uC11C \uCE5C\uD658\uACBD
      \uC124\uBE44 \uACF5\uB3D9\uAD6C\uB9E4\uC5D0 \uB300\uD55C \uC598\uAE30\uAC00
      \uB098\uC654\uB2E4."
    choices:
    - "\uD0DC\uC591\uAD11 \uD328\uB110\uACFC \uACE0\uD6A8\uC728 \uBCF4\uC77C\uB7EC
      \uACF5\uB3D9\uAD6C\uB9E4\uC5D0 \uCC38\uC5EC\uD55C\uB2E4."
    - "\uB2F9\uC7A5 \uCE5C\uD658\uACBD \uC124\uBE44 \uC124\uCE58\uB294 \uBD80\uB2F4\uC2A4\uB7FD\uB2E4.
      \uADF8\uB0E5 \uCE5C\uD658\uACBD \uC5D0\uB108\uC9C0 \uCEA0\uD398\uC778\uC5D0\uB9CC
      \uCC38\uC5EC\uD55C\uB2E4."
    - "\uADF8\uB0E5 \uB118\uAE34\uB2E4."
    results:
    - "\uD0DC\uC591\uAD11 \uD328\uB110\uACFC \uACE0\uD6A8\uC728 \uBCF4\uC77C\uB7EC\uB85C
      \uC5D0\uB108\uC9C0 \uC808\uAC10 \uD6A8\uACFC\uAC00 \uD655\uC2E4\uD588\uB2E4.
      \uD22C\uC790\uBE44\uB294 \uC788\uC5C8\uC9C0\uB9CC \uC7A5\uAE30\uC801\uC73C\uB85C
      \uB9CC\uC871\uC2A4\uB7EC\uC6E0\uB2E4."
    - "\"\uCEA0\uD398\uC778 \uCC38\uC5EC \uC774\uD6C4 \uD55C\uB3D9\uC548\uC740 \uCE5C\uD658\uACBD\uC5D0
      \uC2E0\uACBD\uC4F0\uBA70 \uC0B4\uC558\uC9C0\uB9CC, \uC2E4\uC9C8\uC801 \uC5D0\uB108\uC9C0
      \uC808\uAC10 \uD6A8\uACFC\uB294 \uBBF8\uBBF8\uD588\uB2E4.\""
    - "\uC2DC\uAC04\uC774 \uC9C0\uB0A0\uC218\uB85D \uD0DC\uC591\uAD11 \uD328\uB110
      \uC124\uCE58 \uAC00\uAD6C\uC5D0 \uBE44\uD574 \uAD00\uB9AC\uBE44\uAC00 \uB9CE\uC774
      \uB098\uC624\uB294 \uAC78 \uBCF4\uBA70 \uB4A4\uB2A6\uC740 \uD6C4\uD68C\uAC00
      \uC0DD\uACBC\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uD55C\uC5EC\uB984 \uACC4\uC18D\uB418\uB294 \uD3ED\uC5FC\uC73C\uB85C
      \uC5D0\uC5B4\uCEE8\uC744 \uACC4\uC18D \uD2C0\uC5B4\uB1A8\uB354\uB2C8 \uC9C0\uB09C\uB2EC
      \uC804\uAE30\uC138 \uD3ED\uD0C4\uC744 \uBC1B\uC558\uB2E4."
    choices:
    - "\uB108\uBB34 \uB354\uC6CC\uC11C \uC5B4\uCA54 \uC218 \uC5C6\uC774 \uC885\uC77C
      \uC5D0\uC5B4\uCEE8\uC744 \uAC00\uB3D9\uD55C\uB2E4."
    - "\"\uC120\uD48D\uAE30\uB97C \uC8FC\uB85C \uC0AC\uC6A9\uD558\uACE0, \uC5D0\uC5B4\uCEE8\uC744
      \uC808\uC804\uBAA8\uB4DC\uB85C \uC77C\uC815 \uC2DC\uAC04\uB3D9\uC548\uB9CC
      \uAC00\uB3D9\uD55C\uB2E4.\""
    - "\uC120\uD48D\uAE30\uB9CC \uC0AC\uC6A9\uD55C\uB2E4."
    results:
    - "\uBAB8\uC740 \uC2DC\uC6D0\uD588\uC9C0\uB9CC \uC804\uAE30\uB8CC\uB294 \uD3C9\uC18C\uC758
      \uBA87 \uBC30\uAC00 \uB098\uC640 \uC2DD\uBE44\uB098 \uB2E4\uB978 \uC0DD\uD65C\uBE44\uB97C
      \uC904\uC77C \uC218\uBC16\uC5D0 \uC5C6\uC5C8\uB2E4."
    - "\uCF8C\uC801\uD55C \uC0C1\uD0DC\uB97C \uC720\uC9C0\uD558\uBA74\uC11C\uB3C4
      \uC804\uAE30\uC694\uAE08 \uC0C1\uC2B9\uC740 \uC870\uAE08 \uC5B5\uC81C\uB410\uB2E4.
      \uC0DD\uD65C \uB9CC\uC871\uB3C4\uC640 \uBE44\uC6A9 \uADE0\uD615\uC744 \uB9DE\uCDC4\uB2E4."
    - "\uBE44\uC6A9\uC740 \uC904\uC5C8\uC9C0\uB9CC \uC5F4\uB300\uC57C\uC5D0 \uC7A0\uC744
      \uC124\uCE58\uB294 \uB0A0\uC774 \uB9CE\uC544\uC84C\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC5EC\uB984 \uB3D9\uC548 \uB3D9\uB124\uC758 \uC804\uB825 \uC218\uC694\uAC00
      \uD3ED\uC99D\uD574 \uC815\uC804\uC774 \uBC1C\uC0DD\uD588\uB2E4. \uB2E4\uC2DC
      \uBCF5\uAD6C\uB420 \uB54C\uAE4C\uC9C0 \uBC84\uD168\uC57C \uD558\uB294\uB370\u2026"
    choices:
    - "\uC800\uBC88\uC5D0 \uD070\uB9D8\uBA39\uACE0 \uC124\uCE58\uD588\uB358 UPS \uBE44\uC0C1\uC804\uC6D0
      \uC7A5\uBE44\uB97C \uC0AC\uC6A9\uD558\uC5EC \uBC84\uD17C\uB2E4."
    - "\uACFC\uAC70 \uCEA0\uD551\uD558\uAE30 \uC704\uD574 \uAD6C\uB9E4\uD588\uC5C8\uB358
      \uC18C\uD615 \uB514\uC824 \uBC1C\uC804\uAE30\uB97C \uC0AC\uC6A9\uD558\uC5EC
      \uBC84\uD17C\uB2E4."
    - "\uC190\uC804\uB4F1\uACFC \uBCF4\uC870 \uBC30\uD130\uB9AC\uB85C \uBC84\uD17C\uB2E4."
    results:
    - "\"\uC9E7\uC740 \uC2DC\uAC04 \uB3D9\uC548\uC740 \uB0C9\uC7A5\uACE0\uC640 \uC870\uBA85
      \uC0AC\uC6A9 \uAC00\uB2A5\uD588\uACE0, \uC7A5\uBE44 \uCD08\uAE30 \uC124\uCE58\uBE44\uAC00
      \uC788\uC5C8\uC9C0\uB9CC \uC704\uAE09 \uC0C1\uD669\uC5D0\uC11C \uB9E4\uC6B0
      \uC720\uC6A9\uD588\uB2E4.\""
    - "\"\uC18C\uC74C\uACFC \uB0C4\uC0C8\uAC00 \uC2EC\uD588\uACE0, \uC2E4\uB0B4 \uACF5\uAE30\uC9C8\uC774
      \uB098\uBE60\uC84C\uB2E4. \uC5F0\uB8CC\uB3C4 \uAE08\uBC29 \uC18C\uC9C4\uB418\uC5B4
      \uC2E4\uC6A9\uC131\uC774 \uB0AE\uC558\uB2E4.\""
    - "\"\uB2E8\uAE30\uC801\uC73C\uB860 \uBC84\uD2F8 \uC218 \uC788\uC5C8\uC9C0\uB9CC
      \uC815\uC804\uC774 \uAF64 \uAE38\uC5B4\uC9C0\uACE0 \uADF8\uB3D9\uC548 \uB0C9\uC7A5\uACE0,
      \uCEF4\uD4E8\uD130 \uB4F1\uC744 \uC0AC\uC6A9\uD558\uC9C0 \uBABB\uD558\uAC8C
      \uB418\uBA74\uC11C \uC190\uD574\uAC00 \uCEF8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uAE30\uD6C4 \uBCC0\uD654\uB85C \uC2DD\uC7AC\uB8CC \uAC00\uACA9\uB4E4\uC774
      \uACC4\uC18D \uC624\uB974\uACE0 \uC788\uB2E4."
    choices:
    - "\uC870\uAE08 \uBE44\uC2F8\uB354\uB77C\uB3C4 \uC800\uD0C4\uC18C/\uCE5C\uD658\uACBD
      \uC2DD\uC7AC\uB8CC\uB85C \uAD6C\uB9E4\uD55C\uB2E4."
    - "\uC77C\uBC18 \uC2DD\uC7AC\uB8CC\uB4E4\uC744 \uAD6C\uB9E4\uD55C\uB2E4."
    - "\uC870\uAE08\uC774\uB77C\uB3C4 \uC800\uB834\uD55C \uB0C9\uB3D9\uC774\uB098
      \uC218\uC785 \uC2DD\uC7AC\uB8CC\uB97C \uAD6C\uB9E4\uD55C\uB2E4."
    results:
    - "\"\uBE44\uC6A9\uC740 \uB354 \uB4E4\uC5C8\uC9C0\uB9CC \uC548\uC804\uC131 \uB192\uC740
      \uC2DD\uC7AC\uB8CC\uB85C \uAC74\uAC15 \uC720\uC9C0\uC5D0 \uB3C4\uC6C0\uB418\uC5C8\uACE0,
      \uCE5C\uD658\uACBD\uC5D0 \uB3C4\uC6C0\uC774 \uB418\uC5C8\uB2E4\uB294 \uC0DD\uAC01\uC5D0
      \uBFCC\uB4EF\uD574\uC84C\uB2E4.\""
    - "\"\uD3C9\uC18C\uCC98\uB7FC \uD2B9\uBCC4\uD55C \uBB38\uC81C \uC5C6\uC774 \uC720\uC9C0\uD588\uC9C0\uB9CC,
      \uC2DD\uC7AC\uB8CC \uAC00\uACA9 \uC0C1\uC2B9\uC774 \uC5BC\uB9C8\uB098 \uC9C0\uC18D\uB420\uC9C0
      \uBD88\uC548\uAC10\uC740 \uC5EC\uC804\uD588\uB2E4.\""
    - "\"\uCD08\uAE30\uC5D4 \uAC00\uC131\uBE44 \uC88B\uC558\uC9C0\uB9CC, \uBA87 \uCC28\uB840
      \uD488\uC9C8 \uBB38\uC81C\uB85C \uBC30\uD0C8 \uB4F1\uC758 \uBB38\uC81C\uAC00
      \uBC1C\uC0DD\uD588\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC544\uCE68\uC5D4 \uCDA5\uACE0 \uB0AE\uC5D4 \uB354\uC6B4 \uB0A0\uC528
      \uD0D3\uC5D0 \uAC10\uAE30\uC5D0 \uAC78\uB838\uB2E4. \uC810\uC810 \uADF9\uC2EC\uD55C
      \uC77C\uAD50\uCC28\uAC00 \uC790\uC8FC \uC788\uB294 \uAC83 \uAC19\uB2E4."
    choices:
    - "\uC587\uC740 \uC637\uC744 \uC5EC\uB7EC\uACB9 \uC785\uD600 \uCCB4\uC628 \uC870\uC808\uC744
      \uD558\uB3C4\uB85D \uD55C\uB2E4."
    - "\"\uB0C9\uBC29\uAE30\uB9CC \uC0AC\uC6A9\uD558\uACE0, \uCD94\uC6B0\uBA74 \uB530\uB73B\uD558\uAC8C
      \uAEF4\uC785\uB294\uB2E4.\""
    - "\uB0C9\uB09C\uBC29\uAE30\uB97C \uBAA8\uB450 \uC0AC\uC6A9\uD55C\uB2E4."
    results:
    - "\uBCC4\uB3C4\uC758 \uB0C9\uB09C\uBC29\uAE30 \uC5C6\uC774\uB3C4 \uC77C\uC815
      \uC218\uC900\uC758 \uCCB4\uC628\uC744 \uC720\uC9C0\uD588\uB2E4. \uC57D\uAC04
      \uBD88\uD3B8\uD558\uC9C0\uB9CC \uAC10\uAE30 \uC99D\uC0C1\uC740 \uB098\uC544\uC84C\uB2E4."
    - "\uC2E4\uB0B4\uB294 \uCF8C\uC801\uD588\uC9C0\uB9CC \uB0C9\uBC29\uAE30 \uC0AC\uC6A9\uC73C\uB85C
      \uAC10\uAE30 \uC99D\uC138\uAC00 \uC27D\uAC8C \uB0AB\uC9C0 \uC54A\uC544 \uC57D\uAC12\uACFC
      \uD1B5\uC6D0 \uCE58\uB8CC\uBE44\uAC00 \uC0DD\uACBC\uB2E4."
    - "\"\uC2E4\uB0B4\uB294 \uC644\uBCBD\uD558\uAC8C \uC720\uC9C0\uB418\uC5C8\uC9C0\uB9CC,
      \uADF8 \uB2EC \uC5D0\uB108\uC9C0 \uBE44\uC6A9\uC774 \uD06C\uAC8C \uB298\uC5B4\uB0AC\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uACA8\uC6B8\uC774 \uB418\uBA74\uC11C \uB09C\uBC29 \uBC29\uC2DD\uC744
      \uC120\uD0DD\uD574\uC57C \uD55C\uB2E4."
    choices:
    - "\"\uCC3D\uBB38\uACFC \uD604\uAD00\uC5D0 \uB2E8\uC5F4\uC744 \uC704\uD55C \uB300\uBE44\uB97C
      \uCD94\uAC00\uB85C \uD558\uACE0, \uB09C\uBC29\uC744 \uC0AC\uC6A9\uD55C\uB2E4.\""
    - "\uADF8\uB0E5 \uB09C\uBC29\uAE30\uB97C \uCDA9\uBD84\uD788 \uC0AC\uC6A9\uD55C\uB2E4."
    - "\"\uB09C\uBC29\uAE30 \uC0AC\uC6A9\uC744 \uC870\uC808\uD558\uBA70, \uADF8\uB0E5
      \uC0DD\uD65C\uD55C\uB2E4.\""
    results:
    - "\uC678\uD48D\uC774 \uC904\uACE0 \uB09C\uBC29 \uD6A8\uC728\uB3C4 \uB192\uC544\uC84C\uB2E4.
      \uCD08\uAE30 \uBE44\uC6A9\uC740 \uC788\uC5C8\uC9C0\uB9CC \uAD00\uB9AC\uBE44\uB294
      \uC904\uC5C8\uB2E4."
    - "\uB09C\uBC29\uBE44\uAC00 \uAE09\uC99D\uD574 \uC0DD\uD65C\uBE44\uC5D0\uC11C
      \uB2E4\uB978 \uBD80\uBD84\uC744 \uC904\uC5EC\uC57C \uD588\uB2E4."
    - "\"\uB09C\uBC29\uBE44\uB294 \uC904\uC5C8\uC9C0\uB9CC, \uC190\uBC1C\uC774 \uC2DC\uB824
      \uC218\uBA74\uC758 \uC9C8\uC774 \uB5A8\uC5B4\uC84C\uACE0, \uAD00\uC808\uD1B5\uC774
      \uC545\uD654\uB410\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uAC00\uC804\uAE30\uAE30\uC758 \uB300\uAE30\uC804\uB825\uC744 \uCC28\uB2E8\uD574\uC8FC\uB294
      \uC2A4\uB9C8\uD2B8 \uD50C\uB7EC\uADF8\uAC00 \uD560\uC778 \uC911\uC774\uB2E4."
    choices:
    - "\uC5EC\uB7EC \uAC1C \uAD6C\uC785 \uD6C4 \uC124\uCE58\uD55C\uB2E4."
    - "1\uAC1C\uB9CC \uAD6C\uB9E4\uD574\uC11C \uC2DC\uD5D8\uC0BC\uC544 \uC368\uBCF8\uB2E4."
    - "\"\uAD1C\uD55C \uC18C\uBE44\uC778 \uAC83 \uAC19\uACE0, \uADC0\uCC2E\uC73C\uB2C8\uAE4C
      \uADF8\uB0E5 \uC9C0\uB098\uCE5C\uB2E4.\""
    results:
    - "\uB300\uAE30\uC804\uB825 \uCC28\uB2E8 \uB355\uBD84\uC5D0 \uB9E4\uB2EC \uC804\uAE30\uC694\uAE08\uC774
      10% \uAC00\uAE4C\uC774 \uC904\uC5C8\uB2E4. \uC2A4\uB9C8\uD2B8\uD3F0\uC73C\uB85C
      \uC804\uB825 \uAD00\uB9AC\uB97C \uD558\uBA70 \uD6A8\uC728\uB3C4 \uB192\uC544\uC84C\uB2E4."
    - "\uD6A8\uACFC\uB294 \uCCB4\uAC10\uB418\uC9C0\uB9CC \uD55C \uAC1C\uB9CC \uC0AC\uC6A9\uD558\uB2C8
      \uC81C\uD55C\uC801\uC774\uC5C8\uB2E4. \uB54C\uBB38\uC5D0 \uBA87 \uAC1C \uB354
      \uAD6C\uB9E4\uD560 \uC0DD\uAC01\uC744 \uAC00\uC9C0\uAC8C \uB418\uC5C8\uB2E4."
    - "\uACC4\uC18D \uBD88\uD544\uC694\uD55C \uB300\uAE30\uC804\uB825 \uC18C\uBAA8\uB85C
      \uC804\uAE30\uC694\uAE08 \uC190\uD574\uAC00 \uBC1C\uC0DD\uD588\uB2E4. \uADF8
      \uB54C \uAD6C\uB9E4\uD560 \uAC78\uC774\uB77C\uB294 \uD6C4\uD68C\uAC00 \uB0A8\uAC8C
      \uB418\uC5C8\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
