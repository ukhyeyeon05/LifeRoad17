%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2de8e05f04ca588419838d933500abaa, type: 3}
  m_Name: story_puz8_StorySet
  m_EditorClassIdentifier: 
  stories:
  - question: "\"\uB098\uB294 \uC878\uC5C5 \uD6C4 \uCDE8\uC5C5\uC744 \uBAA9\uD45C\uB85C
      \uC2E4\uC2B5 \uC911\uC778 \uD2B9\uC131\uD654\uACE0 3\uD559\uB144 \uC655\uC131\uC2E4\uC774\uB2E4.
      3\uD559\uB144 2\uD559\uAE30\uBD80\uD130 \uAE30\uACC4\uBD80\uD488 \uC81C\uC870
      \uACF5\uC7A5\uC5D0\uC11C \uC2E4\uC2B5 \uC911\uC778\uB370, \uB9C9\uC0C1 \uD604\uC7A5\uC5D0
      \uB098\uC640 \uBCF4\uB2C8 \uD544\uC694\uD55C \uBB3C\uD488\uC774 \uB108\uBB34
      \uB9CE\uB2E4.\""
    choices:
    - "\uBD80\uBAA8\uB2D8\uC758 \uC9C0\uC6D0\uC744 \uBC1B\uC544 \uBAA8\uB4E0 \uC7A5\uBE44\uB97C
      \uAC16\uCD94\uACE0 \uC2E4\uC2B5\uC5D0 \uCC38\uC5EC\uD55C\uB2E4."
    - "\uCD5C\uC18C\uD55C\uC758 \uC7A5\uBE44\uB9CC \uB9C8\uB828\uD574 \uC2E4\uC2B5\uC5D0
      \uCC38\uC5EC\uD55C\uB2E4."
    - "\"\uC790\uBE44\uB85C \uC7A5\uBE44\uB97C \uB9C8\uB828\uD560 \uC218 \uC5C6\uC5B4,
      \uC788\uB294 \uC637\uACFC \uC2E0\uBC1C\uC744 \uCC29\uC6A9\uD558\uACE0 \uC2E4\uC2B5\uC5D0
      \uCC38\uC5EC\uD55C\uB2E4.\""
    results:
    - "\"\uC7A5\uBE44\uB97C \uC644\uC804\uD788 \uAC16\uCD98 \uB355\uBD84\uC5D0 \uC2E4\uC2B5
      \uC911 \uBD88\uD3B8\uD568\uC774 \uC5C6\uC5C8\uACE0, \uD3C9\uAC00\uC5D0\uC11C\uB3C4
      \uB192\uC740 \uC810\uC218\uB97C \uBC1B\uC558\uB2E4. \uB2E4\uB9CC \uC18C\uBAA8\uD488\uC778
      \uC7A5\uBE44 \uAC00\uACA9 \uB54C\uBB38\uC5D0 \uBD80\uBAA8\uB2D8\uC758 \uBD80\uB2F4\uC774
      \uC870\uAE08 \uCEE4\uC84C\uB2E4.\""
    - "\"\uD544\uC694\uD55C \uB3C4\uAD6C\uAC00 \uBD80\uC871\uD574 \uC791\uC5C5 \uC2DC\uAC04\uC774
      \uB298\uC5B4\uB0AC\uACE0, \uBA87 \uBC88\uC740 \uBE4C\uB824 \uC4F0\uBA70 \uB208\uCE58\uB3C4
      \uBCF4\uAC8C \uB410\uB2E4.\""
    - "\uBCF4\uD638\uC7A5\uBE44 \uBBF8\uD761\uC73C\uB85C \uBC1C\uC5D0 \uBB3C\uC9D1\uC774
      \uC0DD\uAE30\uACE0 \uAE30\uACC4 \uC624\uC77C\uB85C \uC637\uC774 \uB9DD\uAC00\uC84C\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uBB34\uAC70\uC6B4 \uAE30\uACC4\uB97C \uC62E\uAE30\uB2E4\uAC00 \uD314\uC5D0
      \uCC30\uACFC\uC0C1\uC744 \uC785\uC5C8\uB2E4."
    choices:
    - "\uC751\uAE09\uCC98\uCE58\uC2E4\uB85C \uBC14\uB85C \uD5A5\uD55C\uB2E4."
    - "\uADFC\uCC98 \uC57D\uAD6D\uC5D0\uC11C \uC57D\uACFC \uC18C\uB3C5\uC57D\uC744
      \uAD6C\uB9E4\uD55C\uB2E4."
    - "\uADF8\uB0E5 \uCC38\uACE0 \uC77C\uD55C\uB2E4."
    results:
    - "\"\uBE60\uB978 \uCC98\uCE58\uB85C \uC0C1\uCC98\uAC00 \uB367\uB098\uC9C0 \uC54A\uC558\uACE0,
      \uAE08\uBC29 \uD68C\uBCF5\uB418\uC5B4 \uC774\uC5B4\uC9C4 \uC2E4\uC2B5\uC5D0
      \uC601\uD5A5\uC744 \uB07C\uCE58\uC9C0 \uC54A\uC744 \uC218 \uC788\uC5C8\uB2E4.\""
    - "\"\uC0C1\uCC98\uB294 \uB098\uC558\uC9C0\uB9CC, \uD63C\uC790 \uD310\uB2E8\uD588\uB358
      \uC5B4\uC124\uD508 \uCC98\uCE58\uB85C \uC778\uD574 \uC774\uD6C4 \uBC1C\uC9C4\uC774
      \uBC1C\uC0DD\uD588\uB2E4.\""
    - "\uBA70\uCE60 \uD6C4 \uC0C1\uCC98\uAC00 \uB367\uB098\uACE0 \uD1B5\uC99D\uC774
      \uC2EC\uD574\uC84C\uB2E4. \uACB0\uAD6D \uBCD1\uC6D0\uC5D0 \uAC00\uAC8C \uB418\uC5C8\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uAE30\uACC4 \uC624\uC791\uB3D9\uC73C\uB85C \uCE5C\uAD6C\uAC00 \uB2E4\uCE60
      \uBED4\uD55C \uC0C1\uD669\uC744 \uBAA9\uACA9\uD588\uB2E4."
    choices:
    - "\uD559\uAD50 \uB2F4\uB2F9 \uAD50\uC0AC\uC5D0\uAC8C \uBC14\uB85C \uBCF4\uACE0\uD55C\uB2E4."
    - "\uD68C\uC0AC \uB0B4\uBD80\uC5D0 \uC870\uC2EC\uD558\uC790\uACE0\uB9CC \uB9D0\uD55C\uB2E4."
    - "\uADF8\uB0E5 \uB118\uC5B4\uAC04\uB2E4."
    results:
    - "\"\uBE60\uB978 \uAC1C\uC120 \uC870\uCE58\uAC00 \uC774\uB904\uC9C8 \uC904 \uC54C\uC558\uC9C0\uB9CC,
      \uC2DC\uAC04\uC774 \uC0DD\uAC01\uBCF4\uB2E4 \uC624\uB798\uAC78\uB838\uB2E4.
      \uADF8\uB798\uB3C4 \uAD00\uB828\uB41C \uC548\uC804 \uC870\uD56D\uC774 \uC0C8\uB85C
      \uB9CC\uB4E4\uC5B4\uC9C0\uAE34 \uD574 \uB2E4\uD589\uC774\uB2E4.\""
    - "\"\uAD6C\uB450 \uC804\uB2EC\uC774\uB77C \uC0AC\uD6C4 \uC870\uCE58\uAC00 \uB290\uB838\uACE0,
      \uB610 \uB2E4\uB978 \uC0AC\uACE0\uAC00 \uBC1C\uC0DD\uD560 \uBED4\uD588\uB2E4.\""
    - "\uBA70\uCE60 \uD6C4 \uC9C4\uC9DC \uC0AC\uACE0\uAC00 \uBC1C\uC0DD\uD588\uB2E4.
      \uD070\uC77C\uC774 \uC544\uB2C8\uC5C8\uC9C0\uB9CC \uC8C4\uCC45\uAC10\uC774
      \uB0A8\uC558\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC2E4\uC2B5 \uC5C5\uCCB4\uC5D0\uC11C \uC26C\uB294 \uC2DC\uAC04 \uC5C6\uC774
      6\uC2DC\uAC04 \uC5F0\uC18D \uC791\uC5C5 \uC9C0\uC2DC\uAC00 \uB0B4\uB824\uC84C\uB2E4."
    choices:
    - "\uC870\uC2EC\uC2A4\uB7FD\uAC8C \uD604\uC7A5\uBC18\uC7A5\uC5D0\uAC8C \uC26C\uB294
      \uC2DC\uAC04 \uBCF4\uC7A5\uC744 \uC694\uCCAD\uD55C\uB2E4."
    - "\uC7A0\uAE50 \uD654\uC7A5\uC2E4\uC744 \uB2E4\uB140\uC624\uBA70 \uB208\uCE58\uAECF
      \uC270\uB2E4."
    - "\uC544\uBB34 \uB9D0 \uC5C6\uC774 \uC9C0\uC2DC\uC5D0 \uB530\uB978\uB2E4."
    results:
    - "\uCC98\uC74C\uC5D4 \uB208\uCE58\uAC00 \uBCF4\uC600\uC9C0\uB9CC \uC774\uD6C4
      \uC815\uC2DD\uC73C\uB85C \uD734\uAC8C\uC2DC\uAC04\uC774 \uBC18\uC601\uB410\uB2E4."
    - "\uC911\uAC04\uC5D0 \uBAB0\uB798 \uC26C\uB2E4 \uAD00\uB9AC\uC790\uC5D0\uAC8C
      \uC9C0\uC801\uBC1B\uACE0 \uD3C9\uAC00\uC9C0\uD45C\uAC00 \uAE4E\uC600\uB2E4."
    - "\uADFC\uBB34 \uC911 \uD0C8\uC9C4 \uC99D\uC138\uB85C \uC2E4\uC2B5\uC744 \uC774\uD2C0
      \uC26C\uAC8C \uB418\uC5C8\uB2E4. \uD68C\uC0AC \uD3C9\uAC00\uB294 \uB098\uBE60\uC84C\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\"\uADFC\uBB34 \uC911 \uD654\uD559\uC57D\uD488 \uADFC\uCC98\uC5D0\uC11C
      \uC791\uC5C5\uD558\uAC8C \uB418\uC5C8\uB294\uB370, \uB9C8\uC2A4\uD06C\uAC00
      \uC9C0\uAE09\uB418\uC9C0 \uC54A\uC558\uB2E4.\""
    choices:
    - "\uBC29\uC9C4 \uB9C8\uC2A4\uD06C\uB97C \uC9C1\uC811 \uAD6C\uC785\uD574 \uC0AC\uC6A9\uD55C\uB2E4."
    - "\uB3D9\uB8CC\uAC00 \uC0AC\uC6A9\uD588\uB358 \uB9C8\uC2A4\uD06C\uB97C \uBE4C\uB824
      \uC7AC\uC0AC\uC6A9\uD55C\uB2E4."
    - "\uC57D\uAD6D\uC5D0\uC11C \uB374\uD0C8\uB9C8\uC2A4\uD06C \uD558\uB098\uB97C
      \uAD6C\uB9E4\uD574 \uC0AC\uC6A9\uD55C\uB2E4."
    results:
    - "\uAF3C\uAF3C\uD788 \uC2E0\uACBD\uC4F0\uACE0 \uC791\uC5C5\uD55C \uD0D3\uC5D0
      \uAC74\uAC15\uC5D0 \uD070 \uC774\uC0C1\uC5C6\uC774 \uC791\uC5C5\uC744 \uB9C8\uBB34\uB9AC\uD560
      \uC218 \uC788\uC5C8\uB2E4."
    - "\"\uD654\uD559\uC57D\uD488 \uB0C4\uC0C8\uB294 \uC904\uC5C8\uC9C0\uB9CC, \uC791\uC5C5
      \uB3C4\uC911 \uAE30\uCE68\uC774 \uC2EC\uD574\uC838 \uBCD1\uC6D0 \uC9C4\uB8CC\uB97C
      \uBC1B\uAC8C \uB410\uB2E4.\""
    - "\"\uC77C\uB2E8 \uBC84\uD2F0\uBA70 \uC791\uC5C5\uD588\uC9C0\uB9CC, \uBA87 \uCC28\uB840
      \uC791\uC5C5 \uD6C4 \uC5EC\uB7EC \uC99D\uC0C1\uC774 \uB098\uD0C0\uB098 \uBCD1\uC6D0\uC5D0\uC11C
      \uBA70\uCE60 \uC785\uC6D0\uCE58\uB8CC\uB97C \uBC1B\uAC8C \uB418\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC2E4\uC2B5\uC218\uCCA9\uC5D0 \uC548\uC804 \uAD00\uB828 \uBD88\uB9CC\uC744
      \uC4F0\uB824 \uD588\uC9C0\uB9CC \uB208\uCE58\uAC00 \uBCF4\uC778\uB2E4."
    choices:
    - "\uBB38\uC81C \uC0C1\uD669\uC744 \uC194\uC9C1\uD558\uAC8C \uBCF4\uACE0\uD558\uACE0
      \uB3C4\uC6C0\uC744 \uC694\uCCAD\uD55C\uB2E4."
    - "\uC0C1\uD669\uC744 \uC644\uACE1\uD558\uAC8C \uC774\uC57C\uAE30\uD55C\uB2E4."
    - "\uBE48\uCE78\uC73C\uB85C \uB454\uB2E4."
    results:
    - "\"\uD68C\uC0AC\uB294 \uBD88\uB9CC \uB0B4\uC6A9\uC744 \uAC1C\uC120\uD588\uACE0,
      \uD558\uC9C0\uB9CC \uC774\uD6C4 \uC2E4\uC2B5 \uAE30\uAC04\uB3D9\uC548 \uD68C\uC0AC\uC758
      \uB208\uCE58\uB97C \uB9CE\uC774 \uBCF4\uAC8C \uB418\uC5C8\uB2E4.\""
    - "\"\uC57D\uAC04\uC758 \uAC1C\uC120\uC740 \uC788\uC5C8\uC9C0\uB9CC \uD68C\uC0AC\uC5D0\uC11C
      \uD070 \uB178\uB825\uC744 \uD558\uC9C4 \uC54A\uC558\uACE0, \uACB0\uC815\uC801
      \uBB38\uC81C\uB294 \uD574\uACB0\uB418\uC9C0 \uC54A\uC558\uB2E4.\""
    - "\"\uAC1C\uC120\uC740 \uCEE4\uB155 \uC774\uD6C4 \uAC19\uC740 \uBB38\uC81C\uAC00
      \uBC18\uBCF5\uB418\uC5C8\uACE0, \uC774\uC9C1\uC744 \uACE0\uBBFC\uD558\uAC8C
      \uB410\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uCCAB \uC6D4\uAE09\uC774 \uC785\uAE08\uB418\uC5C8\uB2E4. \uC5B4\uB514\uC5D0
      \uC0AC\uC6A9\uD558\uBA74 \uC88B\uC744\uAE4C?"
    choices:
    - "\"\uBD80\uBAA8\uB2D8\uAED8 \uC790\uAE08 \uAD00\uB9AC\uB97C \uBD80\uD0C1 \uB4DC\uB9AC\uACE0,
      \uB098\uBA38\uC9C0\uB294 \uAC74\uAC15\uAC80\uC9C4 \uC608\uC57D\uACFC \uC0DD\uD65C\uBE44\uB85C
      \uC0AC\uC6A9\uD55C\uB2E4.\""
    - "\"\uC808\uBC18\uC740 \uC800\uCD95\uD558\uACE0, \uB098\uBA38\uC9C0\uB294 \uC601\uC591\uC81C
      \uAD6C\uB9E4\uC640 \uC0DD\uD65C\uBE44\uB85C \uC0AC\uC6A9\uD55C\uB2E4.\""
    - "\uBAA8\uB450 \uC800\uCD95\uD558\uACE0 \uC500\uC500\uC774\uB97C \uC904\uC778\uB2E4."
    results:
    - "\"\uBD80\uBAA8\uB2D8\uC758 \uC11C\uD3EC\uD2B8\uB85C \uD6A8\uC728\uC801\uC778
      \uC790\uAE08\uAD00\uB9AC\uAC00 \uAC00\uB2A5\uD588\uACE0, \uC801\uC808\uD55C
      \uC2DC\uAE30\uC758 \uAC74\uAC15\uAC80\uC9C4 \uACB0\uACFC \uB355\uBD84\uC5D0
      \uC870\uAE30 \uCE58\uB8CC\uAC00 \uAC00\uB2A5\uD588\uB2E4.\""
    - "\"\uAC74\uAC15\uAD00\uB9AC\uC5D0 \uC2E0\uACBD\uC744 \uC4F0\uBA70 \uCEE8\uB514\uC158
      \uAD00\uB9AC\uB97C \uD588\uACE0, \uC800\uCD95\uB3C4 \uD558\uBA70 \uC548\uC815\uAC10\uC744
      \uC5BB\uC5C8\uB2E4.\""
    - "\uC131\uCDE8\uAC10\uC740 \uC788\uC5C8\uC9C0\uB9CC \uC0DD\uD65C\uBE44\uB97C
      \uC544\uB07C\uB2E4 \uAC74\uAC15\uC774 \uC545\uD654\uB418\uC5B4 \uACB0\uAD6D
      \uBCD1\uC6D0\uBE44\uAC00 \uB354 \uB4E4\uC5C8\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC9C0\uC5ED \uC77C\uC790\uB9AC \uBC15\uB78C\uD68C\uC5D0\uC11C \uB300\uAE30\uC5C5
      \uD558\uCCAD\uC5C5\uCCB4\uAC00 \uACE0\uC6A9 \uC124\uBA85\uD68C\uB97C \uD55C\uB2E4.
      \uC9C0\uC6D0\uD560\uAE4C?"
    choices:
    - "\"\uC124\uBA85\uD68C\uB97C \uB4E3\uACE0, \uAF3C\uAF3C\uD788 \uC870\uAC74\uC744
      \uBE44\uAD50\uD574\uBCF8 \uD6C4\uC5D0 \uC9C0\uC6D0\uD55C\uB2E4.\""
    - "\"\uC124\uBA85\uD68C\uB97C \uB4E3\uACE0, \uACB0\uC815\uC740 \uBCF4\uB958\uD55C\uB2E4.\""
    - "\uADF8\uB0E5 \uD604\uC7A5 \uC2E4\uC2B5\uC5D0 \uCD9C\uADFC\uD558\uC5EC \uD558\uB8E8\uB77C\uB3C4
      \uC77C\uB2F9\uC744 \uB354 \uBC1B\uB294\uB2E4."
    results:
    - "\"\uAF3C\uAF3C\uD788 \uB530\uC9C4 \uD6C4 \uC9C0\uC6D0\uD558\uC5EC, \uC88B\uC740
      \uC5C5\uCCB4\uB97C \uD1B5\uD574 \uC88B\uC740 \uACBD\uD5D8\uACFC \uC9C0\uC2DD\uC744
      \uC5BB\uC5C8\uB2E4.\""
    - "\uC815\uBCF4\uB294 \uC5BB\uC5C8\uC9C0\uB9CC \uACB0\uC815\uC774 \uB2A6\uC5B4\uC9C0\uBA74\uC11C
      \uC88B\uC740 \uAE30\uD68C\uB97C \uC5BB\uC744 \uD0C0\uC774\uBC0D\uC744 \uB193\uCCE4\uB2E4."
    - "\uACBD\uD5D8\uC740 \uB298\uC5C8\uC9C0\uB9CC \uAD6C\uC9C1\uC815\uBCF4\uAC00
      \uBD80\uC871\uD574 \uC878\uC5C5 \uC774\uD6C4 \uAD6C\uC9C1 \uACC4\uD68D\uC5D0
      \uC5B4\uB824\uC6C0\uC744 \uAC00\uC9C0\uAC8C \uB418\uC5C8\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uC878\uC5C5 \uD6C4 \uC774 \uD68C\uC0AC\uC5D0\uC11C \uC815\uADDC\uC9C1
      \uC81C\uC548\uC744 \uBC1B\uC558\uB2E4. \uD558\uC9C0\uB9CC \uC5F0\uC7A5 \uADFC\uBB34\uAC00
      \uC7A6\uACE0 \uC0AC\uACE0\uB3C4 \uC7A6\uC740 \uD3B8\uC774\uB2E4."
    choices:
    - "\uD68C\uC0AC\uC640 \uC870\uAC74 \uD611\uC0C1\uC744 \uD1B5\uD574 \uC548\uC804
      \uAD50\uC721\uACFC \uADFC\uBB34 \uD658\uACBD \uAC1C\uC120\uC744 \uC694\uCCAD\uD55C\uB2E4."
    - "\uC77C\uB2E8 3\uAC1C\uC6D4 \uACC4\uC57D\uC11C\uB97C \uC791\uC131\uD55C\uB2E4."
    - "\uC81C\uC548\uC744 \uAC70\uC808\uD558\uACE0 \uB2E4\uB978 \uD68C\uC0AC\uB97C
      \uCC3E\uB294\uB2E4."
    results:
    - "\"\uBA74\uB2F4\uC740 \uD588\uC9C0\uB9CC, \uD68C\uC0AC\uB294 \u201C\uAD50\uC721\uC740
      \uD558\uACE0 \uC788\uB2E4\u201D, \u201C\uC9C0\uAE08 \uAC1C\uC120 \uC911\u201D\uC774\uB77C\uB294
      \uC6D0\uB860\uC801 \uB2F5\uBCC0\uB9CC \uBC18\uBCF5\uD588\uB2E4. \uC815\uC2DD
      \uCC44\uC6A9\uC740 \uB418\uC5C8\uC9C0\uB9CC, \uADFC\uBB34 \uD658\uACBD\uC740
      \uB2E8\uAE30\uAC04\uC5D0 \uB208\uC5D0 \uB744\uAC8C \uB098\uC544\uC9C0\uC9C0
      \uC54A\uC558\uB2E4.\""
    - "\"\uACC4\uC18D\uB41C \uC5F0\uC7A5 \uADFC\uBB34\uC640 \uC0AC\uACE0 \uC18C\uC2DD\uC5D0
      \uB9C8\uC74C\uC774 \uBD88\uD3B8\uD588\uC9C0\uB9CC, \uC2E4\uBB34 \uACBD\uD5D8\uC774
      \uC911\uC694\uD558\uB2E4\uACE0 \uC0DD\uAC01\uD574 \uBC84\uD17C\uB2E4. \uD558\uC9C0\uB9CC
      2\uAC1C\uC6D4 \uCC28 \uC988\uC74C, \uB610 \uD55C \uBC88\uC758 \uC0AC\uACE0\uAC00
      \uBC1C\uC0DD\uD588\uACE0, \uACB0\uAD6D \uD1F4\uC0AC\uB97C \uACB0\uC2EC\uD588\uB2E4.\""
    - "\"\uC8FC\uBCC0\uC5D0\uC11C\uB294 \u201C\uACBD\uD5D8\uC774 \uBD80\uC871\uD558\uB2E4\u201D\uBA70
      \uC6B0\uB824\uD588\uC9C0\uB9CC, \uAFB8\uC900\uD788 \uC9C0\uC6D0\uC11C\uB97C
      \uB123\uC740 \uB05D\uC5D0 \uADDC\uBAA8\uB294 \uC791\uC9C0\uB9CC \uBCF5\uC9C0\uAC00
      \uB354 \uB098\uC740 \uC911\uC18C\uAE30\uC5C5\uC5D0 \uD569\uACA9\uD588\uB2E4.
      \uB2E4\uB9CC, \uBA87 \uAC1C\uC6D4\uAC04\uC740 \uBD88\uC548\uC815\uD55C \uC0DD\uD65C\uC744
      \uACAC\uB38C\uC57C \uD588\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\"\uC57C\uADFC \uD6C4\uC5D0 \uBAB8\uC5D0 \uBB34\uB9AC\uAC00 \uC654\uC9C0\uB9CC,
      \uBCD1\uAC00\uB97C \uC4F0\uBA74 \uC77C\uC790\uB9AC\uB97C \uC783\uACE0, \uC88B\uC9C0
      \uC54A\uC740 \uC778\uC0AC \uD3C9\uAC00\uB97C \uBC1B\uC744\uAE4C \uAC71\uC815\uB41C\uB2E4.\""
    choices:
    - "\uBCD1\uC6D0 \uC9C4\uB8CC \uD6C4 \uC9C4\uB2E8\uC11C\uB97C \uC81C\uCD9C\uD558\uACE0
      \uD734\uC2DD\uC744 \uCDE8\uD55C\uB2E4."
    - "\uC8FC\uB9D0\uAE4C\uC9C0 \uCC38\uACE0 \uBC84\uD2F4 \uD6C4 \uBCD1\uC6D0\uC744
      \uAC04\uB2E4."
    - "\uC0C1\uC0AC\uC758 \uB208\uCE58\uAC00 \uB354 \uBB34\uC11C\uC6CC \uCC38\uB294\uB2E4."
    results:
    - "\"\uC9C4\uB2E8\uC11C\uB97C \uC81C\uCD9C\uD558\uB2C8 \uBCD1\uAC00\uAC00 \uC2B9\uC778\uB410\uACE0,
      \uC774\uD6C4 \uC815\uADDC\uC9C1 \uC804\uD658\uC5D0 \uC601\uD5A5\uC740 \uC5C6\uC5C8\uB2E4.\""
    - "\"\uC99D\uC0C1\uC774 \uC2EC\uD574\uC838 \uC6D4\uC694\uC77C \uC870\uD1F4\uD588\uACE0,
      \uC0C1\uC0AC\uC758 \uB208\uCD1D\uC744 \uBC1B\uC558\uB2E4.\""
    - "\"\uBA70\uCE60 \uD6C4 \uC4F0\uB7EC\uC84C\uACE0, \uAD6C\uAE09\uCC28\uAE4C\uC9C0
      \uD0C0\uAC8C \uB410\uB2E4. \uACB0\uAD6D \uC2E0\uCCB4\uC801\xB7\uC2EC\uB9AC\uC801
      \uC190\uD574\uAC00 \uCEF8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
