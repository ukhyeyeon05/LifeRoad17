%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2de8e05f04ca588419838d933500abaa, type: 3}
  m_Name: story_puz9_StorySet
  m_EditorClassIdentifier: 
  stories:
  - question: "\"\uB098\uB294 \uC0B0\uAC04 \uC9C0\uC5ED\uC5D0\uC11C \uC628\uB77C\uC778
      \uBC84\uC12F \uC1FC\uD551\uBAB0\uC744 \uC6B4\uC601\uD558\uACE0 \uC788\uB294
      \uD55C\uC1A1\uC774\uB2E4. \uB3C4\uC2EC\uC758 \uC778\uD504\uB77C\uAC00 \uC5C6\uB294
      \uC774\uACF3\uC5D0\uC11C \uC1FC\uD551\uBAB0\uC744 \uC6B4\uC601\uD558\uB294
      \uB098\uB294, \uC5B4\uB5A4 \uAE30\uBC18\uC73C\uB85C \uC2DC\uC791\uD588\uC744\uAE4C?\""
    choices:
    - "\uC804\uC138\uAE08\uC744 \uC904\uC5EC \uCD08\uACE0\uC18D \uC778\uD130\uB137\uACFC
      \uC2A4\uB9C8\uD2B8 \uD3EC\uC7A5 \uC2DC\uC2A4\uD15C\uC744 \uAD6C\uCD95\uD588\uB2E4."
    - "\uC1FC\uD551\uBAB0\uC744 \uC6B4\uC601\uD560 \uC778\uD130\uB137 \uC99D\uD3ED\uAE30
      \uC815\uB3C4\uB9CC \uB9C8\uB828\uD574 \uB450\uC5C8\uB2E4."
    - "\uC7A5\uBE44 \uD22C\uC790 \uC5C6\uC774 \uC9C0\uAE08 \uC788\uB294 \uC778\uD130\uB137\uACFC
      \uC7A5\uBE44\uB97C \uD65C\uC6A9\uD574 \uC2DC\uC791\uD588\uB2E4."
    results:
    - "\"\uD22C\uC790\uAE08\uC774 \uBD80\uB2F4\uB410\uC9C0\uB9CC, \uD655\uC2E4\uD788
      \uC5C5\uBB34 \uC18D\uB3C4\uAC00 \uBE68\uB77C\uC84C\uACE0 \uACE0\uAC1D \uC751\uB300\uB098
      \uC8FC\uBB38 \uCC98\uB9AC\uB3C4 \uD6E8\uC52C \uC218\uC6D4\uD574\uC84C\uB2E4.
      \uB2E4\uB9CC \uC804\uC138\uAE08\uC774 \uC904\uC5B4\uB4E0 \uB9CC\uD07C \uC8FC\uAC70
      \uC548\uC815\uC131\uC5D0\uB294 \uBD88\uC548\uC774 \uCEE4\uC84C\uB2E4.\""
    - "\uC778\uD130\uB137\uC740 \uAC1C\uC120\uB418\uC5C8\uC9C0\uB9CC \uAC04\uD5D0\uC801
      \uB04A\uAE40\uC740 \uC5EC\uC804\uD588\uB2E4. \uC5C5\uBB34 \uD6A8\uC728\uC758
      \uC0C1\uC2B9\uC774 \uD06C\uAC8C \uCCB4\uAC10\uB418\uC9C0\uB294 \uC54A\uC558\uB2E4."
    - "\"\uC124\uBE44\uAC00 \uC5C6\uC5B4 \uC6F9\uC0AC\uC774\uD2B8\uAC00 \uB290\uB9AC\uAC8C
      \uC791\uB3D9\uD588\uACE0, \uACE0\uAC1D \uBD88\uB9CC\uB3C4 \uC885\uC885 \uC811\uC218\uB410\uB2E4.
      \uD558\uC9C0\uB9CC \uBE44\uC6A9\uC740 \uAC70\uC758 \uB4E4\uC9C0 \uC54A\uC544
      \uCD08\uAE30\uC5D4 \uC5B4\uB290\uC815\uB3C4 \uC720\uC9C0 \uAC00\uB2A5\uD588\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uAC11\uC791\uC2A4\uB7EC\uC6B4 \uBE44\uB85C \uC0B0\uAE38\uC774 \uBB34\uB108\uC838
      \uD0DD\uBC30 \uCC28\uB7C9\uC774 \uBABB \uB4E4\uC5B4\uC628\uB2E4."
    choices:
    - "\uC9C0\uC790\uCCB4\uC5D0 \uB3C4\uB85C \uBCF5\uAD6C \uBBFC\uC6D0\uC744 \uB123\uB294\uB2E4."
    - "\uD0DD\uBC30\uC0AC\uB97C \uD1B5\uD574 \uC6B0\uD68C \uBC30\uB2EC\uC744 \uC694\uCCAD\uD55C\uB2E4."
    - "\uBC30\uC1A1\uC744 \uD558\uB8E8 \uBBF8\uB8EC\uB2E4"
    results:
    - "\uBCF5\uAD6C\uB294 \uCC29\uC218\uB418\uC5C8\uC9C0\uB9CC \uC218 \uC8FC\uAC00
      \uC18C\uC694\uB410\uB2E4. \uADF8\uB3D9\uC548 \uBC30\uC1A1 \uC9C0\uC5F0\uC5D0
      \uB530\uB978 \uACE0\uAC1D \uD56D\uC758\uAC00 \uC313\uC600\uB2E4."
    - "\"\uC77C\uBD80 \uAE30\uC0AC\uB4E4\uC774 \uC751\uD574\uC8FC\uC5C8\uC9C0\uB9CC,
      \uBC30\uC1A1\uBE44\uAC00 \uCD94\uAC00\uB85C \uBD99\uC5C8\uACE0 \uC77C\uBD80
      \uC9C0\uC5ED\uC740 \uC544\uC608 \uBC30\uC1A1 \uBD88\uAC00 \uD310\uC815\uC744
      \uBC1B\uC558\uB2E4.\""
    - "\"\uD558\uB8E8 \uBBF8\uB918\uC9C0\uB9CC, \uB3C4\uB85C \uC0C1\uD669\uC774 \uAE08\uBC29
      \uB098\uC544\uC9C0\uC9C0 \uC54A\uC544 \uC5F0\uC1C4\uC801\uC73C\uB85C \uBC30\uC1A1\uC774
      \uBC00\uB9AC\uAC8C \uB418\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uD3EC\uC7A5 \uBC15\uC2A4\uAC00 \uB0A1\uACE0 \uBC84\uC12F\uC774 \uC73C\uAE68\uC9C4
      \uCC44 \uB3C4\uCC29\uD588\uB2E4\uB294 \uB9AC\uBDF0\uAC00 \uB2EC\uB838\uB2E4."
    choices:
    - "\uCE5C\uD658\uACBD \uBC15\uC2A4\uB97C \uC0C8\uB85C \uC8FC\uBB38\uD55C\uB2E4."
    - "\uD3EC\uC7A5 \uBC29\uBC95\uC744 \uBC14\uAFB8\uACE0 \uC548\uB0B4\uBB38\uC744
      \uB123\uB294\uB2E4."
    - "\"\"\"\uD3EC\uC7A5\uBCF4\uB2E4 \uC0C1\uD488 \uC790\uCCB4\uAC00 \uC911\uC694\uD558\uC9C0.\"\"
      \uADF8\uB0E5 \uC720\uC9C0\uD55C\uB2E4.\""
    results:
    - "\"\uC81C\uD488 \uC190\uC0C1\uC740 \uC904\uC5C8\uC9C0\uB9CC, \uBC15\uC2A4 \uB2E8\uAC00\uAC00
      \uC62C\uB77C \uB9C8\uC9C4\uC774 \uC904\uC5C8\uB2E4.\uADF8\uB798\uB3C4 \uACE0\uAC1D
      \uD3C9\uAC00\uB294 \uB2E4\uC2DC \uD68C\uBCF5\uB418\uC5C8\uACE0, \uB9E4\uCD9C\uB3C4
      \uC870\uAE08 \uC62C\uB790\uB2E4.\""
    - "\"\uC124\uBA85\uC744 \uB367\uBD99\uC774\uC790 \uC77C\uBD80 \uACE0\uAC1D\uC740
      \uC774\uD574\uD574\uC92C\uC9C0\uB9CC, \uB610 \uB2E4\uB978 \uACE0\uAC1D\uC740
      \u201C\uD551\uACC4 \uAC19\uB2E4\u201D\uACE0 \uD3C9\uC810\uC744 \uB0AE\uCDC4\uB2E4.\""
    - "\"\uBE44\uC6A9\uC740 \uC544\uB07C\uAC8C \uB410\uC9C0\uB9CC, \uADF8 \uC8FC
      \uC77C\uC8FC\uC77C\uAC04 \uC8FC\uBB38\uB7C9\uC774 20% \uAC00\uAE4C\uC774 \uC904\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC778\uD130\uB137\uC774 \uC790\uC8FC \uB04A\uACA8 \uC1FC\uD551\uBAB0
      \uC5C5\uBB34 \uCC98\uB9AC\uAC00 \uB2A6\uC5B4\uC9C0\uACE0 \uC788\uB2E4."
    choices:
    - "\uBB34\uC120\uB9DD \uC99D\uD3ED\uAE30\uB97C \uD558\uB098 \uB354 \uAD6C\uB9E4\uD55C\uB2E4."
    - "\uC774\uC6C3 \uB18D\uAC00\uC640 \uD611\uC758\uD558\uC5EC \uC640\uC774\uD30C\uC774\uB97C
      \uBE4C\uB824 \uC4F4\uB2E4."
    - "\uC544\uC9C1\uC740 \uD06C\uAC8C \uBB38\uC81C\uAC00 \uC5C6\uC73C\uBBC0\uB85C
      \uC870\uAE08\uB9CC \uB354 \uBC84\uD2F4\uB2E4."
    results:
    - "\"\uC124\uCE58 \uD6C4 \uC18D\uB3C4\uB294 \uAC1C\uC120\uB418\uC5C8\uC9C0\uB9CC,
      \uC5EC\uC804\uD788 \uBE44 \uC624\uB294 \uB0A0\uC5D0\uB294 \uBD88\uC548\uC815\uD588\uB2E4.
      \uC544\uB9C8 \uC124\uCE58\uB97C \uC548\uD588\uB2E4\uBA74 \uC6B4\uC601\uC5D0
      \uD070 \uC190\uD574\uB97C \uBD24\uC744 \uAC83 \uAC19\uB2E4.\""
    - "\"\uC77C\uC2DC\uC801 \uD574\uACB0\uC740 \uB418\uC5C8\uC9C0\uB9CC, \uD2B8\uB798\uD53D\uC774
      \uBAB0\uB9B4 \uB54C \uC18D\uB3C4\uAC00 \uB2E4\uC2DC \uB290\uB824\uC84C\uACE0
      \uC774\uC6C3\uACFC\uB3C4 \uBBF8\uBB18\uD55C \uAC08\uB4F1\uC774 \uC0DD\uACBC\uB2E4.\""
    - "\uBD88\uD3B8\uD568\uC740 \uCEF8\uC9C0\uB9CC \uCD94\uAC00 \uBE44\uC6A9\uC740
      \uC5C6\uC5C8\uB2E4. \uADF8\uB7EC\uB098 \uB9AC\uBDF0 \uB2F5\uBCC0 \uC9C0\uC5F0\uC73C\uB85C
      \uACE0\uAC1D CS \uD3C9\uC810\uC774 \uB5A8\uC5B4\uC84C\uB2E4."
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uAC11\uC790\uAE30 \uC1FC\uD551\uBAB0 \uC8FC\uBB38\uB7C9\uC774 \uAE09\uC99D\uD574
      \uC7AC\uACE0 \uD655\uC778\uC774 \uC5B4\uB824\uC6CC\uC84C\uB2E4."
    choices:
    - "\uAD00\uB9AC \uC571\uC744 \uB3C4\uC785\uD574 \uC2E4\uC2DC\uAC04 \uC7AC\uACE0
      \uD30C\uC545 \uCCB4\uACC4\uB97C \uB9CC\uB4E0\uB2E4."
    - "\uAE30\uC874\uC5D0 \uD65C\uC6A9\uD558\uB358 \uAE30\uBCF8 \uD504\uB85C\uADF8\uB7A8\uB4E4\uB85C
      \uB354 \uC790\uC8FC \uC7AC\uACE0 \uD655\uC778\uC744 \uD55C\uB2E4."
    - "\"\uC5B4\uCC28\uD53C \uD310\uB9E4 \uAE30\uB85D\uC774 \uB0A8\uC73C\uBBC0\uB85C
      \uAE30\uC874\uC5D0 \uD558\uB358 \uB9CC\uD07C\uB9CC \uD655\uC778\uD558\uACE0,
      \uC138\uC138\uD558\uAC8C \uD655\uC778\uD558\uC9C0\uB294 \uC54A\uB294\uB2E4.\""
    results:
    - "\"\uC2E4\uC2DC\uAC04 \uD30C\uC545\uC774 \uAC00\uB2A5\uD574\uC84C\uC9C0\uB9CC,
      UI\uC5D0 \uC775\uC219\uD558\uC9C0 \uC54A\uC544 \uCD08\uBC18\uC5D4 \uC5B4\uB824\uC6C0\uC744
      \uACAA\uC5C8\uB2E4. \uD558\uC9C0\uB9CC, \uC801\uC751\uD55C \uC774\uD6C4 \uC1FC\uD551\uBAB0
      \uC6B4\uC601\uC774 \uD06C\uAC8C \uC218\uC6D4\uD574\uC84C\uB2E4.\""
    - "\uAE30\uB85D\uD558\uB2E4\uAC00 \uC7AC\uACE0 \uCC29\uC624\uB85C \uD658\uBD88
      \uC0AC\uD0DC\uAC00 \uC0DD\uACBC\uB2E4. \uACE0\uAC1D \uBA87\uBA85\uC774 \uC774\uD0C8\uD588\uB2E4."
    - "\"\uC8FC\uBB38\uB7C9\uC5D0 \uBE44\uD574 \uB300\uC751\uC774 \uB2A6\uC5B4 \uBC30\uC1A1
      \uB204\uB77D\uC774 \uBC1C\uC0DD\uD588\uACE0, \uC5EC\uB7EC\uAC74\uC758 \uD074\uB808\uC784\uC774
      \uB4E4\uC5B4\uC654\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC0B0 \uB108\uBA38 \uC2E0\uADDC \uAC70\uB798\uCC98\uC5D0\uC11C \uB300\uB7C9
      \uB0A9\uD488\uC744 \uC6D0\uD558\uB294\uB370 \uAC70\uB9AC\uAC00 \uAF64 \uBA40\uB2E4."
    choices:
    - "\uC55E\uC73C\uB85C \uC788\uC744 \uB0A9\uD488\uB4E4\uC744 \uC704\uD574 \uB0C9\uC7A5\uCC28
      \uC6B4\uC1A1 \uC5C5\uCCB4\uC640 \uACC4\uC57D\uD55C\uB2E4."
    - "\uBC30\uC1A1 \uBE48\uB3C4\uB97C \uC904\uC774\uACE0 \uC77C\uC815\uC744 \uC870\uC728\uD55C\uB2E4."
    - "\uAC70\uB9AC\uAC00 \uB108\uBB34 \uBA40\uC5B4 \uBD80\uB2F4\uB418\uB2C8 \uAC70\uB798\uB97C
      \uAC70\uC808\uD55C\uB2E4."
    results:
    - "\uBE44\uC6A9\uC740 \uAF64 \uB4E4\uC5C8\uC9C0\uB9CC \uBC30\uC1A1 \uD488\uC9C8\uC740
      \uC548\uC815\uB418\uC5C8\uACE0 \uAC70\uB798\uCC98\uC640\uC758 \uC2E0\uB8B0\uB3C4
      \uC0DD\uACBC\uB2E4. \uB2E4\uB9CC \uCD08\uAE30 \uC218\uC775\uC740 \uAC70\uC758
      \uB0A8\uC9C0 \uC54A\uC558\uB2E4."
    - "\uC77C\uC815\uC774 \uB4E4\uCB49\uB0A0\uCB49\uD574\uC838 \uAC70\uB798\uCC98\uB3C4
      \uBD88\uD3B8\uD568\uC744 \uB290\uAF08\uB2E4. \uC7AC\uACC4\uC57D \uC2DC\uC810\uC5D0
      \uC870\uAC74 \uBCC0\uACBD\uC774 \uC694\uAD6C\uB418\uC5C8\uB2E4."
    - "\"\uC2DC\uAC04\uACFC \uCCB4\uB825\uC740 \uD655\uBCF4\uB410\uC9C0\uB9CC, \uC131\uC7A5
      \uAE30\uD68C\uB97C \uB193\uCCE4\uB2E4\uB294 \uC0DD\uAC01\uC774 \uACC4\uC18D
      \uB0A8\uC558\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uC9C0\uC790\uCCB4\uC5D0\uC11C '\uB18D\uCD0C \uC2A4\uB9C8\uD2B8\uD654
      \uC9C0\uC6D0\uAE08' \uACF5\uACE0\uAC00 \uB5B4\uB2E4."
    choices:
    - "\uC2DC\uAC04\uC740 \uC880 \uAC78\uB9AC\uACA0\uC9C0\uB9CC \uC11C\uB958\uB97C
      \uC9C1\uC811 \uC900\uBE44\uD574 \uC2E0\uCCAD\uD55C\uB2E4."
    - "\uB9C8\uC744 \uC774\uC6C3\uC5D0\uAC8C \uB3C4\uC6C0\uC744 \uBC1B\uC544 \uAC04\uC2E0\uD788
      \uC81C\uCD9C\uD55C\uB2E4."
    - "\uC2DC\uAC04\uB3C4 \uBD80\uC871\uD558\uACE0 \uC808\uCC28\uAC00 \uB108\uBB34
      \uBCF5\uC7A1\uD574 \uD3EC\uAE30\uD55C\uB2E4."
    results:
    - "\"\uC11C\uB958 \uC900\uBE44\uAC00 \uB9CC\uB9CC\uCE58 \uC54A\uC558\uC9C0\uB9CC,
      \uB9C8\uAC10 \uC9C1\uC804 \uC81C\uCD9C\uC5D0 \uC131\uACF5\uD588\uB2E4. \uB355\uBD84\uC5D0
      \uC9C0\uC6D0\uAE08\uC744 \uBC1B\uC544 \uC6B4\uC601\uC5D0 \uB9CE\uC740 \uB3C4\uC6C0\uC774
      \uB418\uC5C8\uB2E4.\""
    - "\uB3C4\uC6C0\uC744 \uBC1B\uC558\uC9C0\uB9CC \uC77C\uBD80 \uC11C\uB958\uAC00
      \uB204\uB77D\uB3FC \uC7AC\uC81C\uCD9C \uD1B5\uBCF4\uB97C \uBC1B\uC558\uB2E4.
      \uB54C\uBB38\uC5D0 \uC9C0\uC6D0\uAE08\uC744 \uC77C\uBD80\uB9CC \uBC1B\uC744
      \uC218 \uC788\uAC8C \uB418\uC5C8\uB2E4."
    - "\"\uC2DC\uAC04\uC774 \uC5C6\uC5B4 \uB118\uACBC\uC9C0\uB9CC, \uC774\uD6C4 \uC120\uC815
      \uBA85\uB2E8\uC5D0 \uB3D9\uB124 \uACBD\uC7C1 \uC5C5\uCCB4\uAC00 \uD3EC\uD568\uB41C
      \uAC78 \uBCF4\uACE0 \uB9CE\uC740 \uD6C4\uD68C\uB97C \uD558\uAC8C \uB418\uC5C8\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uC0C8\uB85C\uC6B4 \uBC84\uC12F \uD488\uC885\uC744 \uB3C4\uC785\uD558\uB824
      \uD558\uB294\uB370 \uBCF4\uAD00 \uAE30\uAC04\uC774 \uC9E7\uC740 \uD488\uC885\uC774\uB2E4."
    choices:
    - "\uB0C9\uC7A5 \uBCF4\uAD00 \uCC3D\uACE0\uB97C \uC784\uB300\uD55C\uB2E4."
    - "\uB300\uD615 \uB0C9\uC7A5\uACE0 \uBA87 \uAC1C\uB97C \uB354 \uB4E4\uC778\uB2E4."
    - "\uC18C\uB7C9\uB9CC \uC7AC\uBC30\uD558\uC5EC \uAE30\uC874 \uCC3D\uACE0\uC5D0
      \uBCF4\uAD00\uD55C\uB2E4."
    results:
    - "\"\uD488\uC9C8 \uC720\uC9C0\uC5D0\uB294 \uC131\uACF5\uD588\uC9C0\uB9CC, \uC6D4
      \uC784\uB300\uB8CC\uAC00 \uCEE4\uC11C \uC2E4\uC81C \uC218\uC775\uC740 \uAC70\uC758
      \uB0A8\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB798\uB3C4 \uC778\uD130\uB137\uC5D0\uC11C
      \uBC18\uC751\uC774 \uC88B\uC544 \uB9E4\uCD9C\uC774 \uC870\uAE08 \uC624\uB974\uAC8C
      \uB418\uC5C8\uB2E4.\""
    - "\"\uC2E0\uD488\uC885 \uD310\uB9E4 \uC218\uC775\uC744 \uBC14\uB85C \uAC00\uC838\uC640
      \uBC84\uD2F0\uACE0 \uC788\uC9C0\uB9CC \uC124\uCE58\uBE44\uC640 \uC804\uAE30\uC138\uAC00
      \uBD80\uB2F4\uC774\uC5C8\uACE0, \uC77C\uBD80 \uBC84\uC12F\uC740 \uC218\uBD84
      \uACFC\uB2E4\uB85C \uC0C1\uD0DC\uAC00 \uB098\uBE60\uC84C\uB2E4.\""
    - "\"\uD488\uC9C8\uAD00\uB9AC\uB294 \uC218\uC6D4\uD588\uC9C0\uB9CC, \uC218\uC694\uB97C
      \uB2E4 \uAC10\uB2F9\uD558\uC9C0 \uBABB\uD574 \uAC70\uB798\uCC98\uC5D0\uC11C
      \uCD94\uAC00 \uB0A9\uD488\uC744 \uC911\uB2E8\uD588\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
  - question: "\uB3C4\uC2EC \uBB3C\uB958\uCC3D\uACE0\uC5D0 \uC704\uD0C1 \uC81C\uC548\uC774
      \uB4E4\uC5B4\uC654\uB2E4."
    choices:
    - "\uC218\uB77D\uD558\uACE0 \uBC30\uC1A1\uACFC \uAD00\uB828\uB41C \uBD80\uB2F4
      \uC904\uC778\uB2E4."
    - "\"\uBA87 \uB2EC\uB9CC \uC2DC\uD5D8\uD574 \uBCF4\uAE30\uB85C \uD558\uACE0,
      \uAC00\uACC4\uC57D\uC744 \uB9FA\uB294\uB2E4.\""
    - "\uAC70\uC808\uD558\uACE0 \uD558\uB358\uB300\uB85C \uC9C1\uC811 \uD55C\uB2E4."
    results:
    - "\uBB3C\uB958 \uC5C5\uBB34\uB294 \uC218\uC6D4\uD574\uC84C\uC9C0\uB9CC \uC218\uC218\uB8CC\uAC00
      \uC0DD\uAC01\uBCF4\uB2E4 \uB192\uC544 \uC218\uC775\uC740 \uD06C\uAC8C \uB298\uC9C0\uB294
      \uC54A\uC558."
    - "\"\uBA87 \uB2EC \uC2DC\uB3C4\uD574\uBCF8 \uACB0\uACFC, \uC7A5\uB2E8\uC810\uC774
      \uB69C\uB837\uD588\uB2E4. \uD070 \uD074\uB808\uC784\uC740 \uC5C6\uC5C8\uC9C0\uB9CC
      \uC6B0\uB9AC \uC5C5\uCCB4\uB97C \uD1B5\uD574 \uC9C1\uC811 \uAD6C\uB9E4\uD558\uB294
      \uACE0\uAC1D\uB4E4\uC774 \uC904\uC5B4\uB4E4\uC5B4 \uACE0\uAC1D \uD53C\uB4DC\uBC31\uB3C4
      \uD568\uAED8 \uC904\uC5B4\uB4E4\uC5C8\uB2E4.\""
    - "\"\uAE30\uC874\uB300\uB85C \uC9C1\uC811 \uAD00\uB9AC\uD558\uBA70 \uB9CC\uC871\uB3C4\uB294
      \uC720\uC9C0\uB410\uC9C0\uB9CC, \uCCB4\uB825 \uC18C\uC9C4\uC774 \uC2EC\uD588\uACE0
      \uBC30\uC1A1 \uC9C0\uC5F0\uB3C4 \uC7A6\uC544\uC84C\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: 4
      - key: "\uAC74\uAC15"
        value: 3
    - effects:
      - key: "\uB3C8"
        value: 5
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uB3C8"
        value: 2
      - key: "\uAC74\uAC15"
        value: 5
  - question: "\uBE44\uC2B7\uD55C \uC628\uB77C\uC778 \uB18D\uAC00\uB4E4\uC774 \uC810\uC810
      \uB298\uC5B4\uB098 \uACBD\uC7C1\uC774 \uC2EC\uD654\uB418\uACE0 \uC788\uB2E4."
    choices:
    - "\"\uC790\uCCB4 \uBE0C\uB79C\uB4DC\uB97C \uB9CC\uB4E4\uACE0, \uD648\uD398\uC774\uC9C0\uB97C
      \uAD6C\uCD95\uD574 \uB9AC\uB274\uC5BC\uD55C\uB2E4.\""
    - "\"\uAE30\uC874 \uB9C8\uCF13\uC744 \uC720\uC9C0\uD558\uBA70, SNS \uD64D\uBCF4\uB9CC
      \uAC15\uD654\uD55C\uB2E4.\""
    - "\"\"\"\uD488\uC9C8\uB9CC \uC88B\uC73C\uBA74 \uC798\uB418\uACA0\uC9C0\"\" \uD558\uB358
      \uBC29\uC2DD\uC744 \uACE0\uC218\uD55C\uB2E4.\""
    results:
    - "\uCD08\uAE30 \uC81C\uC791\uBE44\uB294 \uCEF8\uC9C0\uB9CC \uC778\uC2A4\uD0C0\uADF8\uB7A8
      DM \uBB38\uC758\uC640 \uC9C1\uAD6C \uC8FC\uBB38\uC774 \uB298\uAE30 \uC2DC\uC791\uD588\uB2E4."
    - "\"\uC77C\uC815 \uC218\uC900\uAE4C\uC9C0\uB294 \uD6A8\uACFC\uAC00 \uC788\uC5C8\uC9C0\uB9CC,
      \uACBD\uC7C1\uC0AC \uB300\uBE44 \uC778\uC9C0\uB3C4 \uD655\uC7A5\uC740 \uC5B4\uB824\uC6E0\uB2E4.\""
    - "\"\uAFB8\uC900\uD55C \uACE0\uAC1D\uC740 \uB0A8\uC558\uC9C0\uB9CC, \uC2E0\uADDC
      \uACE0\uAC1D \uC720\uC785\uC774 \uAC70\uC758 \uC5C6\uC5C8\uB2E4. \uC6D4 \uB9E4\uCD9C\uC740
      2\uAC1C\uC6D4 \uC5F0\uC18D \uD558\uB77D \uC911\uC774\uB2E4.\""
    choiceEffects:
    - effects:
      - key: "\uB3C8"
        value: -2
      - key: "\uAC74\uAC15"
        value: 2
    - effects:
      - key: "\uAC74\uAC15"
        value: -1
    - effects:
      - key: "\uB3C8"
        value: -1
